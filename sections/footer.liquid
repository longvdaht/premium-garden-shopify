<!-- /sections/footer.liquid -->

{% render 'potager-footer' %}

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Wordmark text",
      "default": "Potager",
      "info": "Leave blank to use the store name."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Tools for the working garden. One seasonal note a week."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email sign-up",
      "default": true,
      "info": "Sign-ups are saved as customers tagged newsletter."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email field placeholder",
      "default": "Email address"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true,
      "info": "Links come from Theme settings > Social media."
    },
    {
      "type": "header",
      "content": "Base row"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright",
      "default": "© [year] Potager Labs LLC",
      "info": "[year] shows the current year."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu",
      "info": "Privacy, Terms, Accessibility. Dropdown items are not shown."
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    }
  ],
  "blocks": [
    {
      "type": "linklist",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "linklist",
          "label": "Menu",
          "info": "Dropdown items are not shown."
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
