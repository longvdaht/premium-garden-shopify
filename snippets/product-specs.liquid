{%- comment -%}
  Potager: Specifications accordion (wireframe 03.1, Keith's spec sheet).
  Variable specs come from product metafields listed in the block's
  "Spec fields" setting (Label | namespace.key), shown only when filled and
  capped at the block's limit. Then the fixed specs: Made by (custom.maker
  metaobject: name, country; or the vendor) and SKU, which the theme updates
  on variant change through #Sku-[section id].

  Spec notes (custom.spec_notes, multi-line text): one "Label | text" line per row,
  for specs that differ by option (e.g. Kihachi No. 128,
  "Handle length | 270 mm (hatchet) / 450 mm (tapered)"). A note whose label
  matches a spec row replaces that row's value; other notes are added as rows
  after the spec fields. Labels match without regard to case.

  @param {object} product
  @param {object} current_variant
  @param {object} block
  @param {string} block_style
{%- endcomment -%}
{%- liquid
  assign spec_lines = block.settings.rows | newline_to_br | split: '<br />'
  assign spec_limit = block.settings.limit | default: 5
  assign spec_count = 0

  # Spec notes: parallel lists of lower-case label, display label and escaped text
  assign note_keys = ''
  assign note_labels = ''
  assign note_values = ''
  assign notes_raw = product.metafields.custom.spec_notes.value
  if notes_raw != blank
    assign note_lines = notes_raw | newline_to_br | split: '<br />'
    for note_line in note_lines
      assign note_row = note_line | strip_newlines | strip
      unless note_row contains '|'
        continue
      endunless
      assign note_parts = note_row | split: '|'
      assign note_label = note_parts[0] | strip
      assign note_value = note_row | remove_first: note_parts[0] | remove_first: '|' | strip
      if note_label == blank or note_value == blank
        continue
      endif
      assign note_key = note_label | downcase
      assign note_label_safe = note_label | escape
      assign note_value_safe = note_value | escape
      assign note_keys = note_keys | append: note_key | append: '@@'
      assign note_labels = note_labels | append: note_label_safe | append: '@@'
      assign note_values = note_values | append: note_value_safe | append: '@@'
    endfor
  endif
  assign note_key_list = note_keys | split: '@@'
  assign note_label_list = note_labels | split: '@@'
  assign note_value_list = note_values | split: '@@'
  assign used_notes = '@@'

  capture spec_rows
    for line in spec_lines
      if spec_count >= spec_limit
        break
      endif
      assign row = line | strip_newlines | strip
      if row == blank
        continue
      endif
      assign parts = row | split: '|'
      assign label = parts[0] | strip
      assign label_key = label | downcase

      # A spec note with the same label replaces the field value
      assign value = ''
      for note_key in note_key_list
        if note_key == label_key
          assign value = note_value_list[forloop.index0]
          assign used_notes = used_notes | append: note_key | append: '@@'
          break
        endif
      endfor

      if value == blank
        assign path = parts[1] | strip
        assign path_parts = path | split: '.'
        assign mf = product.metafields[path_parts[0]][path_parts[1]]
        if mf == blank or mf.value == blank
          continue
        endif

        case mf.type
          when 'dimension', 'weight', 'volume'
            assign amount = mf.value.value
            assign amount_int = amount | floor
            if amount == amount_int
              assign amount = amount_int
            endif
            assign value = amount | append: ' ' | append: mf.value.unit
          when 'list.single_line_text_field'
            assign value = mf.value | join: ', '
          else
            assign value = mf | metafield_text
        endcase
      endif

      assign spec_count = spec_count | plus: 1
      echo '<div class="ds-specs__row"><dt>' | append: label | append: '</dt><dd>' | append: value | append: '</dd></div>'
    endfor

    # Spec notes that match no spec row are added as their own rows
    for note_key in note_key_list
      if spec_count >= spec_limit
        break
      endif
      assign used_key = '@@' | append: note_key | append: '@@'
      if used_notes contains used_key
        continue
      endif
      assign spec_count = spec_count | plus: 1
      echo '<div class="ds-specs__row"><dt>' | append: note_label_list[forloop.index0] | append: '</dt><dd>' | append: note_value_list[forloop.index0] | append: '</dd></div>'
    endfor
  endcapture

  assign maker = product.metafields.custom.maker.value
  assign maker_text = maker.name | default: product.vendor
  if maker.country != blank
    assign maker_text = maker_text | append: ', ' | append: maker.country
  endif
  if maker_text == shop.name
    assign maker_text = ''
  endif
-%}

<div class="product__block product__block--accordion product__specs block-padding" {{ block_style }} {{ block.shopify_attributes }}>
  <collapsible-elements single="true">
    <div class="product-accordion">
      <details class="accordion" data-collapsible{% if block.settings.default_open %} open="true"{% endif %}>
        <summary class="accordion__title product__specs__title" data-collapsible-trigger>
          {{ block.settings.heading | default: 'Specifications' }}
          <span class="product__specs__icon product__specs__icon--plus">{%- render 'icon', name: 'plus' -%}</span>
          <span class="product__specs__icon product__specs__icon--minus">{%- render 'icon', name: 'minus' -%}</span>
        </summary>
        <div class="accordion__body" data-collapsible-body{% if block.settings.default_open %} style="height: auto;"{% endif %}>
          <div class="accordion__content" data-collapsible-content>
            <dl class="ds-specs">
              {{- spec_rows -}}
              {%- if block.settings.show_maker and maker_text != blank -%}
                <div class="ds-specs__row"><dt>{{ 'products.product.made_by' | t }}</dt><dd>{{ maker_text }}</dd></div>
              {%- endif -%}
              {%- if block.settings.show_sku -%}
                <div class="ds-specs__row{% if current_variant.sku == blank %} hidden{% endif %}" id="Sku-{{ section.id }}">
                  <dt>{{ 'products.product.sku' | t }}</dt><dd>{{ current_variant.sku }}</dd>
                </div>
              {%- endif -%}
            </dl>
          </div>
        </div>
      </details>
    </div>
  </collapsible-elements>
</div>
