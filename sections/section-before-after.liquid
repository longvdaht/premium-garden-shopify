  "presets": [
    {
      "name": "Before and after",
      "blocks": [{"type": "heading"}, {"type": "text"}, {"type": "button"}]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "custom.pre_footer", "footer"]
  }
}
{% endschema %}
