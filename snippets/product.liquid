{%- doc -%}
  Renders the product layout: media gallery, product form blocks, form panel shape dividers and the sticky cart bar.
  Shared by the Product page and Featured product sections.

  @param {object} [product] - Product to render; defaults to the product of the product template
  @param {boolean} [featured_product] - Rendered by the Featured product section
  @param {boolean} [enable_history_state] - Output as data-enable-history-state; no caller passes it today
  @param {object} [recommendations] - Product recommendations, set when the complementary products block reloads the section
  @param {section} [section] - Parent section; available automatically when rendered from a section

  @example
  {% render 'product', product: all_products[section.settings.product], featured_product: true %}
{%- enddoc -%}

{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign current_variant = product.selected_or_first_available_variant
  assign featured_product = featured_product | default: false
  assign onboarding_product = false
  assign product_sticky_enable = section.settings.product_sticky_enable
  assign variant_image_scroll = section.settings.variant_image_scroll
  assign enable_video_looping = section.settings.enable_video_looping
  assign image_size = section.settings.image_size
  assign image_layout = section.settings.image_layout
  assign mobile_image_style = section.settings.mobile_image_style
  assign enable_zoom = section.settings.enable_zoom
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign featured_media_aspect_ratio = featured_media.aspect_ratio | default: 1
  assign is_title_linked = true

  if template.name == 'product'
    assign is_title_linked = false
  endif

  if product.empty?
    assign onboarding_product = true
  endif

  if featured_product
    assign product_sticky_enable = false
    assign variant_image_scroll = false
  endif

  assign enable_thumbs = false
  assign enable_thumbs_mobile = false

  if image_layout == 'thumbnails' or image_layout == 'thumbnails-left' or image_layout == 'thumbnails-right'
    assign enable_thumbs = true
  endif

  if mobile_image_style == 'thumbs'
    assign enable_thumbs_mobile = true
  endif

  if product.media.size <= 1
    assign enable_thumbs = false
    assign enable_thumbs_mobile = false
  endif

  assign modifier = image_layout | default: 'thumbnails'
  assign product_wrapper_modifier = 'product__wrapper--' | append: modifier

  assign wrapper_tag = 'div'
  if product_sticky_enable
    assign wrapper_tag = 'product-sticky'
  endif

  assign slides_tag = 'div'
  if enable_zoom
    assign slides_tag = 'zoom-images'
  endif

  assign show_buy_buttons = false
  assign buy_buttons = content_section_blocks | where: 'type', 'buttons'

  if buy_buttons.size > 0
    assign show_buy_buttons = true
  endif

  assign has_subscriptions = false
  assign app_blocks = content_section_blocks | where: 'type', '@app'

  if app_blocks.size > 0 and product.selling_plan_groups.size > 0
    assign has_subscriptions = true
  endif

  assign image_width = 770

  if image_size == 'small'
    assign product_wrapper_modifier = product_wrapper_modifier | append: ' product__wrapper--small'
    assign image_width = 525
  endif

  if image_size == 'stretch'
    assign product_wrapper_modifier = product_wrapper_modifier | append: ' product__wrapper--stretch'
    assign image_width = 970
  endif

  if section.settings.reverse_layout
    assign product_wrapper_modifier = product_wrapper_modifier | append: ' product__wrapper--reversed'
  endif

  assign product_form_id = 'ProductForm-' | append: section.id
  assign show_cart_bar = false
  assign unique = section.id

  assign sibling_color = product.metafields.theme.sibling_color.value | default: product.metafields.theme.sibling_colour.value | default: product.metafields.theme.siblings_color.value | default: product.metafields.theme.siblings_colour.value | default: product.metafields.theme.siblings_colors.value | default: product.metafields.theme.siblings_colours.value

  if section.settings.show_cart_bar and featured_product != true
    assign show_cart_bar = true
  endif

  capture product_images_classlist
    echo 'product__images'

    if enable_thumbs
      echo ' product__images--thumbs'
    else
      echo ' product__images--no-thumbs'
    endif

    if enable_thumbs_mobile
      echo ' product__images--mobile-thumbs'
    else
      echo ' product__images--mobile-no-thumbs'
    endif
  endcapture

  capture product_slides_classlist
    echo 'product__slides'

    if section.settings.image_aspect_ratio_mobile_enable
      echo ' product__slides--mobile-ratio'

      if section.settings.video_size_mobile == 'contain'
        echo ' product__slides--video-fit'
      endif
    endif
  endcapture

  assign preorder = false
  if product.metafields.theme.preorder.type == 'boolean' and product.metafields.theme.preorder.value == true
    assign preorder = true
  endif

  assign sold_out = false
  unless product.available
    assign sold_out = true
  endunless

  assign product_tags = product.tags | join: ','
  if product_tags contains '_preorder'
    assign preorder = true
  endif

  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign badge = ''
  if badge == '' and product_tags contains '_badge_'
    assign badge = product_tags | split: '_badge_'
    assign badge = badge[1] | split: ',' | first | replace: '_', ' '
  endif

  assign gallery_badges_block = null
  if product.media.size > 0
    for badges_block in content_section_blocks
      if badges_block.type == 'badges' and badges_block.settings.show_over_gallery
        assign gallery_badges_block = badges_block
        break
      endif
    endfor
  endif

  # Image badge block set to show over the gallery renders there instead of in the product form
  assign image_badge_block = section.blocks | where: 'type', 'image_badge' | first
  assign image_badge_over_gallery = false
  if image_badge_block and image_badge_block.settings.show_over_gallery
    assign image_badge_over_gallery = true
  endif

  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign product_form_classes = ''
  if section.settings.product_form_color_scheme_enable
    assign product_form_classes = ' form__wrapper--color-scheme color-' | append: section.settings.product_form_color_scheme
  endif

  # Shape dividers sit on the product form panel edges, not the section edges.
  # The first divider per edge wins (shape-divider.js drops duplicates), so its height sets the form offset.
  assign form_divider_top = 0
  assign form_divider_bottom = 0
  assign form_divider_top_mobile = 0
  assign form_divider_bottom_mobile = 0
  for divider_block in shape_divider_blocks
    assign divider_height = divider_block.settings.height | default: 80
    assign divider_height_mobile = divider_block.settings.height_mobile | default: divider_height
    if divider_block.settings.target_section == 'above'
      if form_divider_top == 0
        assign form_divider_top = divider_height
        assign form_divider_top_mobile = divider_height_mobile
      endif
    elsif form_divider_bottom == 0
      assign form_divider_bottom = divider_height
      assign form_divider_bottom_mobile = divider_height_mobile
    endif
  endfor
-%}

{%- render 'stylesheet', name: 'product.css' -%}
{%- render 'stylesheet', name: 'product-media.css' -%}

{%- if has_subscriptions -%}
  {%- render 'stylesheet', name: 'app-shopify-subscriptions.css' -%}
{%- endif -%}

<product-info
  id="MainProduct-{{ unique }}"
  class="index-product section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-id="{{ product.id }}"
  data-enable-history-state="{{ enable_history_state }}"
  data-url="{{ product.url }}"
  data-sticky-enabled="{{ product_sticky_enable }}"
  data-variant-image-scroll="{{ section.settings.variant_image_scroll }}"
  {% if show_cart_bar %}
    data-cart-bar-enabled
  {% endif %}
  data-popout-select-confine
>
  {%- style -%}
    {%- if show_cart_bar -%}
      :root { --cart-bar-height: 80px; }
    {%- endif -%}

    #MainProduct-{{ section.id }} {
      --PT: {{ section.settings.padding_top }}px;
      --PB: {{ section.settings.padding_bottom }}px;
    }
  {%- endstyle -%}

  <{{ wrapper_tag }} class="product__wrapper {{ product_wrapper_modifier }}" data-product>
    <div class="product__wrapper__inner">
      <div class="product__page">
        <product-images-swiper
          class="{{ product_images_classlist }}"
          data-section-id="{{ section.id }}"
          data-active-media="{{ section.id }}-{{ featured_media.id }}"
          data-variant-image-scroll="{{ section.settings.variant_image_scroll }}"
          {% if enable_thumbs %}
            data-thumbs-enabled
          {% endif %}
          {% if enable_thumbs_mobile %}
            data-thumbs-mobile
          {% endif %}
        >
          {%- liquid
            # Image badges render over the gallery, or over the blank placeholder when the product has no media
            assign gallery_image_badges = ''
            if image_badge_over_gallery
              capture gallery_image_badges
                render 'badge-images', product: product, modifier: 'badge-images--gallery', sizes: '(min-width: 750px) 90px, 60px', attributes: image_badge_block.shopify_attributes
              endcapture
            endif

            # Image badges aligned with the text badges stack below them instead of overlapping them.
            # On the opposite side, the text badges leave room for the image badge column.
            assign gallery_badges_stacked = false
            assign gallery_badges_modifier = ''
            if gallery_badges_block and gallery_image_badges != blank
              if settings.image_badge_alignment == settings.badge_alignment
                assign gallery_badges_stacked = true
                assign gallery_badges_modifier = ' badge-box-container--stacked'
              elsif settings.image_badge_alignment == 'align--top-right'
                assign gallery_badges_modifier = ' badge-box-container--image-right'
              else
                assign gallery_badges_modifier = ' badge-box-container--image-left'
              endif
            endif
          -%}

          {%- if product.media.size > 0 -%}
            <{{ slides_tag }}
              class="{{ product_slides_classlist }}"
              style="--featured-media-aspect-ratio: {{ featured_media_aspect_ratio | round: 2 }};{% if section.settings.image_aspect_ratio_mobile_enable %} --aspect-ratio-mobile: {{ 1 | divided_by: section.settings.image_aspect_ratio_mobile }};{% endif %}"
            >
              <div class="swiper">
                <swiper-container
                  id="swiper-{{ section.id }}"
                  class="swiper-wrapper"
                  effect="fade"
                  fade-effect-cross-fade="true"
                  auto-height="true"
                  {% if enable_thumbs or enable_thumbs_mobile %}
                    navigation="true"
                    navigation-prev-el=".product__slides .swiper-button-prev.{{ section.id }}--button"
                    navigation-next-el=".product__slides .swiper-button-next.{{ section.id }}--button"
                  {% endif %}
                  {% if product.media.size <= 1 %}
                    allow-slide-next="false"
                    allow-slide-prev="false"
                  {% endif %}
                  {% if image_layout == 'grid-1' or image_layout == 'grid-2' or image_layout == 'stacked' %}
                    breakpoint="(max-width: 749px)"
                  {% endif %}
                  keyboard="true"
                  grab-cursor="true"
                  loop="false"
                  thumbs-swiper="#swiper-thumbs-{{ section.id }}"
                >
                  {%- render 'media',
                    media: featured_media,
                    featured_media: featured_media,
                    enable_video_looping: enable_video_looping,
                    sectionkey: unique,
                    image_width: image_width,
                    cover: true
                  -%}

                  {%- for media in product.media -%}
                    {% if media == featured_media %}
                      {% continue %}
                    {% endif %}

                    {%- render 'media',
                      media: media,
                      featured_media: featured_media,
                      enable_video_looping: enable_video_looping,
                      sectionkey: unique,
                      image_width: image_width,
                      cover: true
                    -%}
                  {%- endfor -%}
                </swiper-container>

                {%- if product.media.size > 1 -%}
                  <button
                    type="button"
                    class="{{ section.id }}--button swiper-button-prev"
                    data-aria-controls="swiper-{{ section.id }}"
                  >
                    <span class="visually-hidden">{{ 'general.pagination.prev' | t }}</span>
                    {%- render 'icon', name: 'caret-left' -%}
                  </button>
                  <button
                    type="button"
                    class="{{ section.id }}--button swiper-button-next"
                    data-aria-controls="swiper-{{ section.id }}"
                  >
                    <span class="visually-hidden">{{ 'general.pagination.next' | t }}</span>
                    {%- render 'icon', name: 'caret-right' -%}
                  </button>
                {%- endif -%}
              </div>

              {%- if gallery_badges_block -%}
                <div
                  class="product__badges badge-box-container {{ settings.badge_alignment }}{{ gallery_badges_modifier }}{% if settings.badge_font == 'subheading' %} subheading{% else %} {{ settings.badge_font_size }}{% endif %}"
                  {{ gallery_badges_block.shopify_attributes }}
                >
                  {%- if badge != '' and gallery_badges_block.settings.product_badges -%}
                    <span class="badge-box">{{ badge }}</span>
                  {%- endif -%}

                  {%- if preorder and sold_out == false and gallery_badges_block.settings.product_badges -%}
                    <span class="badge-box badge-box--preorder">{{ 'products.product.pre_order' | t }}</span>
                  {%- endif -%}

                  {%- if on_sale and sold_out == false and gallery_badges_block.settings.sale_badge -%}
                    <span class="badge-box badge-box--sale">{{ 'products.product.on_sale' | t }}</span>
                  {%- endif -%}

                  {%- if gallery_badges_stacked -%}
                    {{ gallery_image_badges }}
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- unless gallery_badges_stacked -%}
                {{ gallery_image_badges }}
              {%- endunless -%}
            </{{ slides_tag }}>

            {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
            {%- if first_3d_model -%}
              <button
                class="btn btn--outline btn--black btn--ar product-single__view-in-space"
                data-shopify-xr
                data-shopify-model3d-id="{{ first_3d_model.id }}"
                data-shopify-title="{{ product.title | strip_html }}"
                data-shopify-xr-hidden
              >
                {%- render 'icon', name: 'cube' -%}

                <span class="product-single__view-in-space-text">{{ 'products.general.view_space' | t }}</span>
              </button>
            {%- endif -%}

            {%- if enable_thumbs or enable_thumbs_mobile -%}
              <div
                class="product__thumbs{% if product.media.size < 8 %} thumbs-no-scroll{% endif %}"
                {% if image_layout == 'thumbnails-left' or image_layout == 'thumbnails-right' %}
                  data-direction="vertical"
                {% else %}
                  data-direction="horizontal"
                {% endif %}
              >
                <div class="swiper">
                  <swiper-container
                    id="swiper-thumbs-{{ section.id }}"
                    class="swiper-wrapper"
                    {% if image_layout == 'thumbnails-left' or image_layout == 'thumbnails-right' %}
                      direction="vertical"
                      slides-per-view="auto"
                      space-between="10px"
                    {% else %}
                      direction="horizontal"
                      slides-per-view="auto"
                      space-between="10px"
                    {% endif %}
                    free-mode="true"
                    free-mode-sticky="true"
                    watch-slides-progress="true"
                    {% if product.media.size <= 1 %}
                      allow-slide-next="false"
                      allow-slide-prev="false"
                    {% endif %}
                  >
                    {%- if featured_media -%}
                      {%- render 'media-thumb', media: featured_media, featured_media: featured_media -%}
                    {%- endif -%}

                    {%- for media in product.media -%}
                      {%- if media == featured_media -%}
                        {%- continue -%}
                      {%- endif -%}

                      {%- render 'media-thumb', media: media, featured_media: featured_media -%}
                    {%- endfor -%}
                  </swiper-container>
                </div>

                <button
                  type="button"
                  class="scroll-arrow scroll-arrow--prev product__thumbs__arrow product__thumbs__arrow--prev"
                  data-thumbs-arrow-prev
                  disabled
                >
                  {%- render 'icon', name: 'caret-left' -%}
                  <span class="visually-hidden">{{ 'general.pagination.prev' | t }}</span>
                </button>

                <button
                  type="button"
                  class="scroll-arrow scroll-arrow--next product__thumbs__arrow product__thumbs__arrow--next"
                  data-thumbs-arrow-next
                  disabled
                >
                  {%- render 'icon', name: 'caret-right' -%}
                  <span class="visually-hidden">{{ 'general.pagination.next' | t }}</span>
                </button>
              </div>
            {%- endif -%}

            {%- comment -%} Thumbnails template for Photoswipe {%- endcomment -%}
            {%- if enable_zoom -%}
              <template data-pswp-thumbs-template>
                {%- liquid
                  assign images = product.media | where: 'media_type', 'image'
                  assign image_class = 'pswp__thumb'
                  if settings.show_image_bg != 'none'
                    assign image_class = image_class | append: ' show-gray-bg'
                  endif

                  for image in images
                    render 'image', image: image, width: 160, height: 160, sizes: '80px', widths: '80, 120, 160', aspect_ratio: 1, modifier: image_class, loading: 'lazy', fetchpriority: 'auto'
                  endfor
                -%}
              </template>
            {%- endif -%}
          {%- else -%}
            <div class="product__slides product__slides--{{ image_size }} product-single__photos">
              <div
                class="product__photo product__slide{% if onboarding_product %} svg-placeholder{% else %} product__photo--blank{% endif %} {% if settings.show_image_bg != 'none' %} show-gray-bg{% endif %}"
              >
                {%- if onboarding_product -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </div>

              {{- gallery_image_badges -}}
            </div>
          {%- endif -%}
        </product-images-swiper>

        <div class="product__content">
          <div
            class="form__wrapper{{ product_form_classes }}{% unless show_buy_buttons %} form__wrapper--no-buttons{% endunless %}{% unless current_variant.available %} variant--soldout{% endunless %}{% if settings.form_style == 'classic' %} form__wrapper--classic{% else %} form__wrapper--modern{% endif %}{% if settings.show_newsletter %} show-product-notification{% endif %}"
            data-form-wrapper
            {% if shape_divider_blocks != blank %}
              data-shape-divider-host
              style="--form-divider-top: {{ form_divider_top }}px; --form-divider-bottom: {{ form_divider_bottom }}px; --form-divider-top-mobile: {{ form_divider_top_mobile }}px; --form-divider-bottom-mobile: {{ form_divider_bottom_mobile }}px;"
            {% endif %}
          >
            <div class="form__width">
              {% comment %} Add a line item property called 'Preorder' to preorder products {% endcomment %}
              {%- if preorder -%}
                <input
                  type="hidden"
                  name="properties[{{ 'products.product.sale_type' | t }}]"
                  value="{{ 'products.product.pre_order' | t }}"
                  form="{{ product_form_id }}"
                  data-product-preorder
                >
              {%- endif -%}

              {%- for block in content_section_blocks -%}
                {%- liquid
                  assign padding_bottom = block.settings.padding_bottom
                  assign icon_size = block.settings.icon_size

                  capture block_style
                    if padding_bottom
                      echo '--block-padding-bottom: ' | append: block.settings.padding_bottom | append: 'px;'
                    endif

                    if icon_size
                      echo '--icon-size:' | append: icon_size | append: 'px;'
                    endif
                  endcapture

                  if block_style != blank
                    assign block_style = 'style="' | append: block_style | append: '"'
                  endif
                -%}

                {%- case block.type -%}
                  {%- when '@app' -%}
                    {%- capture app_block -%}{%- render block -%}{%- endcapture -%}
                    {%- if has_subscriptions and app_block contains 'shopify_subscriptions_app_container' -%}
                      {%- liquid
                        assign app_block_style = ''
                        assign app_layout = app_block | split: '<!-- BEGIN app snippet: app-block-' | slice: 1 | first

                        assign app_border_thickness = app_layout | split: 'border-width: ' | slice: 1 | first | split: 'px' | first
                        assign app_border_thickness_number = app_border_thickness | plus: 0 | append: ''
                        if app_border_thickness != app_border_thickness_number
                          assign app_border_thickness = app_layout | split: 'border: ' | slice: 1 | first | split: 'px' | first
                          assign app_border_thickness_number = app_border_thickness | plus: 0 | append: ''
                        endif
                        if app_border_thickness == app_border_thickness_number and app_border_thickness != '1'
                          assign app_block_style = app_block_style | append: '--subscription-border-thickness: ' | append: app_border_thickness | append: 'px;'
                        endif

                        assign app_border_radius = app_layout | split: 'border-radius: ' | slice: 1 | first | split: 'px' | first
                        assign app_border_radius_number = app_border_radius | plus: 0 | append: ''
                        if app_border_radius == app_border_radius_number and app_border_radius != '0'
                          assign app_block_style = app_block_style | append: '--subscription-border-radius: ' | append: app_border_radius | append: 'px;'
                        endif
                      -%}
                      <subscription-prices
                        {% if app_block_style != blank %}
                          style="{{ app_block_style }}"
                        {% endif %}
                      >
                        {{- app_block -}}
                      </subscription-prices>
                    {%- else -%}
                      {{- app_block -}}
                    {%- endif -%}

                  {%- when 'title' -%}
                    {%- render 'product-title',
                      product: product,
                      block: block,
                      block_style: block_style,
                      is_title_linked: is_title_linked,
                      onboarding_product: onboarding_product
                    -%}

                  {%- when 'price' -%}
                    {%- render 'product-price',
                      product: product,
                      unique: unique,
                      block: block,
                      block_style: block_style
                    -%}

                  {%- when 'variants' -%}
                    {%- render 'product-variant-picker',
                      product: product,
                      current_variant: current_variant,
                      block: block,
                      block_style: block_style,
                      product_form_id: product_form_id,
                      enable_size_chart: true,
                      featured_product: featured_product
                    -%}

                  {%- when 'buttons' -%}
                    {%- render 'product-buttons',
                      product: product,
                      current_variant: current_variant,
                      unique: unique,
                      block: block,
                      block_style: block_style,
                      product_form_id: product_form_id,
                      preorder: preorder
                    -%}

                  {%- when 'description' -%}
                    {%- render 'product-description', product: product, block: block, block_style: block_style -%}

                  {%- when 'tab_richtext' -%}
                    {%- render 'product-description', product: product, block: block, block_style: block_style -%}

                  {%- when 'accordion' -%}
                    {%- render 'product-description', product: product, block: block, block_style: block_style -%}

                  {%- when 'inventory_countdown' -%}
                    {%- render 'product-inventory', product: product, block: block, block_style: block_style -%}

                  {%- when 'pickup' -%}
                    {%- render 'stylesheet', name: 'pickup-availability.css', blocking: true -%}

                    {%- assign pick_up_availabilities = current_variant.store_availabilities
                      | where: 'pick_up_enabled', true
                    -%}

                    <pickup-availability
                      class="product__block product__pickup block-padding"
                      {% if current_variant.available and pick_up_availabilities.size > 0 %}
                        available
                      {% endif %}
                      data-root-url="{{ routes.root_url }}"
                      data-variant-id="{{ current_variant.id }}"
                      data-has-only-default-variant="{{ product.has_only_default_variant }}"
                      data-product-page-color-scheme="{{ color_scheme }}"
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                    >
                      <template>
                        <pickup-availability-preview class="pickup__preview">
                          {%- render 'icon', name: 'x' -%}
                          <div class="pickup__info">
                            <p class="pickup__info__text">
                              {{ 'products.product.pickup_availability.unavailable' | t }}
                            </p>
                            <button class="pickup__button text-link small">
                              {{ 'products.product.pickup_availability.refresh' | t }}
                            </button>
                          </div>
                        </pickup-availability-preview>
                      </template>
                    </pickup-availability>

                    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>

                  {%- when 'code' -%}
                    <div
                      class="product__block product__custom-code block-padding"
                      {{ block_style }}
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.code }}
                    </div>

                  {%- when 'siblings' -%}
                    {%- render 'product-siblings',
                      product: product,
                      product_form_id: product_form_id,
                      current_variant: current_variant,
                      block: block,
                      block_style: block_style,
                      quick_add_product: false
                    -%}

                  {%- when 'text' -%}
                    {%- render 'product-block-text', block: block, block_style: block_style -%}

                  {%- when 'icon' -%}
                    {%- render 'icon-block',
                      block: block,
                      blocks: content_section_blocks,
                      index: forloop.index0,
                      is_product: true
                    -%}

                  {%- when 'icon-text' -%}
                    {%- render 'icon-block',
                      block: block,
                      blocks: content_section_blocks,
                      index: forloop.index0,
                      is_product: true,
                      icon_with_text: true
                    -%}

                  {%- when 'sharing' -%}
                    <div class="product__block block-padding" {{ block.shopify_attributes }} {{ block_style }}>
                      {%- assign share_url = current_variant.url | prepend: request.origin -%}
                      {%- render 'share-button', share_url: share_url -%}
                    </div>

                  {%- when 'divider' -%}
                    {%- render 'divider', block: block, modifier: 'product__block product__block--divider' -%}

                  {%- when 'line-item' -%}
                    {%- render 'product-properties',
                      product: product,
                      block: block,
                      block_style: block_style,
                      unique: unique,
                      product_form_id: product_form_id
                    -%}

                  {%- when 'popup' -%}
                    {%- render 'product-popup', block: block -%}

                  {%- when 'social-videos' -%}
                    {%- render 'product-social-videos', block: block -%}

                  {%- when 'complementary-products' -%}
                    <div
                      class="product__block product__complementary block-padding"
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                    >
                      <complementary-products
                        class="complementary-products"
                        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=10&intent=complementary"
                      >
                        {%- if recommendations.performed and recommendations.products_count > 0 -%}
                          {%- assign complementary_products_title = 'products.general.complementary_products_title'
                            | t
                          -%}
                          {%- if complementary_products_title != blank -%}
                            <p class="complementary-products__title">{{ complementary_products_title }}</p>
                          {%- endif -%}

                          {%- for product in recommendations.products limit: block.settings.complementary_limit -%}
                            {%- render 'upsell-product',
                              upsell_product: product,
                              color_scheme: block.settings.color_scheme,
                              button_type: block.settings.button_type,
                              button_size: block.settings.button_size,
                              button_style: block.settings.button_style
                            -%}
                          {%- endfor -%}
                        {%- endif -%}
                      </complementary-products>
                    </div>

                    <script src="{{ 'complementary-products.js' | asset_url }}" defer="defer"></script>

                  {%- when 'product-card-tags' -%}
                    {%- render 'product-card-tags',
                      product: product,
                      placement: 'product',
                      block_style: block_style,
                      shopify_attributes: block.shopify_attributes
                    -%}

                  {%- when 'badges' -%}
                    {%- if block.id != gallery_badges_block.id -%}
                      <div
                        class="product__block product__badges block-padding"
                        {{ block.shopify_attributes }}
                        {{ block_style }}
                      >
                        {%- if badge != '' and block.settings.product_badges -%}
                          <span class="badge-box">{{ badge }}</span>
                        {%- endif -%}

                        {%- if preorder and sold_out == false and block.settings.product_badges -%}
                          <span class="badge-box badge-box--preorder">{{ 'products.product.pre_order' | t }}</span>
                        {%- endif -%}

                        {%- if on_sale and sold_out == false and block.settings.sale_badge -%}
                          <span class="badge-box badge-box--sale">{{ 'products.product.on_sale' | t }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                  {%- when 'image_badge' -%}
                    {%- unless image_badge_over_gallery -%}
                      {%- capture image_badge_attributes -%}{{ block.shopify_attributes }} {{ block_style }}{%- endcapture -%}
                      {%- render 'badge-images',
                        product: product,
                        modifier: 'product__block product__image-badges block-padding',
                        sizes: '60px',
                        attributes: image_badge_attributes
                      -%}
                    {%- endunless -%}

                  {%- when 'sku' -%}
                    <div
                      class="product__block product__sku block-padding"
                      id="Sku-{{ section.id }}"
                      role="status"
                      {{ block_style }}
                      {{ block.shopify_attributes }}
                    >
                      {{ 'products.product.sku' | t }}: {{ current_variant.sku }}
                    </div>

                  {%- when 'fit-guide' -%}
                    {%- liquid
                      assign fit_color = block.settings.fit_color
                      unless fit_color.alpha == 0.0 or fit_color == blank
                        capture style
                          echo '--text:' | append: fit_color
                        endcapture
                      endunless
                    -%}

                    {%- render 'stylesheet', name: 'fit-guide.css' -%}

                    <div
                      class="product__block product__guide guide block-padding"
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                    >
                      {%- if block.settings.heading != blank -%}
                        <p class="guide__heading strong">{{ block.settings.heading }}</p>
                      {%- endif -%}

                      <div class="guide__line" style="{{ style }}">
                        {%- assign selected_segment = block.settings.selected_segment | plus: 0 -%}
                        {%- for idx in (1..5) -%}
                          <span
                            {% if forloop.index == selected_segment %}
                              class="is-active"
                            {% endif %}
                          >
                            {{- forloop.index -}}
                          </span>
                        {%- endfor -%}
                      </div>

                      {%- if block.settings.left_label != blank
                        or block.settings.middle_label != blank
                        or block.settings.right_label != blank
                      -%}
                        <div class="guide__content{% unless block.settings.left_label != blank %} guide__content--skip-left{% endunless %}{% unless block.settings.right_label != blank %} guide__content--skip-right{% endunless %}">
                          {%- if block.settings.left_label != blank -%}
                            <small class="guide__left">{{ block.settings.left_label }}</small>
                          {%- endif -%}

                          {%- if block.settings.middle_label != blank -%}
                            <small class="guide__middle">{{ block.settings.middle_label }}</small>
                          {%- endif -%}

                          {%- if block.settings.right_label != blank -%}
                            <small class="guide__right">{{ block.settings.right_label }}</small>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              {%- endfor -%}
            </div>

            {%- render 'shape-dividers', mode: 'host' -%}
          </div>
        </div>
      </div>
    </div>
  </{{ wrapper_tag }}>

  {%- if show_cart_bar -%}
    {%- render 'cart-bar' -%}
  {%- endif -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-images-swiper.js' | asset_url }}" defer="defer"></script>

  {%- if product_sticky_enable -%}
    <script src="{{ 'product-sticky.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if has_subscriptions -%}
    <script src="{{ 'subscription-prices.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if first_3d_model -%}
    {%- render 'stylesheet', name: 'model-ui.css', async: true -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {%- endif -%}

  {%- if enable_zoom -%}
    <script src="{{ 'load-photoswipe.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'zoom.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</product-info>
