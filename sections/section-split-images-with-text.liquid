<!-- /sections/section-split-images-with-text.liquid -->
{%- liquid
  assign unique = 'SplitImagesWithText--' | append: section.id
  assign show_gutters = section.settings.gutters
  assign section_width = section.settings.width
  assign layout_mobile = section.settings.layout_mobile
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
  assign show_placeholder = section.settings.show_placeholder

  comment
    Theme blocks report "@theme" for block.type, so section.blocks cannot be filtered by type.
    Each Image block wraps its output in <!--split-image--> markers instead. The section only
    lays out two columns, so keep the first two and drop the rest; other blocks (shape
    dividers) pass through untouched.
  endcomment
  capture rendered_blocks
    content_for 'blocks'
  endcapture

  assign split_image_block_count = 0
  assign visible_block_count = 0
  assign content_blocks = ''
  assign chunks = rendered_blocks | split: '<!--split-image-->'

  for chunk in chunks
    if forloop.first
      assign content_blocks = content_blocks | append: chunk
      continue
    endif

    assign pieces = chunk | split: '<!--/split-image-->'

    if split_image_block_count < 2
      assign split_image_block_count = split_image_block_count | plus: 1
      assign content_blocks = content_blocks | append: pieces.first
      unless pieces.first contains 'brick__block--hidden'
        assign visible_block_count = visible_block_count | plus: 1
      endunless
    endif

    if pieces.size > 1
      assign content_blocks = content_blocks | append: pieces.last
    endif
  endfor

  # Rendering conditions
  assign render_section = false
  if split_image_block_count > 0 or show_placeholder or request.design_mode
    assign render_section = true
  endif

  if request.design_mode == false and split_image_block_count > 0 and visible_block_count == 0
    assign render_section = false
  endif

  assign enable_slider_mobile = false
  if layout_mobile == 'slider'
    assign enable_slider_mobile = true
  endif

  capture image_sizes
    if split_image_block_count > 1
      if section_width == 'wrapper--full'
        echo '(min-width: 750px) 50vw, 100vw'
      elsif section_width == 'wrapper--full-padded'
        echo '(min-width: 990px) calc((100vw - 100px) / 2), (min-width: 750px) calc((100vw - 60px) / 2), calc(100vw - 32px)'
      else
        echo '(min-width: 990px) calc(1100px / 2), (min-width: 750px) calc((100vw - 60px) / 2), calc(100vw - 32px)'
      endif
    else
      if section_width == 'wrapper--full'
        echo '100vw'
      elsif section_width == 'wrapper--full-padded'
        echo '(min-width: 990px) calc(100vw - 100px), (min-width: 750px) calc(100vw - 60px), calc(100vw - 32px)'
      else
        echo '(min-width: 990px) 1100px, (min-width: 750px) calc(100vw - 60px), calc(100vw - 32px)'
      endif
    endif
  endcapture
-%}

{%- style -%}
  #{{ unique }} {
    --PT: {{ padding_top }}px;
    --PB: {{ padding_bottom }}px;
  }
{%- endstyle -%}

{%- render 'stylesheet', name: 'split-images.css' -%}

<div
  class="index-hero index-hero--split-images-with-text section-padding {{ color_scheme }}"
  id="{{ unique }}"
  data-section-id="{{ section.id }}"
  data-overlay-header
  data-shape-divider-root
>
  {%- if render_section -%}
    <div
      class="brick__section{% if enable_slider_mobile %} brick__section--mobile-slider{% endif %}{% if show_gutters %} has-gap{% endif %} {{ section_width }}"
      {% if request.design_mode %}
        data-block-scroll
      {% endif %}
    >
      {%- liquid
        assign promote_homepage_h1 = false
        if template.name == 'index' and section.location == 'template' and section.index == 1
          assign promote_homepage_h1 = true
        endif
      -%}

      {%- render 'heading-auto-promote', content_blocks: content_blocks, promote: promote_homepage_h1 -%}
    </div>
  {%- endif -%}

</div>

