{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign default_title = 'home_page.sections.news_title' | t
  assign default_content = 'home_page.onboarding.no_content' | t

  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign unique = 'FeaturedPosts--' | append: section.id
-%}

{%- render 'stylesheet', name: 'section-featured-posts.css' -%}

{%- style -%}
  #{{ unique }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- if content_section_blocks.size != 0 or shape_divider_blocks != blank -%}
  <section
    id="{{ unique }}"
    class="featured-posts section-padding {{ color_scheme }}"
    data-section-id="{{ section.id }}"
    data-section-type="blog-section"
    {% if shape_divider_blocks != blank %}
      data-shape-divider-host
    {% endif %}
    {% if badge_blocks != blank %}
      data-badge-host
    {% endif %}
  >
    <div class="{{ section.settings.width }}">
      <div class="blog-editorial">
        <div class="swiper editorial__slider">
          <swiper-container
            class="grid--mobile-slider"
            breakpoint="(min-width: 768px)"
            loop="true"
            grab-cursor="true"
            speed="500"
            navigation="true"
            navigation-prev-el=".{{ section.id }}--button.swiper-button-prev"
            navigation-next-el=".{{ section.id }}--button.swiper-button-next"
            {% if request.design_mode %}
              data-block-scroll
            {% endif %}
          >
            {%- for block in content_section_blocks -%}
              {%- liquid
                assign article = articles[block.settings.featured_post]
                assign subheading = block.settings.subheading

                if article != blank and article.image
                  assign image = article.image
                else
                  assign image = 'blank.svg' | asset_url
                endif

                if block.settings.image
                  assign image = block.settings.image
                endif

                capture sizes
                  echo '(min-width: 750px) 50vw, 100vw'
                endcapture
              -%}

              <swiper-slide class="grid-item" {{ block.shopify_attributes }}>
                <div class="editorial">
                  <div class="editorial__image">
                    {%- render 'image-hero',
                      image: image,
                      sizes: sizes,
                      modifier: 'editorial__image-bg',
                      desktop_height: section.settings.height,
                      mobile_height: section.settings.mobile_height
                    -%}
                  </div>

                  <div
                    class="editorial__aside"
                    {% if subheading != blank %}
                      data-subheading="{{ subheading }}"
                    {% endif %}
                  >
                    {%- if subheading != blank -%}
                      <p class="editorial__subheading subheading">
                        {{ subheading }}
                      </p>
                    {%- endif -%}

                    <div class="editorial__content">
                      {%- liquid
                        assign post_heading_tag = 'h2'

                        if template.name == 'blog' and section.location == 'template' and section.index == 1 and forloop.first
                          assign post_heading_tag = 'h1'
                        endif
                      -%}
                      <{{ post_heading_tag }} class="editorial__title {{ section.settings.heading_font_size }}">
                        <a href="{{ article.url }}" title="{{ article.title | escape }}">
                          {{ article.title | default: default_title }}
                        </a>
                      </{{ post_heading_tag }}>

                      {%- if section.settings.show_date or section.settings.show_author -%}
                        <p class="editorial__meta font-body">
                          {%- if section.settings.show_date -%}
                            {%- assign published_at = article.published_at
                              | default: 'now'
                              | date: format: 'full_date'
                            -%}
                            <time datetime="{{ published_at }}">{{ published_at }}</time>
                          {% endif %}

                          {%- if section.settings.show_author -%}
                            {%- liquid
                              assign article_author = article.author | default: 'Jane Doe'
                              assign by_author_text = 'blogs.article.by_author' | t: author: article_author
                              if by_author_text contains 'Translation missing:'
                                assign by_author_text = 'By ' | append: article_author
                              endif
                            -%}
                            <span class="editorial__meta__author">
                              {{- by_author_text }}
                            </span>
                          {%- endif -%}
                        </p>
                      {%- endif -%}

                      {%- unless article != blank and article.excerpt_or_content == blank -%}
                        <div class="editorial__excerpt">
                          <p>
                            {{ article.excerpt_or_content | default: default_content | strip_html | truncatewords: 30 }}
                          </p>
                        </div>
                      {%- endunless -%}

                      {%- if section.settings.show_button -%}
                        <div class="editorial__link">
                          <a
                            href="{{ article.url }}"
                            class="btn btn--text"
                            aria-label="{{ 'blogs.article.read_more_descriptive' | t | escape }}"
                          >
                            <span>{{ 'blogs.article.read_more' | t }}</span>
                          </a>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </swiper-slide>
            {%- endfor -%}
          </swiper-container>

          <button
            type="button"
            class="{{ section.id }}--button swiper-button-prev"
            aria-label="{{ 'general.accessibility.previous_slide' | t }}"
          >
            {%- render 'icon', name: 'caret-left' -%}
          </button>
          <button
            type="button"
            class="{{ section.id }}--button swiper-button-next"
            aria-label="{{ 'general.accessibility.next_slide' | t }}"
          >
            {%- render 'icon', name: 'caret-right' -%}
          </button>
        </div>
      </div>
    </div>
    {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
    {%- render 'shape-dividers', mode: 'host' -%}
  </section>
{%- endif -%}

