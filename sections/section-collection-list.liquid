<!-- /sections/section-collection-list.liquid -->
{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign unique = 'CollectionsList--' | append: section.id
  assign subheading = section.settings.subheading
  assign title = section.settings.title
  assign description = section.settings.description
  assign button_text = section.settings.button_text
  capture button_classes
    assign button_style = section.settings.button_style
    if button_style == 'btn--text' and section.settings.show_arrow
      assign button_style = button_style | append: ' btn--text-no-underline'
    endif
    echo 'btn ' | append: button_style | append: ' ' | append: section.settings.button_type | append: ' ' | append: section.settings.button_size
  endcapture

  assign has_content = false
  if subheading != blank or title != blank or description != blank or button_text != blank
    assign has_content = true
  endif

  assign aspect_ratio = 1 | divided_by: section.settings.aspect_ratio

  assign grid_columns = section.settings.grid
  assign limit_onboarding = grid_columns
  assign layout = section.settings.layout
  assign layout_mobile = section.settings.layout_mobile

  assign has_slider = false
  if layout == 'slider' or layout_mobile == 'slider'
    assign has_slider = true
  endif

  assign scroller_id = unique | append: '-scroller'

  capture grid_classes
    echo 'grid'

    if layout == 'slider'
      echo ' grid--slider'
    endif

    if layout_mobile == 'slider'
      echo ' grid--mobile-slider'
    endif
  endcapture

  assign columns_desktop = grid_columns | plus: 0
  assign columns_medium = 3
  assign columns_small = 2
  assign columns_mobile = layout_mobile | plus: 0

  if columns_desktop == 2 or columns_desktop == 4
    assign columns_medium = 2
  endif

  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign animation_anchor = unique
-%}

{%- render 'stylesheet', name: 'collection-cards.css' -%}

{%- style -%}
  #{{ unique }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    --COLUMNS: {{ columns_desktop }};
    --COLUMNS-MEDIUM: {{ columns_medium }};
    --COLUMNS-SMALL: {{ columns_small }};
    --COLUMNS-MOBILE: {{ columns_mobile }};

    {%- if has_content -%}
      --PT-MOBILE: max({{ section.settings.padding_top }}px, calc(var(--gap) * 2));
    {%- endif -%}
  }
{%- endstyle -%}

<section
  id="{{ unique }}"
  class="section-collection-list section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="list-collections"
  {% if shape_divider_blocks != blank %}data-shape-divider-host{% endif %}
  {% if badge_blocks != blank %}data-badge-host{% endif %}
>
  {%- if layout == 'slider' -%}
    <grid-slider>
  {%- endif -%}

  <div class="grid-container{% if section.settings.layout == 'slider' and has_content %} grid-container--split{% endif %}">
    {%- if has_content -%}
      <div class="grid__heading-holder{% if layout == 'grid' %} text-center{% endif %}">
        <div class="grid__heading-content">
          {%- if subheading != blank or title != blank or description != blank -%}
            <div class="grid__heading-text">
              {%- if subheading != blank -%}
                {%- assign animation_order = animation_order | plus: 1 -%}

                <p
                  class="grid__subheading subheading"
                  data-aos="hero"
                  data-aos-anchor="{{ animation_anchor }}"
                  data-aos-order="{{ animation_order }}"
                >
                  {{ subheading }}
                </p>
              {%- endif -%}

              {%- if title != blank -%}
                {%- liquid
                  assign animation_order = animation_order | plus: 1
                  assign heading_tag = 'h2'

                  unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
                    assign heading_tag = section.settings.heading_tag
                  endunless
                -%}

                <{{ heading_tag }}
                  class="grid__heading {{ section.settings.heading_font_size }}"
                  data-aos="hero"
                  data-aos-anchor="{{ animation_anchor }}"
                  data-aos-order="{{ animation_order }}"
                >
                  {{- title -}}
                </{{ heading_tag }}>
              {%- endif -%}

              {%- if description != blank -%}
                {%- assign animation_order = animation_order | plus: 1 -%}
                <div
                  class="grid__description {{ section.settings.text_font_size }}"
                  data-aos="hero"
                  data-aos-anchor="{{ animation_anchor }}"
                  data-aos-order="{{ animation_order }}"
                >
                  {{ description }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if button_text != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <div
              class="grid__heading-actions"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              <a
                class="{{ button_classes }}"
                href="{{ section.settings.button_url }}"
              >
                <span>{{ button_text | escape }}</span>

                {%- if section.settings.show_arrow -%}
                  {%- render 'icon', name: 'caret-right' -%}
                {%- endif -%}
              </a>
            </div>
          {%- endif -%}
        </div>

        {%- if layout == 'slider' -%}
          {%- assign animation_order = animation_order | plus: 1 -%}
          <div
            class="slider__arrows slider__arrows--inline"
            data-aos="hero"
            data-aos-anchor="{{ animation_anchor }}"
            data-aos-order="{{ animation_order }}"
          >
            <button
              type="button"
              class="slider__button slider__button--prev"
              data-button-arrow
              data-button-prev
              aria-label="{{ 'general.pagination.prev' | t }}"
            >
              {%- render 'icon', name: 'caret-left' -%}
            </button>

            <button
              type="button"
              class="slider__button slider__button--next"
              data-button-arrow
              data-button-next
              aria-label="{{ 'general.pagination.next' | t }}"
            >
              {%- render 'icon', name: 'caret-right' -%}
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid__items-holder">
      <div class="grid-outer">
        {%- liquid
          capture collection_items
            if content_section_blocks.size != 0
              for block in content_section_blocks
                assign animation_delay = forloop.index0 | times: 1
                capture placeholder_index
                  cycle 1, 2, 3, 5, 6
                endcapture
                render 'collection-grid-item', block: block, aspect_ratio: aspect_ratio, animation_delay: animation_delay, animation_anchor: animation_anchor, index: forloop.index, placeholder_index: placeholder_index
              endfor
            else
              for i in (1..limit_onboarding)
                assign animation_delay = forloop.index0 | times: 1
                capture index
                  cycle 1, 2, 3, 5, 6
                endcapture
                render 'collection-grid-item', block: block, aspect_ratio: aspect_ratio, animation_delay: animation_delay, animation_anchor: animation_anchor, index: index
              endfor
            endif
          endcapture
        -%}

        <div
          class="collection-list {{ grid_classes }}"
          {% if has_slider %}
            id="{{ scroller_id }}"
            data-grid-slider
            {% if request.design_mode %}
              data-block-scroll
            {% endif %}
          {% endif %}
        >
          {{ collection_items }}
        </div>

        {%- if has_slider -%}
          <slider-progress
            for="{{ scroller_id }}"
            {% if layout == 'slider' %}
              data-desktop-slider
            {% endif %}
            {% if layout_mobile == 'slider' %}
              data-mobile-slider
            {% endif %}
          >
            <div class="slider-progress__container" data-slider-progress hidden>
              <div class="slider-progress__track">
                <div class="slider-progress__fill" data-slider-progress-fill style="--slider-progress: 0;"></div>
              </div>
              <div class="slider-progress__counter body-x-small" data-slider-counter aria-live="polite"></div>
            </div>
          </slider-progress>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if layout == 'slider' -%}
    </grid-slider>
  {%- endif -%}
  {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
  {%- render 'shape-dividers', mode: 'host' -%}
</section>

