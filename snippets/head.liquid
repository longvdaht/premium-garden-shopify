{%- doc -%}
  Renders the document head: meta tags, fonts, theme CSS variables from settings, the global stylesheet and deferred scripts.

  @example
  {% render 'head' %}
{%- enddoc -%}

{%- assign scheme_accent = settings.color_schemes[0].settings.accent -%}
{%- assign scheme_classes = '' -%}

<!-- =========== Headlands v1.1.0 - Artemis =========== -->

<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="{{ scheme_accent }}">

<link rel="canonical" href="{{ canonical_url }}">

{% if settings.favicon %}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
{% endif %}

{%- unless settings.type_header_font.system?
  and settings.type_base_font.system?
  and settings.type_nav_font.system?
  and settings.type_btn_font.system?
  and settings.type_subheading_font.system?
-%}
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
{%- endunless -%}

{% capture seo_title %}
  {% assign title_content = page_title %}
  {% if template == 'password' %}
    {% assign title_content = shop.name %}
  {%- endif -%}
  {{ title_content }}
  {% if current_tags %}
    {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
  {% endif %}
  {% if current_page != 1 %}
    &ndash; {{ 'general.meta.page' | t: page: current_page }}
  {% endif %}
  {% unless page_title contains shop.name %}
    &ndash; {{ shop.name }}
  {% endunless %}
{% endcapture %}

<title>{{ seo_title }}</title>

{%- liquid
  comment
    Merchant SEO description first. If empty, borrow body copy so the tag is never blank.
    Truncate only the body fallbacks (~30 words). Hand-written page_description stays intact.
  endcomment
  assign seo_description = page_description | strip_html | strip_newlines | strip

  if seo_description == blank
    case template.name
      when 'product'
        assign seo_description = product.description
      when 'collection'
        assign seo_description = collection.description
      when 'article'
        assign seo_description = article.excerpt_or_content
      when 'page'
        assign seo_description = page.content
    endcase
    assign seo_description = seo_description | strip_html | strip_newlines | strip | truncatewords: 30, '...'
  endif

  if seo_description == blank
    assign seo_description = shop.description | strip_html | strip_newlines | strip
  endif

  if seo_description == blank
    assign seo_description = shop.name
  endif
-%}

<meta name="description" content="{{ seo_description | escape }}">

{% render 'social-meta', og_description: seo_description %}

{%- liquid
  assign heading_font = settings.type_header_font
  assign subheading_font = settings.type_subheading_font
  assign base_font = settings.type_base_font
  assign nav_font = settings.type_nav_font
  assign btn_font = settings.type_btn_font

  if settings.type_header_font_custom and settings.type_header_font_list == 'custom'
    assign heading_font_custom = settings.type_header_font_custom | split: '|'
    assign heading_font_custom_filename = heading_font_custom[0]
    assign heading_font_custom_name = heading_font_custom[1]
    assign heading_font_custom_weight = heading_font_custom[2]
    assign heading_font_custom_style = heading_font_custom[3]
    assign heading_font_custom_format = heading_font_custom[4]
  endif

  if settings.type_subheading_font_custom and settings.type_subheading_font_list == 'custom'
    assign subheading_font_custom = settings.type_subheading_font_custom | split: '|'
    assign subheading_font_custom_filename = subheading_font_custom[0]
    assign subheading_font_custom_name = subheading_font_custom[1]
    assign subheading_font_custom_weight = subheading_font_custom[2]
    assign subheading_font_custom_style = subheading_font_custom[3]
    assign subheading_font_custom_format = subheading_font_custom[4]
  endif

  if settings.type_base_font_custom and settings.type_base_font_list == 'custom'
    assign base_font_custom = settings.type_base_font_custom | split: '|'
    assign base_font_custom_filename = base_font_custom[0]
    assign base_font_custom_name = base_font_custom[1]
    assign base_font_custom_weight = base_font_custom[2]
    assign base_font_custom_style = base_font_custom[3]
    assign base_font_custom_format = base_font_custom[4]
  endif

  if settings.type_nav_font_custom and settings.type_nav_font_list == 'custom'
    assign nav_font_custom = settings.type_nav_font_custom | split: '|'
    assign nav_font_custom_filename = nav_font_custom[0]
    assign nav_font_custom_name = nav_font_custom[1]
    assign nav_font_custom_weight = nav_font_custom[2]
    assign nav_font_custom_style = nav_font_custom[3]
    assign nav_font_custom_format = nav_font_custom[4]
  endif

  if settings.type_btn_font_custom and settings.type_btn_font_list == 'custom'
    assign btn_font_custom = settings.type_btn_font_custom | split: '|'
    assign btn_font_custom_filename = btn_font_custom[0]
    assign btn_font_custom_name = btn_font_custom[1]
    assign btn_font_custom_weight = btn_font_custom[2]
    assign btn_font_custom_style = btn_font_custom[3]
    assign btn_font_custom_format = btn_font_custom[4]
  endif

  assign base_font_bold = base_font | font_modify: 'weight', 'bolder'
  assign base_font_100 = base_font | font_modify: 'weight', '+100'
  assign base_font_200 = base_font | font_modify: 'weight', '+200'
  assign base_font_300 = base_font | font_modify: 'weight', '+300'
  assign base_font_400 = base_font | font_modify: 'weight', '+400'
  if base_font_100 and base_font_100.weight > base_font.weight
    assign base_font_bold = base_font_100
  elsif base_font_200 and base_font_200.weight > base_font.weight
    assign base_font_bold = base_font_200
  elsif base_font_300 and base_font_300.weight > base_font.weight
    assign base_font_bold = base_font_300
  elsif base_font_400 and base_font_400.weight > base_font.weight
    assign base_font_bold = base_font_400
  endif

  assign base_font_italic = settings.type_base_font | font_modify: 'style', 'italic'
  assign base_font_bold_italic = base_font_bold | font_modify: 'style', 'italic'

  assign nav_font_bold = nav_font | font_modify: 'weight', 'bolder'
  assign nav_font_100 = nav_font | font_modify: 'weight', '+100'
  assign nav_font_200 = nav_font | font_modify: 'weight', '+200'
  assign nav_font_300 = nav_font | font_modify: 'weight', '+300'
  assign nav_font_400 = nav_font | font_modify: 'weight', '+400'
  if nav_font_100 and nav_font_100.weight > nav_font.weight
    assign nav_font_bold = nav_font_100
  elsif nav_font_200 and nav_font_200.weight > nav_font.weight
    assign nav_font_bold = nav_font_200
  elsif nav_font_300 and nav_font_300.weight > nav_font.weight
    assign nav_font_bold = nav_font_300
  elsif nav_font_400 and nav_font_400.weight > nav_font.weight
    assign nav_font_bold = nav_font_400
  endif

  unless heading_font_custom
    assign heading_font_bold = heading_font | font_modify: 'weight', 'bolder'
    assign heading_font_100 = heading_font | font_modify: 'weight', '+100'
    assign heading_font_200 = heading_font | font_modify: 'weight', '+200'
    assign heading_font_300 = heading_font | font_modify: 'weight', '+300'
    assign heading_font_400 = heading_font | font_modify: 'weight', '+400'
    if heading_font_100 and heading_font_100.weight > heading_font.weight
      assign heading_font_bold = heading_font_100
    elsif heading_font_200 and heading_font_200.weight > heading_font.weight
      assign heading_font_bold = heading_font_200
    elsif heading_font_300 and heading_font_300.weight > heading_font.weight
      assign heading_font_bold = heading_font_300
    elsif heading_font_400 and heading_font_400.weight > heading_font.weight
      assign heading_font_bold = heading_font_400
    endif

    assign heading_font_italic = heading_font | font_modify: 'style', 'italic'
  endunless

  assign heading_font_uppercase = 'none'
  if settings.type_header_uppercase
    assign heading_font_uppercase = 'uppercase'
  endif

  assign subheading_font_uppercase = 'none'
  if settings.type_sub_uppercase
    assign subheading_font_uppercase = 'uppercase'
  endif

  case settings.swatch_size
    when 'regular'
      assign swatch_size_filters = '1.15'
      assign swatch_size_product = '2.2'
      assign swatch_size_upsell = '1'
    when 'large'
      assign swatch_size_filters = '1.5'
      assign swatch_size_product = '3.0'
      assign swatch_size_upsell = '1.32'
  endcase

  assign backdrop_bg = 'rgba(0,0,0,0.4)'
  assign backdrop_opacity = 1

  assign white = '#ffffff'
  assign black = '#000000'

  assign product_grid_align = 'left'
  assign product_grid_justify = 'flex-start'
  if settings.product_grid_center
    assign product_grid_align = 'center'
    assign product_grid_justify = 'center'
  endif

  assign global_radius = 0
  assign swatch_radius = 0
  if settings.enable_rounded_corners
    assign global_radius = '4px'
    assign swatch_radius = '3px'
  endif

  if settings.swatch_style == 'circle'
    assign swatch_radius = '50%'
  endif
-%}

<!-- CSS ================================================================== -->
{% style %}
  {% if base_font_custom %}
    @font-face {
      font-family: "{{ base_font_custom_name }}";
      font-weight: {{ base_font_custom_weight }};
      font-style: {{ base_font_custom_style }};
      font-display: swap;
      src: url("{{ base_font_custom_filename | asset_url }}") format("{{ base_font_custom_format }}");
    }
  {% else %}
    {{ base_font | font_face: font_display: 'swap' }}
  {% endif %}

  {% if heading_font_custom %}
    @font-face {
      font-family: "{{ heading_font_custom_name }}";
      font-weight: {{ heading_font_custom_weight }};
      font-style: {{ heading_font_custom_style }};
      font-display: swap;
      src: url("{{ heading_font_custom_filename | asset_url }}") format("{{ heading_font_custom_format }}");
    }
  {% else %}
    {{ heading_font | font_face: font_display: 'swap' }}
  {% endif %}

  {% if subheading_font_custom %}
    @font-face {
      font-family: "{{ subheading_font_custom_name }}";
      font-weight: {{ subheading_font_custom_weight }};
      font-style: {{ subheading_font_custom_style }};
      font-display: swap;
      src: url("{{ subheading_font_custom_filename | asset_url }}") format("{{ subheading_font_custom_format }}");
    }
  {% else %}
    {{ subheading_font | font_face: font_display: 'swap' }}
  {% endif %}

  {% if nav_font_custom %}
    @font-face {
      font-family: "{{ nav_font_custom_name }}";
      font-weight: {{ nav_font_custom_weight }};
      font-style: {{ nav_font_custom_style }};
      font-display: swap;
      src: url("{{ nav_font_custom_filename | asset_url }}") format("{{ nav_font_custom_format }}");
    }
  {% else %}
    {{ nav_font | font_face: font_display: 'swap' }}
  {% endif %}

  {% if btn_font_custom %}
    @font-face {
      font-family: "{{ btn_font_custom_name }}";
      font-weight: {{ btn_font_custom_weight }};
      font-style: {{ btn_font_custom_style }};
      font-display: swap;
      src: url("{{ btn_font_custom_filename | asset_url }}") format("{{ btn_font_custom_format }}");
    }
  {% else %}
    {{ btn_font | font_face: font_display: 'swap' }}
  {% endif %}

  {% if base_font_bold %}
    {{ base_font_bold | font_face: font_display: 'swap' }}
  {% endif %}

  {% if base_font_italic %}
    {{ base_font_italic | font_face: font_display: 'swap' }}
  {% endif %}

  {% if base_font_bold_italic %}
    {{ base_font_bold_italic | font_face: font_display: 'swap' }}
  {% endif %}

  {% if nav_font_bold %}
    {{ nav_font_bold | font_face: font_display: 'swap' }}
  {% endif %}

  {% if heading_font_bold %}
    {{ heading_font_bold | font_face: font_display: 'swap' }}
  {% endif %}

  {% if heading_font_italic %}
    {{ heading_font_italic | font_face: font_display: 'swap' }}
  {% endif %}

  {% for scheme in settings.color_schemes -%}
    {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
    {% if forloop.first -%}
      :root,
    {%- endif %}
    .color-{{ scheme.id }} {
      {%- liquid
        assign hover_opacity = 0.70
        assign link_opposite = '#ffffff'
        assign contrast_limit = 2
        assign contrast_white = scheme.settings.links | color_contrast: white
        assign contrast_black = scheme.settings.links | color_contrast: black
        if contrast_white < contrast_limit and contrast_black > contrast_white
          assign link_opposite = '#000000'
        endif

        assign color_bg_accent_opposite = scheme.settings.bg_light | color_lighten: 100
        assign color_bg_accent_contrast = scheme.settings.bg_light | color_contrast: color_bg_accent_opposite
        if color_bg_accent_contrast < contrast_limit
          assign color_bg_accent_opposite = scheme.settings.bg_light | color_darken: 100
        endif
      -%}

      --COLOR-TEXT: {{ scheme.settings.text }};
      --COLOR-TEXT-HOVER: {{ scheme.settings.text | color_modify: 'alpha', hover_opacity }};
      --COLOR-TEXT-LIGHT: {{ scheme.settings.text | color_mix: scheme.settings.bg, 70 }};
      --COLOR-TEXT-DARK: {{ scheme.settings.text | color_saturate: 10 | color_darken: 15 }};
      --COLOR-TEXT-A5:  {{ scheme.settings.text | color_modify: 'alpha', 0.05 }};
      --COLOR-TEXT-A35: {{ scheme.settings.text | color_modify: 'alpha', 0.35 }};
      --COLOR-TEXT-A50: {{ scheme.settings.text | color_modify: 'alpha', 0.50 }};
      --COLOR-TEXT-A80: {{ scheme.settings.text | color_modify: 'alpha', 0.80 }};

      --COLOR-ACCENT: {{ scheme.settings.accent }};
      --COLOR-ACCENT-HOVER: {{ scheme.settings.accent | color_saturate: 10 | color_darken: 15 }};
      --COLOR-ACCENT-FADE: {{ scheme.settings.accent | color_modify: 'alpha', 0.05 }};
      --COLOR-ACCENT-LIGHT: {{ scheme.settings.accent | color_saturate: 20 | color_lighten: 30 }};

      --COLOR-BG: {{ scheme.settings.bg }};
      --COLOR-BG-RGB: {{ scheme.settings.bg | color_extract: 'red' }}, {{ scheme.settings.bg | color_extract: 'green' }}, {{ scheme.settings.bg | color_extract: 'blue' }};
      --COLOR-BG-GRADIENT: {{ scheme.settings.bg_gradient | default: scheme.settings.bg }};

      --COLOR-BG-ACCENT: {{ scheme.settings.bg_light }};
      --COLOR-BG-ACCENT-OPPOSITE: {{ color_bg_accent_opposite }};
      --COLOR-BG-ACCENT-OPPOSITE-A50: {{ color_bg_accent_opposite | color_modify: 'alpha', 0.50 }};
      --COLOR-BG-ACCENT-LIGHTEN: {{ scheme.settings.bg_light | color_lighten: 15 }};

      --COLOR-BORDER: {{ scheme.settings.border | color_to_rgb }};
      --COLOR-BORDER-LIGHT: {{ scheme.settings.border | color_mix: scheme.settings.bg, 60 }};
      --COLOR-BORDER-DARK: {{ scheme.settings.border | color_darken: 20 }};
      --COLOR-BORDER-HAIRLINE: {{ scheme.settings.bg | color_darken: 3 }};

      --COLOR-LINK: {{ scheme.settings.links }};
      --COLOR-LINK-HOVER: {{ scheme.settings.links | color_modify: 'alpha', hover_opacity }};
      --COLOR-LINK-OPPOSITE: {{ link_opposite }};

      --OVERLAY-BG: {{ scheme.settings.overlay }};

      --BTN-PRIMARY-BG: {{ scheme.settings.btn_primary_bg }};
      --BTN-PRIMARY-TEXT: {{ scheme.settings.btn_primary_text }};
      --BTN-PRIMARY-BORDER: {{ scheme.settings.btn_primary_border }};

      {% assign btn_primary_brightness = scheme.settings.btn_primary_bg | color_brightness %}
      {% if btn_primary_brightness <= 65 %}
        --BTN-PRIMARY-BG-BRIGHTER: {{ scheme.settings.btn_primary_bg | color_lighten: 10 }};
      {% else %}
        --BTN-PRIMARY-BG-BRIGHTER: {{ scheme.settings.btn_primary_bg | color_darken: 5 }};
      {% endif %}

      --BTN-SECONDARY-BG: {{ scheme.settings.btn_secondary_bg }};
      --BTN-SECONDARY-TEXT: {{ scheme.settings.btn_secondary_text }};
      --BTN-SECONDARY-BORDER: {{ scheme.settings.btn_secondary_border }};

      {% assign btn_secondary_brightness = scheme.settings.btn_secondary_bg | color_brightness %}
      {% if btn_secondary_brightness <= 65 %}
        --BTN-SECONDARY-BG-BRIGHTER: {{ scheme.settings.btn_secondary_bg | color_lighten: 10 }};
      {% else %}
        --BTN-SECONDARY-BG-BRIGHTER: {{ scheme.settings.btn_secondary_bg | color_darken: 5 }};
      {% endif %}

      {%- liquid
        assign color_body_bg = scheme.settings.bg
        assign color_body_bg_brightness = color_body_bg | color_brightness
        if color_body_bg_brightness <= 26
          assign color_bg_brighter = color_body_bg | color_lighten: 10
        elsif color_body_bg_brightness <= 65
          assign color_bg_brighter = color_body_bg | color_lighten: 5
        else
          assign color_bg_brighter = color_body_bg | color_darken: 5
        endif
      -%}

      --COLOR-BG-BRIGHTER: {{ color_bg_brighter }};
      --COLOR-BG-TRANSPARENT: {{ scheme.settings.bg | color_modify: 'alpha', 0 }};
      --COLOR-BG-ALPHA-25: {{ scheme.settings.bg | color_modify: 'alpha', 0.25 }};

      {%- liquid
        assign footer_bg_brightness = scheme.settings.bg | color_brightness
        if footer_bg_brightness > 100
          assign footer_bg_hairline = scheme.settings.bg | color_darken: 3
        else
          assign footer_bg_hairline = scheme.settings.bg | color_lighten: 3
        endif
      -%}

      --COLOR-FOOTER-BG-HAIRLINE: {{ footer_bg_hairline }};

      --accent: var(--COLOR-ACCENT);
      --accent-fade: var(--COLOR-ACCENT-FADE);
      --accent-hover: var(--COLOR-ACCENT-HOVER);
      --border: var(--COLOR-BORDER);
      --border-dark: var(--COLOR-BORDER-DARK);
      --border-light: var(--COLOR-BORDER-LIGHT);
      --border-hairline: var(--COLOR-BORDER-HAIRLINE);
      --bg: var(--COLOR-BG-GRADIENT, var(--COLOR-BG));
      --bg-brighter: var(--COLOR-BG-BRIGHTER);
      --bg-accent: var(--COLOR-BG-ACCENT);
      --bg-accent-opposite: var(--COLOR-BG-ACCENT-OPPOSITE);
      --bg-accent-opposite-a50: var(--COLOR-BG-ACCENT-OPPOSITE-A50);
      --bg-accent-lighten: var(--COLOR-BG-ACCENT-LIGHTEN);
      --icons: var(--COLOR-TEXT);
      --link: var(--COLOR-LINK);
      --link-hover: var(--COLOR-LINK-HOVER);
      --link-opposite: var(--COLOR-LINK-OPPOSITE);
      --text: var(--COLOR-TEXT);
      --text-dark: var(--COLOR-TEXT-DARK);
      --text-light: var(--COLOR-TEXT-LIGHT);
      --text-hover: var(--COLOR-TEXT-HOVER);
      --text-a5: var(--COLOR-TEXT-A5);
      --text-a35: var(--COLOR-TEXT-A35);
      --text-a50: var(--COLOR-TEXT-A50);
      --text-a80: var(--COLOR-TEXT-A80);
    }
  {% endfor %}

  {{ scheme_classes | prepend: 'body' }} {
    color: var(--text);
    background: var(--bg);
  }

  :root {
    --scrollbar-width: 0px;

    /*** Product grid badges ***/
    --COLOR-BADGE-BG: {{ settings.badge_bg_color }};
    --COLOR-BADGE-TEXT: {{ settings.badge_text_color }};

    /*** Product grid sale tags ***/
    --COLOR-SALE-BG: {{ settings.sale_bg_color }};
    --COLOR-SALE-TEXT: {{ settings.sale_text_color }};

    /*** Product grid new badge ***/
    --COLOR-NEW-BADGE-BG: {{ settings.new_badge_bg_color }};
    --COLOR-NEW-BADGE-TEXT: {{ settings.new_badge_text_color }};

    /*** Product grid sold badge ***/
    --COLOR-SOLD-BG: {{ settings.sold_out_bg_color }};
    --COLOR-SOLD-TEXT: {{ settings.sold_out_text_color }};

    /*** Product grid preorder badge ***/
    --COLOR-PREORDER-BG: {{ settings.preorder_bg_color }};
    --COLOR-PREORDER-TEXT: {{ settings.preorder_text_color }};

    /*** Product card tags ***/
    {%- if settings.product_card_tags_bg_color.alpha > 0.0 -%}
      --COLOR-PRODUCT-CARD-TAGS-BG: {{ settings.product_card_tags_bg_color }};
    {%- endif -%}
    {%- if settings.product_card_tags_text_color.alpha > 0.0 -%}
      --COLOR-PRODUCT-CARD-TAGS-TEXT: {{ settings.product_card_tags_text_color }};
    {%- endif -%}

    /*** Flourish dots ***/
    --FLOURISH-DOT-SIZE: 8px;
    --FLOURISH-SUBHEADING-MARGIN: 10px;
    --FLOURISH-BADGE-MARGIN: 6px;
    --FLOURISH-SUBHEADING-CONTENT: {% if settings.subheading_flourish_enable %}""{% else %}none{% endif %};
    --FLOURISH-BADGE-CONTENT: {% if settings.badge_flourish_enable %}""{% else %}none{% endif %};

    /*** Quick Add ***/
    {%- assign quick_add_lightness = settings.quick_add_bg_color | color_extract: 'lightness' -%}
    {%- assign quick_add_bg_hover = settings.quick_add_bg_color -%}
    {% if quick_add_lightness > 85 %}
      {%- assign quick_add_bg_hover = settings.quick_add_bg_color | color_darken: 10 -%}
    {% else %}
      {%- assign quick_add_bg_hover = settings.quick_add_bg_color | color_lighten: 15 -%}
    {% endif %}

    --COLOR-QUICK-ADD-BG: {{ settings.quick_add_bg_color }};
    --COLOR-QUICK-ADD-BG-HOVER: {{ quick_add_bg_hover }};
    --COLOR-QUICK-ADD-TEXT: {{ settings.quick_add_text_color }};

    /*** Product sale color ***/
    --COLOR-SALE: {{ settings.sale_color }};

    /*** Helper colors for form error states ***/
    --COLOR-ERROR: #721C24;
    --COLOR-ERROR-BG: #F8D7DA;
    --COLOR-ERROR-BORDER: #F5C6CB;

    --COLOR-SUCCESS: #56AD6A;
    --COLOR-SUCCESS-BG: rgba(86, 173, 106, 0.2);

    --COLOR-HEADER-LINK: {{ settings.header_link }};
    --COLOR-HEADER-LINK-HOVER: {{ settings.header_link }};

    --COLOR-MENU-BG: {{ settings.menu_bg_color }};
    --COLOR-SUBMENU-BG: {{ settings.submenu_bg_color }};
    --COLOR-SUBMENU-LINK: {{ settings.submenu_link_color }};
    --COLOR-SUBMENU-LINK-HOVER: {{ settings.submenu_link_color | color_modify: 'alpha', hover_opacity }};
    --COLOR-SUBMENU-OPPOSITE: {{ settings.submenu_link_color | color_modify: 'alpha', hover_opacity }};
    --COLOR-SUBMENU-TEXT-LIGHT: {{ settings.submenu_link_color | color_mix: settings.submenu_bg_color, 70 }};
    --COLOR-MENU-TRANSPARENT: {{ settings.menu_transparent_color }};
    --COLOR-MENU-TRANSPARENT-HOVER: {{ settings.menu_transparent_color }};

    --TRANSPARENT: rgba(255, 255, 255, 0);

    /*** Borders ***/
    --BORDER-THICKNESS: {{ settings.border_thickness | default: 1 }}px;

    /*** Rounded corners ***/
    --RADIUS: {{ global_radius }};
    --RADIUS-SWATCH: {{ swatch_radius }};

    {% if settings.btn_border_style == 'rounded' %}
      --RADIUS-TAG: 3px;
      --RADIUS-SELECT: 3px;
      --RADIUS-BUTTON: 3px;
    {% elsif settings.btn_border_style == 'pill' %}
      --RADIUS-TAG: 300px;
      --RADIUS-SELECT: 28px;
      --RADIUS-BUTTON: 28px;
    {% else %}
      --RADIUS-TAG: 0px;
      --RADIUS-SELECT: 0px;
      --RADIUS-BUTTON: 0px;
    {% endif %}

    --RADIUS-SELECT-OPEN: min(var(--RADIUS-SELECT), calc((var(--form-top) * 2 + var(--BORDER-THICKNESS) * 2 + var(--BTN-FONT-SIZE-BODY) * var(--line-height-normal)) / 2));
    --RADIUS-SELECT-OPEN-SMALL: min(var(--RADIUS-SELECT), calc(var(--min-h, 26px) / 2));
    --RADIUS-SELECT-OPEN-INLINE: min(var(--RADIUS-SELECT), calc((var(--btn-top) * 2 + var(--BTN-FONT-SIZE) * var(--line-height-normal) + var(--BORDER-THICKNESS) * 2) / 2));

    /*** Default overlay opacity ***/
    --overlay-opacity: 0;
    --underlay-opacity: {{ backdrop_opacity }};
    --underlay-bg: {{ backdrop_bg }};
    --header-overlay-color: transparent;

    /*** Frosted glass opacity ***/
    {% if settings.enable_frosted_glass %}
      --frosted-glass-bg-opacity: 50%;
      --frosted-glass-border-opacity: 50%;
    {% endif %}

    /*** Custom Icons ***/
    {%- liquid
      assign icon_graph_stroke_width = 2
      assign icon_asset_suffix = ''
      if settings.icon_style == 'light'
        assign icon_asset_suffix = '-light'
        assign icon_graph_stroke_width = 1
      endif
    -%}
    --ICON-BAG: url( "{{ 'shopping-bag' | append: icon_asset_suffix | append: '.svg' | asset_url }}" );
    --ICON-ARROW-LEFT: url( "{{ 'caret-left' | append: icon_asset_suffix | append: '.svg' | asset_url }}" );
    --ICON-ARROW-RIGHT: url( "{{ 'caret-right' | append: icon_asset_suffix | append: '.svg' | asset_url }}" );
    --ICON-SELECT: url("{{ 'caret-down' | append: icon_asset_suffix | append: '.svg' | asset_url }}");
    --ICON-GRAPH-STROKE-WIDTH: {{  icon_graph_stroke_width }};

    /*** Product card ***/
    --PRODUCT-GRID-ASPECT-RATIO: {{ settings.product_grid_aspect_ratio | times: 100 }}%;
    --PRODUCT-CARD-ALIGN: {{ product_grid_align }};
    --PRODUCT-CARD-JUSTIFY: {{ product_grid_justify }};

    /*** Typography ***/
    --FONT-SIZE-BASE: {{ settings.base_font_size | append: 'px' }};
    --FONT-SIZE-NAV: {{ settings.nav_font_size | append: 'px' }};

    --FONT-BODY-X-SMALL: {{ settings.body_x_small | append: 'px' }};
    --FONT-BODY-SMALL: {{ settings.body_small | append: 'px' }};
    --FONT-BODY-MEDIUM: {{ settings.body_medium | append: 'px' }};
    --FONT-BODY-LARGE: {{ settings.body_large | append: 'px' }};
    --FONT-BODY-X-LARGE: {{ settings.body_x_large | append: 'px' }};

    --FONT-BODY-X-SMALL-MOBILE: {{ settings.body_x_small_mobile | append: 'px' }};
    --FONT-BODY-SMALL-MOBILE: {{ settings.body_small_mobile | append: 'px' }};
    --FONT-BODY-MEDIUM-MOBILE: {{ settings.body_medium_mobile | append: 'px' }};
    --FONT-BODY-LARGE-MOBILE: {{ settings.body_large_mobile | append: 'px' }};
    --FONT-BODY-X-LARGE-MOBILE: {{ settings.body_x_large_mobile | append: 'px' }};

    --FONT-HEADING-MINI: {{ settings.heading_mini | append: 'px' }};
    --FONT-HEADING-X-SMALL: {{ settings.heading_x_small | append: 'px' }};
    --FONT-HEADING-SMALL: {{ settings.heading_small | append: 'px' }};
    --FONT-HEADING-MEDIUM: {{ settings.heading_medium | append: 'px' }};
    --FONT-HEADING-LARGE: {{ settings.heading_large | append: 'px' }};
    --FONT-HEADING-X-LARGE: {{ settings.heading_x_large | append: 'px' }};

    --FONT-HEADING-MINI-MOBILE: {{ settings.heading_mini_mobile | append: 'px' }};
    --FONT-HEADING-X-SMALL-MOBILE: {{ settings.heading_x_small_mobile | append: 'px' }};
    --FONT-HEADING-SMALL-MOBILE: {{ settings.heading_small_mobile | append: 'px' }};
    --FONT-HEADING-MEDIUM-MOBILE: {{ settings.heading_medium_mobile | append: 'px' }};
    --FONT-HEADING-LARGE-MOBILE: {{ settings.heading_large_mobile | append: 'px' }};
    --FONT-HEADING-X-LARGE-MOBILE: {{ settings.heading_x_large_mobile | append: 'px' }};

    --FONT-SIZE-SUBHEADING-DESKTOP: {{ settings.subheading_size_desktop | append: 'px' }};
    --FONT-SIZE-SUBHEADING-MOBILE: {{ settings.subheading_size_mobile | append: 'px' }};

    --LETTER-SPACING-BODY: {{ settings.body_letter_spacing | divided_by: 1000.0 | append: 'em' }};
    --LETTER-SPACING-HEADING: {{ settings.heading_letter_spacing | divided_by: 1000.0 | append: 'em' }};
    --LETTER-SPACING-SUBHEADING: {{ settings.sub_letter_spacing | divided_by: 1000.0 | append: 'em' }};
    --LETTER-SPACING-NAV: {{ settings.nav_letter_spacing | divided_by: 1000.0 | append: 'em' }};

    --FONT-UPPERCASE-HEADING: {{ heading_font_uppercase }};
    --FONT-UPPERCASE-SUBHEADING: {{ subheading_font_uppercase }};

    {% if heading_font_custom %}
      --FONT-STACK-HEADING: {{ heading_font_custom_name }};
      --FONT-WEIGHT-HEADING: normal;
      --FONT-STYLE-HEADING: normal;
    {% else %}
      --FONT-STACK-HEADING: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --FONT-WEIGHT-HEADING: {{ heading_font.weight }};
      --FONT-STYLE-HEADING: {{ heading_font.style }};
    {% endif %}
    --FONT-WEIGHT-HEADING-BOLD: {{ heading_font_bold.weight | default: 'bolder' }};

    {% if subheading_font_custom %}
      --FONT-STACK-SUBHEADING: {{ subheading_font_custom_name }};
      --FONT-WEIGHT-SUBHEADING: normal;
      --FONT-STYLE-SUBHEADING: normal;
    {% else %}
      --FONT-STACK-SUBHEADING: {{ subheading_font.family }}, {{ subheading_font.fallback_families }};
      --FONT-WEIGHT-SUBHEADING: {{ subheading_font.weight }};
      --FONT-STYLE-SUBHEADING: {{ subheading_font.style }};
    {% endif %}

    {% if base_font_custom %}
      --FONT-STACK-BODY: {{ base_font_custom_name }};
      --FONT-WEIGHT-BODY: normal;
      --FONT-STYLE-BODY: normal;
    {% else %}
      --FONT-STACK-BODY: {{ base_font.family }}, {{ base_font.fallback_families }};
      --FONT-STYLE-BODY: {{ base_font.style }};
      --FONT-WEIGHT-BODY: {{ base_font.weight }};
      --FONT-WEIGHT-BODY-BOLD: {{ base_font_bold.weight | default: 700 }};
    {% endif %}

    {% if btn_font_custom %}
      --FONT-STACK-BTN: {{ btn_font_custom_name }};
      --FONT-STYLE-BTN: normal;
      --FONT-WEIGHT-BTN: normal;
    {% else %}
      --FONT-STACK-BTN: {{ btn_font.family }}, {{ btn_font.fallback_families }};
      --FONT-WEIGHT-BTN: {{ btn_font.weight }};
      --FONT-STYLE-BTN: {{ btn_font.style }};
    {% endif %}

    {% if nav_font_custom != blank %}
      --FONT-STACK-NAV: {{ nav_font_custom_name }};
    {% else %}
      --FONT-STACK-NAV: {{ nav_font.family }}, {{ nav_font.fallback_families }};
      --FONT-WEIGHT-NAV: {{ nav_font.weight }};
      --FONT-WEIGHT-NAV-BOLD: {{ nav_font_bold.weight | default: 700 }};
      --FONT-STYLE-NAV: {{ nav_font.style }};
    {% endif %}

    --PARALLAX-STRENGTH-MIN: {{ settings.parallax_strength | plus: 100.0 | append: '%' }};
    --PARALLAX-STRENGTH-MAX: {{ settings.parallax_strength | plus: 110.0 | append: '%' }};

    {%- comment -%} Sidebar on Collection and Search {%- endcomment -%}
    --SIDEBAR-WIDTH: 288px;
    --SIDEBAR-WIDTH-MEDIUM: 258px;

    {%- comment -%} Drawers {%- endcomment -%}
    --DRAWER-WIDTH: 600px;
    --DRAWER-WIDTH-MOBILE: 380px;

    {%- comment -%} Spacing Variables {%- endcomment -%}
    --SPACING-MICRO: 5px;
    --SPACING-TINY: 10px;
    --SPACING-SMALL: 16px;
    --SPACING-MEDIUM: 20px;
    --SPACING-LARGE: 24px;

    {%- comment -%} Grid Variables {%- endcomment -%}
    --COLUMNS: 4;
    --COLUMNS-MEDIUM: 3;
    --COLUMNS-SMALL: 2;
    --COLUMNS-MOBILE: 1;
    --PRODUCTS-PER-ROW-MOBILE: {{ settings.products_per_row_mobile | default: 1 }};

    {%- comment -%} Used for text padding inline when:
     - Grid style is set to compact
     - Grid override is enabled and grid gap is set to 0
    {%- endcomment -%}
    --GRID-INNER: 0px;
    --GRID-INNER-MEDIUM: 0px;
    --GRID-INNER-SMALL: 0px;

    --LAYOUT-INNER: 20px;
    --LAYOUT-INNER-MEDIUM: 18px;
    --LAYOUT-INNER-SMALL: 16px;

    {%- unless settings.grid_override -%}
      --WIDTH-FULL-PADDED: 100%;
      --WIDTH-FULL-PADDED-MOBILE: 100%;
      --WIDTH-NORMAL: 1100px;
      --WIDTH-NORMAL-WIDE: 80vw;
      --WIDTH-NARROW: 670px;

      {%- if settings.grid_style == 'compact' -%}
        --LAYOUT-OUTER: 32px;
        --LAYOUT-OUTER-MEDIUM: 22px;
        --LAYOUT-OUTER-SMALL: 16px;

        --LAYOUT-GAP: 32px;
        --LAYOUT-GAP-MEDIUM: 22px;
        --LAYOUT-GAP-SMALL: 16px;

        --GRID-OUTER: 0px;
        --GRID-OUTER-MEDIUM: 0px;
        --GRID-OUTER-SMALL: 0px;

        --GRID-INNER: 20px;
        --GRID-INNER-MEDIUM: 18px;
        --GRID-INNER-SMALL: 16px;

        --GRID-GAP: 0px;
        --GRID-GAP-MEDIUM: 0px;
        --GRID-GAP-SMALL: 0px;

        --GRID-GAP-VERTICAL: 0px;
        --GRID-GAP-VERTICAL-MEDIUM: 0px;
        --GRID-GAP-VERTICAL-SMALL: 0px;

        --HEADER-SPACING-SCALE: 0.7;
      {%- elsif settings.grid_style == 'classic' -%}
        --LAYOUT-OUTER: 50px;
        --LAYOUT-OUTER-MEDIUM: 30px;
        --LAYOUT-OUTER-SMALL: 16px;

        --LAYOUT-GAP: 32px;
        --LAYOUT-GAP-MEDIUM: 22px;
        --LAYOUT-GAP-SMALL: 16px;

        --GRID-OUTER: 50px;
        --GRID-OUTER-MEDIUM: 30px;
        --GRID-OUTER-SMALL: 16px;

        --GRID-GAP: 32px;
        --GRID-GAP-MEDIUM: 22px;
        --GRID-GAP-SMALL: 16px;

        --HEADER-SPACING-SCALE: 1;
      {%- elsif settings.grid_style == 'tight' -%}
        --LAYOUT-OUTER: 16px;
        --LAYOUT-OUTER-MEDIUM: 16px;
        --LAYOUT-OUTER-SMALL: 16px;

        --LAYOUT-INNER: 16px;
        --LAYOUT-INNER-MEDIUM: 16px;
        --LAYOUT-INNER-SMALL: 16px;

        --LAYOUT-GAP: 16px;
        --LAYOUT-GAP-MEDIUM: 12px;
        --LAYOUT-GAP-SMALL: 8px;

        --GRID-OUTER: 16px;
        --GRID-OUTER-MEDIUM: 16px;
        --GRID-OUTER-SMALL: 16px;

        --GRID-GAP: 16px;
        --GRID-GAP-MEDIUM: 12px;
        --GRID-GAP-SMALL: 8px;

        --HEADER-SPACING-SCALE: 0.85;
      {%- elsif settings.grid_style == 'wide' -%}
        --LAYOUT-OUTER: 80px;
        --LAYOUT-OUTER-MEDIUM: 60px;
        --LAYOUT-OUTER-SMALL: 30px;

        --LAYOUT-GAP: 80px;
        --LAYOUT-GAP-MEDIUM: 60px;
        --LAYOUT-GAP-SMALL: 30px;

        --GRID-OUTER: 80px;
        --GRID-OUTER-MEDIUM: 60px;
        --GRID-OUTER-SMALL: 30px;

        --GRID-GAP: 80px;
        --GRID-GAP-MEDIUM: 40px;
        --GRID-GAP-SMALL: 30px;

        --SIDEBAR-WIDTH: 317px;
        --SIDEBAR-WIDTH-MEDIUM: 287px;

        --HEADER-SPACING-SCALE: 1.2;
      {%- endif -%}
    {%- else -%}
      --WIDTH-FULL-PADDED: {{ settings.section_width_padded }}%;
      --WIDTH-NORMAL: {{ settings.page_width | times: settings.section_width_normal | divided_by: 100 }}px;
      --WIDTH-NARROW: {{ settings.page_width | times: settings.section_width_narrow | divided_by: 100 }}px;
      --WIDTH-FULL-PADDED-MOBILE: {{ settings.section_width_padded_mobile }}%;
      --WIDTH-NORMAL-MOBILE: {{ settings.section_width_normal_mobile }}%;
      --WIDTH-NARROW-MOBILE: {{ settings.section_width_narrow_mobile }}%;

      --HEADER-SPACING-SCALE: {{ settings.section_width_padded | minus: 85 | times: 0.02 | plus: 0.7 }};
      --HEADER-SPACING-SCALE-MOBILE: {{ settings.section_width_padded_mobile | minus: 85 | divided_by: 30.0 | plus: 0.5 }};

      --LAYOUT-OUTER: 50px;
      --LAYOUT-OUTER-MEDIUM: 30px;
      --LAYOUT-OUTER-SMALL: 16px;

      --LAYOUT-GAP: 32px;
      --LAYOUT-GAP-MEDIUM: 22px;
      --LAYOUT-GAP-SMALL: 16px;

      --GRID-OUTER: 50px;
      --GRID-OUTER-MEDIUM: 30px;
      --GRID-OUTER-SMALL: 16px;

      --GRID-GAP: {{ settings.grid_gap_horizontal }}px;
      --GRID-GAP-MEDIUM: {{ settings.grid_gap_horizontal | times: 0.6 | round }}px;
      --GRID-GAP-SMALL: {{ settings.grid_gap_horizontal | times: 0.32 | round }}px;

      --GRID-GAP-VERTICAL: {{ settings.grid_gap_vertical }}px;
      --GRID-GAP-VERTICAL-MEDIUM: {{ settings.grid_gap_vertical | times: 0.6 | round }}px;
      --GRID-GAP-VERTICAL-SMALL: {{ settings.grid_gap_vertical | times: 0.32 | round }}px;

      {%- if settings.grid_gap_horizontal == 0 -%}
        --LAYOUT-OUTER: 32px;
        --LAYOUT-OUTER-MEDIUM: 22px;
        --LAYOUT-OUTER-SMALL: 16px;

        --GRID-OUTER: 0px;
        --GRID-OUTER-MEDIUM: 0px;
        --GRID-OUTER-SMALL: 0px;

        --GRID-INNER: 20px;
        --GRID-INNER-MEDIUM: 18px;
        --GRID-INNER-SMALL: 16px;

        --GRID-OUTER: 0px;
        --GRID-OUTER-MEDIUM: 0px;
        --GRID-OUTER-SMALL: 0px;
      {%- endif -%}
    {%- endunless -%}

    --base-animation-delay: 0ms;
    --line-height-normal: 1.375; /* Equals to line-height: normal; */

    /*** Button General ***/
    --BTN-FONT-SIZE: {{ settings.btn_size }}px;
    --BTN-MEDIUM-SIZE: {{ settings.button_medium }}px;
    --BTN-LARGE-SIZE: {{ settings.button_large }}px;
    --BTN-SMALL-SIZE: {{ settings.button_small }}px;
    --BTN-BORDER-THICKNESS: {{ settings.btn_border_thickness | default: 1 }}px;

    {%- assign font_size_base_decimal = settings.base_font_size | append: '.0' -%}
    --BTN-FONT-SIZE-BODY: {{ settings.btn_size | divided_by: font_size_base_decimal }}rem;

    --BTN-LETTER-SPACING: {{ settings.btn_letter_spacing | divided_by: 1000.0 | append: 'em' }};
    --BTN-UPPERCASE: {% if settings.btn_caps %}uppercase{% else %}none{% endif %};
    --BTN-TEXT-ARROW-OFFSET: {% if settings.btn_caps %}-1px{% else %}0px{% endif %};

    /*** Button White ***/
    --COLOR-TEXT-BTN-BG-WHITE: #fff;
    --COLOR-TEXT-BTN-BORDER-WHITE: #fff;
    --COLOR-TEXT-BTN-WHITE: #000;
    --COLOR-TEXT-BTN-BG-WHITE-BRIGHTER: {{ '#fff' | color_darken: 5 }};

    /*** Button Black ***/
    --COLOR-TEXT-BTN-BG-BLACK: #000;
    --COLOR-TEXT-BTN-BORDER-BLACK: #000;
    --COLOR-TEXT-BTN-BLACK: #fff;
    --COLOR-TEXT-BTN-BG-BLACK-BRIGHTER: {{ '#000' | color_lighten: 10 }};

    /*** Swatch Size ***/
    --swatch-size-filters: {{ swatch_size_filters }}rem;
    --swatch-size-product: {{ swatch_size_product }}rem;
    --swatch-size-upsell: {{ swatch_size_upsell }}rem;
    --swatch-size: var(--swatch-size-product);
    --swatch-default: #CCC;
  }

  {%- if settings.product_grid_aspect_ratio_mobile_enable -%}
    @media (max-width: 749px) {
      :root { --PRODUCT-GRID-ASPECT-RATIO: {{ settings.product_grid_aspect_ratio_mobile | times: 100 }}%; }
    }
  {%- endif -%}

  /*** Backdrop ***/
  ::backdrop {
    --underlay-opacity: {{ backdrop_opacity }};
    --underlay-bg: {{ backdrop_bg }};
  }

  /*** Gray background on Product cards ***/
  {% if settings.show_image_bg == 'front' or settings.show_image_bg == 'behind' %}
    .show-gray-bg::before,
    .pswp__img::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: {{ settings.show_image_bg_color }};
      opacity: {{ settings.show_image_bg_opacity | times: 0.01 }};
      pointer-events: none;
      {% if settings.show_image_bg == 'front' %}
        z-index: 5;
      {% endif %}
    }
  {% endif %}

  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }

  * { -webkit-font-smoothing: antialiased; }

  html {
    box-sizing: border-box;
    font-size: var(--FONT-SIZE-BASE);
  }

  html,
  body { min-height: 100%; }

  body {
    position: relative;
    min-width: 320px;
  }

  /* Registered custom property so --bullet-color can be interpolated via
     `transition`. Initial value is a sane fallback; bullets seed it from
     var(--text) below, and JS overrides it per active slide for live syncing. */
  @property --bullet-color {
    syntax: '<color>';
    inherits: true;
    initial-value: #000;
  }

  {% if settings.dots_style == 'circle' %}
    swiper-container::part(bullet),
    swiper-container::part(bullet-active),
    .swiper-pagination-bullet {
      --swiper-pagination-bullet-width: 10px;
      --swiper-pagination-bullet-height: 10px;
      --swiper-pagination-bullet-radius: 50%;
      --swiper-pagination-bullet-inactive-opacity: 1;
      --swiper-pagination-bullet-border: none;
      --swiper-pagination-bullet-bg: color-mix(in srgb, var(--bullet-color) var(--swiper-pagination-bullet-track-opacity, 25%), transparent);
      --bullet-progress-fill: conic-gradient(var(--bullet-color) var(--bullet-progress, 0%), transparent 0%);
    }
  {% elsif settings.dots_style == 'line' %}
    swiper-container::part(bullet),
    swiper-container::part(bullet-active),
    .swiper-pagination-bullet {
      --swiper-pagination-bullet-width: 50px;
      --swiper-pagination-bullet-height: 4px;
      --swiper-pagination-bullet-radius: var(--RADIUS-TAG);
      --swiper-pagination-bullet-inactive-opacity: 25%;
      --swiper-pagination-bullet-border: none;
      --swiper-pagination-bullet-bg: var(--bullet-color);
      --bullet-progress-fill: linear-gradient(var(--bullet-color), var(--bullet-color)) left center / var(--bullet-progress, 0%) 100% no-repeat;
    }
  {% else %}
    swiper-container::part(pagination),
    .swiper-pagination,
    .swiper-pagination-bullet { display: none; }
  {% endif %}

  {% if settings.dots_style != 'hidden' %}
    /* Per-slide color, seeded from the inherited --text and interpolated via
       the registered @property above. Declared on the host on every slide change and bullets inherit it through shadow DOM */
    swiper-container,
    .swiper {
      --bullet-color: var(--text);
      transition: --bullet-color 1s ease;
    }

    /* Active bullet of an autoplay slider: layered background where the first
       layer is the per-style growing fill (--bullet-progress-fill, set by each
       dots_style block) and the second is the color-mix track shared by both. */
    swiper-container[autoplay="true"]::part(bullet-active),
    .swiper:has(swiper-container[autoplay="true"]) .swiper-pagination-bullet-active {
      --swiper-pagination-bullet-bg:
        var(--bullet-progress-fill),
        color-mix(in srgb, var(--bullet-color) var(--swiper-pagination-bullet-track-opacity, 25%), transparent);
      opacity: 1;
    }
  {% endif %}

  {%- liquid
    assign cursor = ''
    if settings.cursor_image != blank
      assign cursor_x = 16
      assign cursor_y = 16
      if settings.cursor_image.aspect_ratio >= 1
        assign cursor_url = settings.cursor_image | image_url: width: 32
        assign cursor_y = 16 | divided_by: settings.cursor_image.aspect_ratio | round
      else
        assign cursor_url = settings.cursor_image | image_url: height: 32
        assign cursor_x = 16 | times: settings.cursor_image.aspect_ratio | round
      endif
      assign cursor = 'url("' | append: cursor_url | append: '") ' | append: cursor_x | append: ' ' | append: cursor_y
    elsif settings.cursor_icon != 'none'
      capture cursor_svg
        render 'icon', name: settings.cursor_icon
      endcapture
      assign cursor_svg = cursor_svg | replace_first: '<svg', '<svg stroke="#ffffff" stroke-width="24" stroke-linejoin="round" paint-order="stroke"' | base64_encode
      assign cursor = 'url("data:image/svg+xml;base64,' | append: cursor_svg | append: '") 12 12'
    endif
  -%}

  {% if cursor != blank %}
    :root { --cursor: {{ cursor }}; }

    {% if settings.cursor_enable_default %}
      body { cursor: var(--cursor), auto; }
    {% endif %}

    {% if settings.cursor_enable_links %}
      a[href],
      button:not(:disabled),
      summary,
      [role="button"],
      label[for] { cursor: var(--cursor), pointer !important; }
    {% endif %}
  {% endif %}
{% endstyle %}

{%- unless settings.type_base_font.system? -%}
  <link rel="preload" as="font" href="{{ settings.type_base_font | font_url }}" type="font/woff2" crossorigin>
{%- endunless -%}
{%- unless settings.type_header_font.system? -%}
