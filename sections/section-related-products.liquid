<!-- /sections/related.liquid -->
{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign animation_anchor = 'RelatedProducts--' | append: section.id
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign enable_tabs = section.settings.enable_tabs
  assign heading_alignment = section.settings.heading_alignment
  assign heading_size_class = section.settings.heading_font_size
  assign heading_tag = 'h2'
  unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
    assign heading_tag = section.settings.heading_tag
  endunless
  assign has_related_products = false
  assign has_recently_products = false
  assign wrapper_tag = 'div'
  if enable_tabs
    assign wrapper_tag = 'tabs-component'
  endif
-%}

{%- if enable_tabs -%}
  {%- render 'stylesheet', name: 'tabs.css' -%}
{%- endif -%}

{%- for block in content_section_blocks -%}
  {%- liquid
    assign show_related = false
    if block.type == 'related'
      if product.collections.size > 0 or block.settings.source == 'collection'
        assign show_related = true
      endif
    endif
  -%}
  {%- if show_related -%}
    {%- liquid
      assign has_related_products = true
      assign layout_mobile = section.settings.layout_mobile
      assign columns_small = 2
      assign columns_mobile = layout_mobile | plus: 0
    -%}

    {%- liquid
      # Potager: "Product's collection" shows other products from the
      # collection the shopper came from, or the product's first collection,
      # falling back to Shop all. [collection] in the heading is its title.
      assign related_collection = blank
      if block.settings.source == 'collection'
        assign related_collection = collection
        if related_collection == blank
          for c in product.collections
            unless c.handle == 'all' or c.handle == 'frontpage'
              assign related_collection = c
              break
            endunless
          endfor
        endif
        if related_collection == blank
          assign related_collection = collections.all
        endif
      endif
      assign related_collection_title = related_collection.title
      if related_collection.handle == 'all'
        assign related_collection_title = 'products.general.shop_all' | t
      endif
    -%}

    {%- capture related -%}
      {%- if related_collection != blank -%}
        {%- assign related_limit = block.settings.limit -%}
        <div
          class="grid-outer"
          style="--column-count: {{ related_limit | at_most: 4 }}; --COLUMNS-SMALL: {{ columns_small }}; --COLUMNS-MOBILE: {{ columns_mobile }};"
          {{ block.shopify_attributes }}
        >
          <grid-slider align-arrows>
            <div
              class="grid grid--slider{% if related_limit <= 4 %} grid--slider-disabled{% endif %}{% if layout_mobile == nil or layout_mobile == 'slider' %} grid--mobile-slider{% endif %}"
              data-grid-slider
              id="RelatedCollection--{{ section.id }}"
            >
              {%- liquid
                assign related_count = 0
                for related_product in related_collection.products
                  if related_count >= related_limit
                    break
                  endif
                  if related_product.id == product.id or related_product.tags contains 'hide'
                    continue
                  endif
                  assign related_count = related_count | plus: 1
                  render 'product-card', product: related_product, animation_delay: forloop.index0, animation_anchor: animation_anchor, index: related_count
                endfor
              -%}
            </div>
          </grid-slider>
        </div>
      {%- else -%}
        <div data-related-section
          data-limit="{{ block.settings.limit }}"
          data-product-id="{{ product.id }}"
          style="--column-count: {{ block.settings.limit | at_most: 4 }}; --COLUMNS-SMALL: {{ columns_small }}; --COLUMNS-MOBILE: {{ columns_mobile }};"
          {{ block.shopify_attributes }}></div>
      {%- endif -%}
    {%- endcapture -%}

    {%- capture related_title -%}
      {%- if block.settings.product_recommendations_heading != blank -%}
        {{ block.settings.product_recommendations_heading | replace: '[collection]', related_collection_title }}
      {%- endif -%}
    {%- endcapture -%}
  {%- endif -%}

  {%- if block.type == 'recent' -%}
    {%- assign has_recently_products = true -%}
    {%- assign product_recently_limit = block.settings.product_recently_limit -%}

    {%- capture recent -%}
      {%- liquid
        assign limit = product_recently_limit | default: 4
        assign column_count = limit
        assign layout_mobile = section.settings.layout_mobile
        assign columns_small = 2
        assign columns_mobile = layout_mobile | plus: 0

        if limit > 4
          assign column_count = '4'
        endif
      -%}

      <script src="{{ 'shopify-products.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

      <recently-viewed
        class="recent__wrapper fade-toggle is-hidden"
        data-wrapper-id="recently-viewed-products-{{ section.id }}"
        data-limit="{{ limit }}"
        data-target="api-product-card"
        data-minimum="{{ product_recently_minimum }}"
        {{ block.shopify_attributes -}}
      >
        <div
          class="grid-outer"
          style="--column-count: {{ column_count }}; --COLUMNS-SMALL: {{ columns_small }}; --COLUMNS-MOBILE: {{ columns_mobile }};"
        >
          <grid-slider align-arrows>
            <div
              class="recent__content grid grid--slider{% if layout_mobile == nil or layout_mobile == 'slider' %} grid--mobile-slider{% endif %}{% if limit <= 4 %} grid--slider-disabled{% endif %} hidden"
              data-grid-slider
              id="recently-viewed-products-{{ section.id }}"
            ></div>

            <slider-progress
              for="recently-viewed-products-{{ section.id }}"
              data-desktop-slider
              {% if layout_mobile == null or layout_mobile == 'slider' %}
                data-mobile-slider
              {% endif %}
              data-dynamic
            >
              <div class="slider-progress__container" data-slider-progress hidden>
                <div class="slider-progress__track">
                  <div class="slider-progress__fill" data-slider-progress-fill style="--slider-progress: 0;"></div>
                </div>
                <div class="slider-progress__counter body-x-small" data-slider-counter aria-live="polite"></div>
              </div>
            </slider-progress>
          </grid-slider>
        </div>
      </recently-viewed>
    {%- endcapture -%}

    {%- capture recent_title -%}
      {%- if block.settings.product_recently_heading != blank -%}
        {{ block.settings.product_recently_heading }}
      {%- endif -%}
    {%- endcapture -%}
  {%- endif -%}
{%- endfor -%}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
{%- endcapture -%}

{%- render 'stylesheet', name: 'related-products.css' -%}

<script src="{{ 'related-products.js' | asset_url }}" defer="defer"></script>

<related-products
  class="related__wrapper {{ color_scheme }} js"
  id="RelatedProducts--{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="related"
  {% if shape_divider_blocks != blank %}data-shape-divider-host{% endif %}
  style="{{ style }}"
>
  {%- if has_related_products or has_recently_products -%}
    <{{ wrapper_tag }}
      class="tabs-wrapper related__products section-padding{% if section.settings.width == 'wrapper' %} wrapper{% endif %}{% if section.settings.show_divider %} related__products--divider{% endif %}"
    >
      {%- if enable_tabs -%}
        <div
          class="tabs__head"
          data-aos="hero"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-order="1"
        >
          <div class="grid__heading-holder">
            <native-scrollbar class="grid__heading-actions">
              <ul class="tabs {{ heading_alignment }}" data-scrollbar data-scrollbar-slider>
                {%- if related -%}
                  <li class="tab-link tab-link-0 current" data-tab="0" tabindex="0">
                    {%- if related_title -%}
                      <span>{{ related_title }}</span>
                    {%- endif -%}
                  </li>
                {%- endif -%}

                {%- if recent -%}
                  <li
                    class="tab-link tab-link-1 tab-link__recent{% if related == nil %} current{% endif %}"
                    data-tab="1"
                    tabindex="0"
                  >
                    {%- if recent_title -%}
                      <span>{{ recent_title }}</span>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              </ul>

              <button type="button" class="tabs__arrow tabs__arrow--prev" data-scrollbar-arrow-prev disabled>
                {%- render 'icon', name: 'caret-left' -%}
                <span class="visually-hidden">{{ 'products.general.see_all' | t }}</span>
              </button>

              <button type="button" class="tabs__arrow tabs__arrow--next" data-scrollbar-arrow-next disabled>
                {%- render 'icon', name: 'caret-right' -%}
                <span class="visually-hidden">{{ 'products.general.see_all' | t }}</span>
              </button>
            </native-scrollbar>
          </div>
        </div>
      {%- endif -%}

      {%- if related -%}
        <div class="tab-content tab-content-0 current tabs__recommendation" data-tab-index="0">
          {%- if related_title != blank and enable_tabs != true -%}
            <div class="related__heading{% if related_collection != blank %} related__heading--link{% endif %}">
              <{{ heading_tag }}
                class="tab__title {{ heading_alignment }} {{ heading_size_class }}"
                data-aos="hero"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-order="1"
              >
                {{ related_title }}
              </{{ heading_tag }}>
              {%- if related_collection != blank -%}
                <a href="{{ related_collection.url }}" class="ds-cta">{{ 'products.general.view_all' | t }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}

          {{ related }}
        </div>
      {%- endif -%}

      {%- if recent -%}
        <div
          class="tab-content tab-content-1 tabs__recently-viewed{% if enable_tabs == false or related == nil %} current{% endif %}"
          data-tab-index="1"
          style="--column-count: {{ product_recently_limit }}"
        >
          {%- if recent_title != blank and enable_tabs == false -%}
            <{{ heading_tag }}
              class="tab__title {{ heading_alignment }} {{ heading_size_class }}"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="1"
            >
              {{ recent_title }}
            </{{ heading_tag }}>
          {%- endif -%}

          {{ recent }}
        </div>
      {%- endif -%}
    </{{ wrapper_tag }}>
  {%- else -%}
    <div class="section-padding">
      <p class="center">{{ 'home_page.onboarding.no_content' | t }}</p>
    </div>
  {%- endif -%}
  {%- render 'shape-dividers', mode: 'host' -%}
</related-products>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_tabs",
      "label": "Enable tabs",
      "default": true
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wrapper",
          "label": "Normal"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider above heading",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "default": "text-center",
      "options": [
        {
          "value": "text-left",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Centered"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_font_size",
      "label": "Heading size",
      "default": "heading-small",
      "options": [
        {
          "value": "heading-mini",
          "label": "Mini"
        },
        {
          "value": "heading-x-small",
          "label": "Extra small"
        },
        {
          "value": "heading-small",
          "label": "Small"
        },
        {
          "value": "heading-medium",
          "label": "Medium"
        },
        {
          "value": "heading-large",
          "label": "Large"
        },
        {
          "value": "heading-x-large",
          "label": "Extra large"
        }
      ],
      "info": "Applies only when tabs are disabled"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading SEO tag",
      "default": "automatic",
      "options": [
        {
          "value": "automatic",
          "label": "Automatic"
        },
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Mobile layout",
      "options": [
        {
          "value": "1",
          "label": "1 item per row"
        },
        {
          "value": "2",
          "label": "2 items per row"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "slider"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "related",
      "name": "Related products",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Products from",
          "default": "recommendations",
          "options": [
            {
              "value": "recommendations",
              "label": "Shopify recommendations"
            },
            {
              "value": "collection",
              "label": "Product's collection"
            }
          ],
          "info": "Product's collection: other products from the product's collection, or Shop all. Use [collection] in the heading for its name."
        },
        {
          "type": "text",
          "id": "product_recommendations_heading",
          "label": "Heading",
          "default": "Related products"
        },
        {
          "type": "range",
          "id": "limit",
          "min": 1,
          "max": 6,
          "step": 1,
          "label": "Product limit",
          "default": 4
        }
      ]
    },
    {
      "type": "recent",
      "name": "Recently viewed products",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "product_recently_heading",
          "label": "Heading",
          "default": "Recently viewed"
        },
        {
          "type": "range",
          "id": "product_recently_limit",
          "min": 1,
          "max": 6,
          "step": 1,
          "label": "Product limit",
          "default": 4
        }
      ]
    },
    {
      "type": "shape-divider",
      "name": "Shape divider",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "target_section",
          "label": "Target section",
          "info": "This will be the section that connects to the straight side of the divider.",
          "default": "below",
          "options": [
            {
              "value": "above",
              "label": "Section above"
            },
            {
              "value": "below",
              "label": "Section below"
            }
          ]
        },
        {
          "type": "color_scheme",
          "id": "target_color_scheme",
          "label": "Target section color scheme",
          "info": "Select the color scheme of the target section",
          "default": "scheme-1"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "waves-medium",
          "options": [
            {
              "value": "waves-small",
              "label": "Waves small"
            },
            {
              "value": "waves-medium",
              "label": "Waves medium"
            },
            {
              "value": "waves-large",
              "label": "Waves large"
            },
            {
              "value": "waves-abstract",
              "label": "Waves abstract"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "flip_horizontal",
          "label": "Flip horizontal",
          "default": false
        },
        {
          "type": "range",
          "id": "height",
          "label": "Desktop height",
          "min": 20,
          "max": 200,
          "step": 5,
          "unit": "px",
          "default": 80
        },
        {
          "type": "range",
          "id": "height_mobile",
          "label": "Mobile height",
          "min": 20,
          "max": 200,
          "step": 5,
          "unit": "px",
          "default": 80
        }
      ]
    }
  ]
}
{% endschema %}
