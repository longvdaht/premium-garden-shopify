<!-- /sections/section-reviews.liquid -->

{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign unique = 'Reviews--' | append: section.id
  assign animation_anchor = unique
  assign animation_order = 0
  assign aspect_ratio = 1 | divided_by: section.settings.image_aspect_ratio
  assign block_count = content_section_blocks.size | plus: 0
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign columns_desktop = block_count | at_most: 4
  assign columns_medium = 3
  assign show_featured_image = section.settings.show_featured_image
  assign show_quotation_marks = section.settings.show_quotation_marks
  assign heading_size = section.settings.heading_font_size
  assign widths = '240, 256, 296, 320, 360, 480, 512, 592, 640, 720, 960, 1024, 1080, 1184, 1280'

  if columns_desktop == 2 or columns_desktop == 4
    assign columns_medium = 2
  endif

  if show_featured_image
    assign columns_desktop = 2
    assign columns_medium = 2
  endif

  assign top_divider_height = 0
  assign top_divider_height_mobile = 0
  if show_quotation_marks
    for divider in shape_divider_blocks
      if divider.settings.target_section == 'above'
        case divider.settings.style
          when 'waves-small'
            assign wave_depth = 65
          when 'waves-large'
            assign wave_depth = 78
          when 'waves-abstract'
            assign wave_depth = 97
          else
            assign wave_depth = 90
        endcase

        assign divider_height = divider.settings.height | default: 80
        assign divider_height_mobile = divider.settings.height_mobile | default: divider_height
        assign top_divider_height = divider_height | times: wave_depth | divided_by: 120.0 | ceil
        assign top_divider_height_mobile = divider_height_mobile | times: wave_depth | divided_by: 120.0 | ceil
        break
      endif
    endfor
  endif

  capture section_classes
    echo 'reviews '
    echo section.settings.text_align

    if show_featured_image
      echo ' reviews--have-images'
    else
      echo ' reviews--no-images'
    endif

    if show_quotation_marks
      echo ' reviews--quoted'
    endif

    if top_divider_height > 0
      echo ' reviews--quotes-under-divider'
    endif
  endcapture

  capture wrapper_classes
    if show_featured_image
      echo 'wrapper--full'
    else
      echo 'wrapper--full-padded'
    endif
  endcapture

  capture sizes
    if settings.block.size == 1
      echo '(min-width: 750px) 50vw, calc(100vw - 82px)'
    else
      echo '(min-width: 750px) 25vw, calc(100vw - 82px)'
    endif
  endcapture
-%}

{%- render 'stylesheet', name: 'section-reviews.css' -%}

{%- style -%}
  #{{ unique }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
    --COLUMNS: {{ columns_desktop }};
    --COLUMNS-MEDIUM: {{ columns_medium }};
    {%- if top_divider_height > 0 %}
      --DIVIDER-TOP: {{ top_divider_height }}px;
      --DIVIDER-TOP-MOBILE: {{ top_divider_height_mobile }}px;
    {%- endif %}
  }
{%- endstyle -%}

<div
  id="{{ unique }}"
  class="{{ section_classes }} {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="reviews"
  {% if shape_divider_blocks != blank %}data-shape-divider-host{% endif %}
  {% if badge_blocks != blank %}data-badge-host{% endif %}
>
  <div class="{{ wrapper_classes }}">
    {%- if content_section_blocks.size != 0 -%}
      <grid-slider>
        <div class="slider__arrows">
          <button
            type="button"
            class="slider__button slider__button--prev"
            data-button-arrow
            data-button-prev
          >
            {{ 'general.pagination.prev' | t }}
          </button>
          <button
            type="button"
            class="slider__button slider__button--next"
            data-button-arrow
            data-button-next
          >
            {{ 'general.pagination.next' | t }}
          </button>
        </div>

        <div
          class="reviews__grid grid grid--slider section-padding"
          data-grid-slider
          {% if request.design_mode %}
            data-block-scroll
          {% endif %}
        >
          {%- for block in content_section_blocks -%}
            {%- liquid
              assign block_title = block.settings.title
              assign review = block.settings.review_content
              assign featured_image = block.settings.featured_image
              assign bio_image = block.settings.bio_image
              assign bio_image_width = block.settings.bio_image_width
              assign bio_image_render_width = bio_image_width | times: 2
              assign bio_image_sizes = bio_image_width | append: 'px'
              assign card_bg_color = block.settings.card_bg_color
              assign card_background = false
              assign subheading = block.settings.subheading
              assign review_url = block.settings.review_url
              assign animation_order = animation_order | plus: 1

              assign review_block_classes = 'review'
              if show_featured_image
                assign review_block_classes = review_block_classes | append: ' review--has-image'
              endif
              unless card_bg_color.alpha == 0.0 or card_bg_color == blank
                assign card_background = true
                assign review_block_classes = review_block_classes | append: ' review--has-card-bg'
              endunless

              if forloop.index > 2
                assign loading = 'lazy'
              endif
            -%}

            <div class="reviews__grid-item" data-grid-item data-slider-progress-item {{ block.shopify_attributes }}>
              {%- if review_url != blank -%}
                <a href="{{ review_url }}" class="{{ review_block_classes }}" rel="noopener" target="_blank">
              {%- else -%}
                <div class="{{ review_block_classes }}">
              {%- endif -%}

              {%- if show_featured_image -%}
                <div class="review__image">
                  {%- capture attributes -%}
                    data-aos="img-in"
                    data-aos-anchor="{{ animation_anchor }}"
                    data-aos-order="{{ animation_order }}"
                  {%- endcapture -%}

                  {%- if featured_image -%}
                    {%- render 'image',
                      image: featured_image,
                      sizes: sizes,
                      widths: widths,
                      attributes: attributes,
                      aspect_ratio: aspect_ratio,
                      loading: loading
                    -%}
                  {%- else -%}
                    <div class="image-wrapper" style="--aspect-ratio: {{ aspect_ratio }};" {{ attributes }}>
                      {{ 'image' | placeholder_svg_tag: 'svg-placeholder' }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="review__card"{% if card_background %} style="--card-bg: {{ card_bg_color }};"{% endif %}>
                <div
                  class="review__content"
                  data-aos="hero"
                  data-aos-anchor="{{ animation_anchor }}"
                  data-aos-order="{{ animation_order }}"
                >
                  {%- if review != blank -%}
                    {%- liquid
                      capture quotes_styles
                        assign heading_size_stripped = heading_size | remove: ''
                        echo 'font-size: calc(var(--font-' | append: heading_size_stripped | append: ') * 2.5);'
                        echo 'transform: translateY(calc((var(--font-' | append: heading_size_stripped | append: ') * 0.833) - (var(--font-' | append: heading_size_stripped | append: ') * 0.167)));'
                      endcapture
                    -%}

                    <blockquote class="blockquote font-heading {{ heading_size }}{% if show_quotation_marks %} blockquote--quoted{% endif %}">
                      {%- if show_quotation_marks -%}
                        <span class="review__quote review__quote--open">
                          <span class="review__quote-inner" style="{{ quotes_styles }}">&ldquo;</span>
                        </span>
                      {%- endif -%}

                      <p>{{ review | truncatewords: 200 }}</p>

                      {%- if show_quotation_marks -%}
                        <span class="review__quote review__quote--close">
                          <span class="review__quote-inner" style="{{ quotes_styles }}">&rdquo;</span>
                        </span>
                      {%- endif -%}
                    </blockquote>
                  {%- endif -%}

                  {%- if block_title != blank or subheading != blank or bio_image != blank -%}
                    <div class="review__author">
                      {%- if bio_image != blank -%}
                        <div class="review__author__bio-image" style="--image-size: {{ bio_image_width }}px;">
                          {%- render 'image',
                            image: bio_image,
                            width: bio_image_render_width,
                            height: bio_image_render_width,
                            sizes: bio_image_sizes,
                            widths: '34, 68, 136, 272, 544, 1088',
                            cover: true,
                            loading: loading
                          -%}
                        </div>
                      {%- endif -%}

                      {%- if block_title != blank or subheading != blank -%}
                        <div class="review__author__content">
                          {%- if block_title != blank -%}
                            <div class="review__author__name">{{ block_title }}</div>
                          {%- endif -%}

                          {%- if subheading != blank -%}
                            <span class="review__author__subheading subheading">
                              {{- subheading -}}
                            </span>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
              {%- if review_url != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <slider-progress data-slider-always>
          <div class="slider-progress__container" data-slider-progress hidden>
            <div class="slider-progress__track">
              <div class="slider-progress__fill" data-slider-progress-fill style="--slider-progress: 0;"></div>
            </div>
            <div class="slider-progress__counter body-x-small" data-slider-counter aria-live="polite"></div>
          </div>
        </slider-progress>
      </grid-slider>
    {%- else -%}
      {%- render 'no-blocks' -%}
    {%- endif -%}
  </div>
  {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
  {%- render 'shape-dividers', mode: 'host' -%}
</div>

{% schema %}
