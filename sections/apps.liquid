<div
  class="{% if section.settings.include_margins %}wrapper{% endif %}"
  data-shape-divider-root
>
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Apps",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": false,
      "label": "Include margins"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "shape-divider"
    }
  ],
  "presets": [
    {
      "name": "Apps"
    }
  ]
}
{% endschema %}
