{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign animation_anchor = 'SocialVideos--' | append: section.id
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign aspect_ratio = 1.0 | divided_by: section.settings.aspect_ratio
  assign videos_per_row = section.settings.videos_per_row
  assign videos_per_row_tablet = videos_per_row | at_most: 4
  assign popup_text = section.settings.popup_text
  assign close_label = 'general.accessibility.close' | t
-%}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
  --videos-per-row: {{ videos_per_row }};
  --videos-per-row-tablet: {{ videos_per_row_tablet }};
{%- endcapture -%}

{%- render 'stylesheet', name: 'section-social-videos.css' -%}
{%- render 'stylesheet', name: 'modal.css', async: true -%}

<div
  class="social-videos section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="social-videos"
  {% if shape_divider_blocks != blank %}data-shape-divider-host{% endif %}
  {% if badge_blocks != blank %}data-badge-host{% endif %}
  style="{{ style }}"
>
  <div class="wrapper--full">
    {%- if heading != blank or text != blank -%}
      <div class="hero__content__wrapper {{ section.settings.text_alignment }}">
        <div class="hero__content">
          {%- if heading != blank -%}
            {%- liquid
              assign animation_order = animation_order | plus: 1
              assign heading_tag = 'h2'

              if section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
                if template.name == 'index' and section.location == 'template' and section.index == 1
                  assign heading_tag = 'h1'
                endif
              else
                assign heading_tag = section.settings.heading_tag
              endif
            -%}
            <{{ heading_tag }}
              class="hero__title {{ section.settings.heading_font_size }}"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              {{- heading -}}
            </{{ heading_tag }}>
          {%- endif -%}

          {%- if text != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <div
              class="hero__description {{ section.settings.text_font_size }}"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              {{- text -}}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- assign animation_order = animation_order | plus: 1 -%}
    <div
      class="social-videos__content"
      data-aos="hero"
      data-aos-anchor="{{ animation_anchor }}"
      data-aos-order="{{ animation_order }}"
    >
      {%- if content_section_blocks.size != 0 -%}
        <div class="swiper">
          <swiper-container
            loop="false"
            slides-per-view="1.6"
            grab-cursor="true"
            navigation="true"
            navigation-prev-el=".{{ section.id }}--button.swiper-button-prev"
            navigation-next-el=".{{ section.id }}--button.swiper-button-next"
            breakpoints='{"480": {"slidesPerView": 2.4}, "750": {"slidesPerView": {{ videos_per_row_tablet }}}, "990": {"slidesPerView": {{ videos_per_row }}}}'
          >
            {%- for block in content_section_blocks -%}
              {%- liquid
                assign product_list = block.settings.products
                assign video = block.settings.video
                assign popup_id = section.id | append: '-popup-' | append: forloop.index
                assign popup_prev_id = null
                assign popup_next_id = null

                unless forloop.first
                  assign prev_index = forloop.index | minus: 1
                  assign popup_prev_id = section.id | append: '-popup-' | append: prev_index
                endunless

                unless forloop.last
                  assign next_index = forloop.index | plus: 1
                  assign popup_next_id = section.id | append: '-popup-' | append: next_index
                endunless

                assign video_card_poster_sizes = '(min-width: 990px) calc(100vw / ' | append: videos_per_row | append: '), (min-width: 750px) calc(100vw / ' | append: videos_per_row_tablet | append: '), (min-width: 480px) calc(100vw / 2.4), calc(100vw / 1.6)'
                assign video_modal_poster_sizes = '(min-width: 750px) 340px, calc(100vw - 32px)'

                capture video_card_poster
                  render 'image', sizes: video_card_poster_sizes, image: video.preview_image, alt: video.alt, aspect_ratio: aspect_ratio, aspect_ratio_mobile: aspect_ratio, placeholder: 'product-1'
                endcapture

                capture video_modal_poster
                  render 'image', sizes: video_modal_poster_sizes, image: video.preview_image, alt: video.alt, aspect_ratio: aspect_ratio, aspect_ratio_mobile: aspect_ratio, placeholder: 'product-1'
                endcapture
              -%}

              <swiper-slide
                class="social-video__item"
                data-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                <popup-component
                  id="{{ popup_id }}"
                  class="social-video__modal{% if product_list == empty and request.design_mode == false %} social-video__modal--video-only{% endif %}"
                >
                  <button
                    class="social-video__button"
                    type="button"
                    data-popup-open
                  >
                    {{- video_card_poster -}}
                    {%- render 'icon', name: 'play' -%}
                  </button>

                  <dialog class="dialog modal__overlay" aria-hidden="true" inert data-scroll-lock-required>
                    <form method="dialog">
                      <button class="visually-hidden" aria-label="{{ close_label }}"></button>
                    </form>

                    <button
                      type="button"
                      class="modal__close modal__nav-button desktop"
                      data-popup-close
                      aria-label="{{ close_label }}"
                    >
                      {%- render 'icon', name: 'x' -%}
                    </button>

                    <div class="modal__body">
                      <button
                        type="button"
                        class="modal__close modal__nav-button mobile"
                        data-popup-close
                        aria-label="{{ close_label }}"
                      >
                        {%- render 'icon', name: 'x' -%}
                      </button>

                      <button
                        type="button"
                        class="modal__prev modal__nav-button desktop"
                        data-popup-prev="{{ popup_prev_id }}"
                        aria-label="{{ 'general.pagination.prev' | t }}"
                        {% if forloop.first %}
                          disabled
                        {% endif %}
                      >
                        {%- render 'icon', name: 'caret-left' -%}
                      </button>

                      <button
                        type="button"
                        class="modal__next modal__nav-button desktop"
                        data-popup-next="{{ popup_next_id }}"
                        {% if forloop.last %}
                          disabled
                        {% endif %}
                        aria-label="{{ 'general.pagination.next' | t }}"
                      >
                        {%- render 'icon', name: 'caret-right' -%}
                      </button>
                      <div
                        class="modal__inner grid{% if product_list == empty and request.design_mode == false %} grid--1{% else %} grid--2{% endif %}"
                        data-scroll-lock-scrollable
                      >
                        <div class="social-video__media">
                          {%- if video != null -%}
                            <script src="{{ 'video-background.js' | asset_url }}" defer="defer"></script>

                            <div
                              class="video-background image-height image-height--mobile"
                              style="--aspect-ratio: {{ aspect_ratio }};"
                            >
                              <div class="video__poster">
                                {{ video_modal_poster }}
                              </div>

                              <video-background
                                class="video__player is-loading"
                                data-video-player
                                data-video-id="{{ section.id }}-video-background"
                              >
                                <template data-video-template>
                                  {{
                                    video
                                    | video_tag:
                                      autoplay: true,
                                      image_size: '1085x',
                                      loop: true,
                                      muted: true,
                                      controls: false
                                  }}

                                  <div class="social-video__button" data-video-hover-pause>
                                    {%- render 'icon', name: 'pause' -%}
                                  </div>
                                </template>
                              </video-background>
                            </div>
                          {%- else -%}
                            <div
                              class="video-background image-height image-height--mobile"
                              style="--aspect-ratio: {{ aspect_ratio }};"
                            >
                              <iframe
                                class="social-video__onboarding-video"
                                src="https://www.youtube.com/embed/_9VUPq3SxOc?autoplay=1&mute=1&loop=1&playlist=_9VUPq3SxOc&controls=0&playsinline=1"
                                allow="autoplay; encrypted-media"
                                allowfullscreen
                                loading="lazy"
                                frameborder="0"
                              ></iframe>
                            </div>
                          {%- endif -%}
                        </div>

                        {%- if product_list != empty -%}
                          <div class="social-video__products" data-scroll-lock-scrollable>
                            {%- if popup_text != blank -%}
                              <div class="modal__heading subheading text-center {{ section.settings.popup_text_font_size }}">
                                {{ popup_text }}
                              </div>
                            {%- endif -%}

                            {%- for product_item in product_list -%}
                              {% render 'product-card', product: product_item %}
                            {%- endfor -%}
                          </div>
                        {%- elsif request.design_mode -%}
                          <div class="social-video__products" data-scroll-lock-scrollable>
                            {%- if popup_text != blank -%}
                              <div class="modal__heading subheading text-center {{ section.settings.popup_text_font_size }}">
                                {{ popup_text }}
                              </div>
                            {%- endif -%}

                            {%- for i in (1..3) -%}
                              {% render 'product-card', product: null, index: i %}
                            {%- endfor -%}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  </dialog>
                </popup-component>
              </swiper-slide>
            {%- endfor -%}
          </swiper-container>

          <button
            type="button"
            class="{{ section.id }}--button swiper-button-prev"
            aria-label="{{ 'general.accessibility.previous_slide' | t }}"
          >
            {%- render 'icon', name: 'caret-left' -%}
          </button>
          <button
            type="button"
            class="{{ section.id }}--button swiper-button-next"
            aria-label="{{ 'general.accessibility.next_slide' | t }}"
          >
            {%- render 'icon', name: 'caret-right' -%}
          </button>
        </div>
      {%- else -%}
        {%- render 'no-blocks' -%}
      {%- endif -%}
    </div>
  </div>
  {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
  {%- render 'shape-dividers', mode: 'host' -%}
</div>

