{%- doc -%}
  Renders horizontal product upsell block with slider functionality for Cart page and Cart drawer
  Supports both fixed product list and AI-powered recommendations

  @param {object} block - Block object (required)

  @example
  {% render 'cart-block-horizontal-upsell', block: block %}
{%- enddoc -%}

{%- liquid
  assign recommendation_type = block.settings.recommendation_type | default: 'fixed'
  assign is_ai_recommendations = false
  assign ai_intent = 'related'

  if recommendation_type == 'ai' or recommendation_type == 'ai_complementary'
    assign is_ai_recommendations = true
    if recommendation_type == 'ai_complementary'
      assign ai_intent = 'complementary'
    endif
  endif

  assign product_count = block.settings.product_list.count
  assign ai_limit = block.settings.ai_limit | default: 4
  assign show_slider = false
  assign onboarding_count = 6
  assign is_onboarding = false

  comment
    For AI recommendations, we always show slider and render empty initially
    Products are loaded dynamically via JavaScript
  endcomment
  if is_ai_recommendations
    assign show_slider = true
  elsif product_count == 0 and request.design_mode
    assign is_onboarding = true
    assign show_slider = true
  elsif product_count > 1
    assign show_slider = true
  endif

  assign color_scheme = 'color-' | append: block.settings.color_scheme
-%}

{%- unless is_ai_recommendations -%}
  {%- capture product_list -%}
    {%- if is_onboarding -%}
      {%- comment -%} Render onboarding products {%- endcomment -%}
      {%- for i in (1..onboarding_count) -%}
        <swiper-slide>
          {%- render 'upsell-product',
            upsell_product: blank,
            unique_id: block.id,
            button_type: block.settings.button_type,
            button_size: block.settings.button_size,
            button_style: block.settings.button_style,
            is_compact: true,
            instant_add: true,
            onboarding: true
          -%}
        </swiper-slide>
      {%- endfor -%}
    {%- else -%}
      {%- for product in block.settings.product_list limit: 6 -%}
        {%- capture upsell_product -%}
          {%- render 'upsell-product',
            upsell_product: product,
            unique_id: block.id,
            button_type: block.settings.button_type,
            button_size: block.settings.button_size,
            button_style: block.settings.button_style,
            is_compact: true,
            instant_add: true,
            show_available_upsell_only: true
          -%}
        {%- endcapture -%}

        {%- if upsell_product != blank -%}
          {%- if show_slider -%}
            <swiper-slide>
              {{- upsell_product -}}
            </swiper-slide>
          {%- else -%}
            {{- upsell_product -}}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}
{%- endunless -%}

{%- liquid
  assign should_render = false
  if is_ai_recommendations
    assign should_render = true
  elsif request.design_mode
    assign should_render = true
  elsif product_count > 0 and product_list != blank
    assign should_render = true
  elsif is_onboarding
    assign should_render = true
  endif
-%}

{%- if should_render -%}
  {%- if is_ai_recommendations -%}
    <script src="{{ 'cart-upsell-recommendations.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <div class="cart__widget cart__widget--upsell cart__widget--upsell-horizontal {{ color_scheme }}{% if is_ai_recommendations %} cart__widget--ai-recommendations{% endif %}">
    {%- if block.settings.title != blank or show_slider -%}
      <div class="cart__widget__title subheading">
        {% if block.settings.title != blank %}
          <span>{{ block.settings.title }}</span>
        {% endif %}

        {%- if show_slider -%}
          <div class="swiper-navigation-static">
            <button
              type="button"
              class="{{ block.id }}--button swiper-button-prev"
              aria-label="{{ 'general.accessibility.previous_slide' | t }}"
            >
              {%- render 'icon', name: 'caret-left' -%}
            </button>
            <button
              type="button"
              class="{{ block.id }}--button swiper-button-next"
              aria-label="{{ 'general.accessibility.next_slide' | t }}"
            >
              {%- render 'icon', name: 'caret-right' -%}
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cart__widget__content">
      {%- if is_ai_recommendations -%}
        <cart-upsell-recommendations
          class="cart__widget__content__inner{% if cart.item_count == 0 %} is-hidden{% endif %}"
          data-block-id="{{ block.id }}"
          data-limit="{{ ai_limit }}"
          data-intent="{{ ai_intent }}"
          data-button-classes="{{ block.settings.button_size }} {{ block.settings.button_type }} {{ block.settings.button_style }}"
          data-upsell-style="horizontal"
          data-has-slider
          data-recommendations-container
        >
          <div class="swiper">
            <swiper-container
              class="swiper-wrapper"
              loop="false"
              grab-cursor="true"
              autoplay="false"
              space-between="10px"
              {%- if template.name == 'cart' -%}
                slides-per-view="1.001"
              {%- else -%}
                breakpoints='{"320": {"slidesPerView": 1.001},"990": {"slidesPerView": 1.75}}'
              {%- endif -%}
              navigation="true"
              navigation-prev-el=".{{ block.id }}--button.swiper-button-prev"
              navigation-next-el=".{{ block.id }}--button.swiper-button-next"
            >
              {%- comment -%} Products loaded dynamically via JavaScript {%- endcomment -%}
            </swiper-container>
          </div>
        </cart-upsell-recommendations>
      {%- else -%}
        {%- comment -%} Fixed product list {%- endcomment -%}
        <upsell-block
          class="cart__widget__content__inner"
          data-upsell-block-id="{{ block.id }}"
          {%- if show_slider -%}
            data-upsell-has-slider="true"
          {%- endif -%}
        >
          {%- if show_slider -%}
            <div class="swiper">
              <swiper-container
                class="swiper-wrapper"
                loop="false"
                grab-cursor="true"
                autoplay="false"
                space-between="10px"
                {%- if template.name == 'cart' -%}
                  slides-per-view="1.001"
                {%- else -%}
                  breakpoints='{"320": {"slidesPerView": 1.001},"990": {"slidesPerView": 1.75}}'
                {%- endif -%}
                {%- if show_slider %}
                  navigation="true"
                  navigation-prev-el=".{{ block.id }}--button.swiper-button-prev"
                  navigation-next-el=".{{ block.id }}--button.swiper-button-next"
                {% endif -%}
              >
                {{- product_list -}}
              </swiper-container>
            </div>
          {%- else -%}
            {{- product_list -}}
          {%- endif -%}
        </upsell-block>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
