{% comment %}
  Renders header with predefined styles and settings.

  Accepts:
  - header_style: {String} Header style (required)
  - is_floating: {Boolean} Enable floating card layout (optional)
  - announcement_html: {String} Pre-rendered announcement block HTML
  - toolbar_html: {String} Pre-rendered toolbar block HTML
  - menu_block_html: {String} Pre-rendered menu block HTML

  Usage:
  {% render 'header', header_style: 'logo_beside', announcement_html: announcement_html, toolbar_html: toolbar_html, menu_block_html: menu_block_html %}
{% endcomment %}

{%- liquid
  assign animation_name = 'drawer-items-fade'
  assign animation_delay = 0
  assign animation_delay_increment = 50

  assign header_style = header_style | default: 'logo_beside'
  assign is_floating = is_floating | default: false

  assign has_toolbar = false
  assign show_toolbar_socials = false
  assign show_toolbar_gift_card = false
  if toolbar_html != blank
    assign has_toolbar = true
    if toolbar_html contains 'data-meta-socials'
      assign show_toolbar_socials = true
    endif
    if toolbar_html contains 'data-meta-gift-card'
      assign show_toolbar_gift_card = true
    endif
  endif
  assign show_separator_line = section.settings.show_separator_line
  assign show_socials = false

  assign padding_top = section.settings.padding_top
  assign padding_top_medium = padding_top | times: 0.8
  assign padding_top_mobile = padding_top | times: 0.6
  assign padding_bottom = section.settings.padding_bottom
  assign padding_bottom_medium = padding_bottom | times: 0.8
  assign padding_bottom_mobile = padding_bottom | times: 0.6

  assign menu_height_default = 47
  assign menu_height_medium_default = 42
  assign menu_height_mobile_default = 42
  assign header_icons_height = 34
  assign toolbar_height = 0

  assign transparent_header = false
  if template contains 'collection' and section.settings.transparent_collection
    assign transparent_header = true
  elsif template contains 'article' and section.settings.transparent_article
    assign transparent_header = true
  elsif template == 'index' and section.settings.transparent_home
    assign transparent_header = true
  elsif template.name == 'page' and section.settings.transparent_page
    assign transparent_header = true
  elsif template.name == 'product' and section.settings.transparent_product_page
    assign transparent_header = true
  endif

  assign logo = section.settings.logo
  assign transparent_logo = section.settings.transparent_logo

  if template.name == 'product' and section.settings.transparent_product_page
    assign transparent_logo = section.settings.transparent_logo_pdp
  endif

  if transparent_logo != blank and logo == blank
    assign logo = transparent_logo
  endif

  assign logo_width = section.settings.logo_max_limit
  assign logo_width_15x = logo_width | times: 1.5 | round
  assign logo_width_2x = logo_width | times: 2 | round
  assign logo_width_mobile = section.settings.logo_max_limit_mobile
  assign logo_width_mobile_15x = logo_width_mobile | times: 1.5 | round
  assign logo_width_mobile_2x = logo_width_mobile | times: 2 | round
  assign logo_sizes = '(min-width: 750px) ' | append: logo_width | append: 'px, (min-width: ' | append: logo_width_mobile_2x | append: 'px) ' | append: logo_width_mobile | append: 'px, calc((100vw - 64px) * 0.5)'
  assign logo_widths = logo_width | append: ',' | append: logo_width_15x | append: ',' | append: logo_width_2x | append: ',' | append: logo_width_mobile | append: ',' | append: logo_width_mobile_15x | append: ',' | append: logo_width_mobile_2x

  if logo != blank
    assign logo_denom = logo.aspect_ratio | default: 1
    assign logo_height = logo_width | divided_by: logo_denom
    assign logo_height_mobile = logo_width_mobile | divided_by: logo_denom
    assign menu_height = logo_height | at_least: menu_height_default
    assign menu_height_medium = logo_height | at_least: menu_height_medium_default
    assign menu_height_mobile = logo_height_mobile | at_least: menu_height_mobile_default
    assign header_height = menu_height | floor | plus: padding_top | plus: padding_bottom
    assign header_height_medium = menu_height_medium | floor | plus: padding_top_medium | plus: padding_bottom_medium
    assign header_height_mobile = menu_height_mobile | floor | plus: padding_top_mobile | plus: padding_bottom_mobile
    assign logo_padding = 1 | divided_by: logo_denom | times: 100 | append: '%'
  else
    assign header_height = menu_height_default | plus: padding_top | plus: padding_bottom
    assign header_height_medium = menu_height_medium_default | plus: padding_top_medium | plus: padding_bottom_medium
    assign header_height_mobile = menu_height_mobile_default | plus: padding_top_mobile | plus: padding_bottom_mobile
    assign logo_width = 'auto'
  endif

  if header_style contains 'logo_above'
    assign header_upper_height = logo_height | at_least: header_icons_height
    assign header_upper_height_mobile = logo_height_mobile | at_least: menu_height_mobile_default
    assign header_height = header_upper_height | plus: menu_height_default | plus: padding_top | plus: padding_bottom
    assign header_height_medium = header_upper_height | plus: padding_top_medium | plus: padding_bottom_medium
    assign header_height_mobile = header_upper_height_mobile | plus: padding_top_mobile | plus: padding_bottom_mobile
  endif

  assign header_card_height = header_height
  assign header_card_height_medium = header_height_medium
  assign header_card_height_mobile = header_height_mobile

  if has_toolbar
    assign toolbar_height = 2.25 | times: settings.nav_font_size

    assign header_height = header_height | plus: toolbar_height
    assign header_height_medium = header_height_medium | plus: toolbar_height
    assign header_height_mobile = header_height_mobile | plus: toolbar_height
  endif

  assign cart_item_count = cart.item_count
  assign cart_icon_as_circle = section.settings.icon_as_circle

  if cart_item_count > 9
    assign cart_item_count = '9+'
  endif

  assign show_icons = section.settings.show_icons

  capture navlink_cart_classes
    echo 'navlink--cart'

    if cart_icon_as_circle
      echo ' navlink--cart--circle'
    endif

    if cart_icon_as_circle == false and show_icons
      echo ' navlink--cart--icon'
    elsif cart_icon_as_circle == false and show_icons == false
      echo ' navlink--cart--text'
    endif

    if show_icons == false
      echo ' navlink--toplevel'
    endif
  endcapture
-%}

{%- if section.settings.show_social_icons -%}
  {%- if settings.instagram_link != ''
    or settings.pinterest_link != ''
    or settings.facebook_link != ''
    or settings.x_link != ''
    or settings.youtube_link != ''
    or settings.tiktok_link != ''
    or settings.linkedin_link != ''
    or settings.snapchat_link != ''
  -%}
    {%- assign show_socials = true -%}
  {%- endif -%}
{%- endif -%}

{%- style -%}
  :root {
    --HEADER-HEIGHT: {{ header_height }}px;
    --HEADER-HEIGHT-MEDIUM: {{ header_height_medium }}px;
    --HEADER-HEIGHT-MOBILE: {{ header_height_mobile }}px;
    --HEADER-CARD-HEIGHT: {{ header_card_height }}px;
    --HEADER-CARD-HEIGHT-MEDIUM: {{ header_card_height_medium }}px;
    --HEADER-CARD-HEIGHT-MOBILE: {{ header_card_height_mobile }}px;

    {% comment %} --icon-bag variable is used on PGI and Product upsell block {% endcomment %}
    --icon-bag: var(--ICON-BAG);

    {%- if is_floating -%}
      --floating-inset: var(--outer);
      --floating-radius: var(--RADIUS, 0px);
      --floating-top: var(--LAYOUT-GAP-SMALL);
      --floating-gap: calc(var(--LAYOUT-GAP-SMALL) / 2);
    {%- endif -%}
  }

  {%- if show_separator_line -%}
    .page-header {
      --header-border-opacity: {{ section.settings.separator_opacity | times: 0.01 }};
      --header-border: inset 0 0 0 var(--BORDER-THICKNESS) color-mix(in srgb, var(--link) calc(var(--header-border-opacity, 1) * 100%), transparent);
    }

    {%- unless is_floating -%}
      .toolbar::before,
      .theme__header::before {
        content: "";
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 10;
        pointer-events: none;
        transition: border-color 0.2s ease;
        border-bottom: var(--BORDER-THICKNESS) solid var(--link);
        opacity: var(--header-border-opacity, 1);
      }
    {%- endunless -%}
  {%- else -%}
    .page-header {
      --header-border: none;
    }
  {%- endif -%}

  .theme__header {
    --PT: {{ padding_top }}px;
    --PB: {{ padding_bottom }}px;
  }

  {%- if logo != blank -%}
    .header__logo__link {
      --logo-padding: {{ logo_padding }};
      --logo-width-desktop: {{ logo_width }}px;
      --logo-width-mobile: {{ logo_width_mobile }}px;
    }
  {%- endif -%}

  {%- unless transparent_header -%}
    .main-content > .shopify-section:first-of-type .backdrop--linear:before { display: none; }
  {%- endunless -%}
{%- endstyle -%}

{%- capture logos -%}
  {%- if transparent_header and transparent_logo != blank and logo != blank -%}
    {%- assign has_transparent_logo = true -%}
  {%- endif -%}
  <div class="header__logo{% if logo %} header__logo--image{% endif %}{% if has_transparent_logo %} header__logo--has-transparent{% endif %}">
    <a class="header__logo__link" href="{{ routes.root_url }}" data-logo-link>
      {%- if logo != blank -%}
        {%- liquid
          assign alt = logo.alt | default: shop.name | strip_html | escape
          render 'image' image: logo, width: logo_width_2x, sizes: logo_sizes, widths: logo_widths, aspect_ratio: logo_denom, alt: alt, modifier: 'logo__img logo__img--color', loading: 'eager', fetchpriority: 'auto', show_backfill: false
        -%}
      {%- else -%}
        {%- liquid
          assign wordmark = section.settings.wordmark_text | default: shop.name
          assign classes = ''
          assign title_length = wordmark | size
          assign oneword = true
          if wordmark contains ' ' or wordmark contains '-'
            assign oneword = false
          endif
          if title_length > 15
            assign classes = classes | append: ' header__logo__text--long'
            if oneword
              assign classes = classes | append: ' header__logo__text--break'
            endif
          endif
        -%}
        <div class="header__logo__text {{ classes }}">
          <span>{{ wordmark | escape }}</span>
        </div>
      {%- endif -%}

      {%- liquid
        if has_transparent_logo
          assign alt = transparent_logo.alt | default: shop.name | strip_html | escape
          render 'image' image: transparent_logo, width: logo_width_2x, sizes: logo_sizes, widths: logo_widths, aspect_ratio: transparent_logo.aspect_ratio, alt: alt, modifier: 'logo__img logo__img--transparent', loading: 'eager', fetchpriority: 'auto', show_backfill: false
        endif
      -%}
    </a>
  </div>
{%- endcapture -%}

{%- capture cart_status -%}
  <div class="navlink__cart__content">
    <span class="{% if show_icons == false %}navtext{% else %}visually-hidden{% endif %}">{{ 'layout.header.cart' | t }}</span>

    <span class="header__cart__status__holder">
      <cart-count class="header__cart__status{% if show_icons == false %} navtext{% endif %}" data-status-separator=": " data-cart-count="{{ cart.item_count }}" data-limit="10">
        {{ cart_item_count }}
      </cart-count>

      {%- if cart_icon_as_circle -%}
        {%- render 'icon', name: 'circle' -%}
      {%- else -%}
        {%- render 'icon', name: 'shopping-bag' -%}
      {%- endif -%}
    </span>
  </div>
{%- endcapture -%}

{%- liquid
  assign languages = false
  assign languages_toolbar = false
  assign countries = false
  assign countries_toolbar = false
  assign header_popouts = false
  assign header_popouts_mobile = false

  assign show_locale_selector = section.settings.show_locale_selector
  assign show_country_selector = section.settings.show_country_selector
  assign show_country_name = section.settings.show_country_name
  assign show_country_flag = section.settings.show_country_flag

  assign show_locale_selector_toolbar = false
  assign show_country_selector_toolbar = false
  assign show_country_name_toolbar = false
  assign show_country_flag_toolbar = false

  if toolbar_html contains 'data-meta-locale'
    assign show_locale_selector_toolbar = true
  endif
  if toolbar_html contains 'data-meta-country'
    assign show_country_selector_toolbar = true
  endif
  if toolbar_html contains 'data-meta-country-name'
    assign show_country_name_toolbar = true
  endif
  if toolbar_html contains 'data-meta-country-flag'
    assign show_country_flag_toolbar = true
  endif

  if show_locale_selector and localization.available_languages.size > 1
    assign languages = true
  endif

  if show_locale_selector_toolbar and localization.available_languages.size > 1
    assign languages_toolbar = true
  endif

  if show_country_selector and localization.available_countries.size > 1
    assign countries = true
  endif

  if show_country_selector_toolbar and localization.available_countries.size > 1
    assign countries_toolbar = true
  endif

  if languages or countries
    assign header_popouts = true
  endif

  if languages or languages_toolbar or countries or countries_toolbar
    assign header_popouts_mobile = true
  endif
-%}

{%- capture minimal -%}
  <div class="header__mobile__left">
    <div class="header__mobile__button">
      <button class="header__mobile__hamburger{% if show_icons == false %} navlink navlink--toplevel{% endif %}{% if settings.type_nav_caps %} caps{% endif %}"
        data-drawer-toggle="hamburger"
        aria-label="{{ 'general.accessibility.show_menu' | t }}"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="header-menu">

        {%- if show_icons == false -%}
          <small class="navtext">{{ 'layout.header.menu' | t }}</small>
        {%- endif -%}

        {%- render 'icon', name: 'list' -%}
      </button>
    </div>

    {%- if section.settings.enable_search -%}
      <div class="header__mobile__button">
        <header-search-popdown data-easing="cubic-bezier(0.2, 0, 0, 1)" data-duration="400">
          <details>
            <summary class="navlink navlink--search{% if show_icons == false %} navlink--toplevel{% endif %}{% if settings.type_nav_caps %} caps{% endif %}" aria-haspopup="dialog" title="{{ 'general.search.search' | t }}">
              <span data-search-popdown-trigger-icon>
                {%- render 'icon', name: 'magnifying-glass' -%}
              </span>
              {%- render 'icon', name: 'x' -%}
              <span
                class="{% if show_icons == false %}navtext{% else %}visually-hidden{% endif %}"
                {% if show_icons == false %}
                  data-search-popdown-trigger-text
                {% endif %}
              >
                {{- 'layout.header.search' | t -}}
              </span>
            </summary>

            {%- render 'header-search-popdown', unique: 'mobile' -%}

            <span class="underlay" data-popdown-underlay></span>
          </details>
        </header-search-popdown>
      </div>
    {%- endif -%}
  </div>

  {{ logos }}

  <div class="header__mobile__right{% if settings.type_nav_caps %} caps{% endif %}">
    {%- if header_popouts -%}
      {%- assign unique = section.id | append: '-header-mobile-top' -%}
      <div class="header__mobile__button desktop">
        {%- render 'localization' unique: unique, show_locale_selector: show_locale_selector, show_country_selector: show_country_selector, show_country_flag: show_country_flag, show_country_name: show_country_name, class: 'header', unique: section.id, short_country_name: true -%}
      </div>
    {%- endif -%}

    {%- if shop.customer_accounts_enabled -%}
      <div class="header__mobile__button">
        <a href="{{ routes.account_url }}" class="navlink{% if show_icons == false %} navlink--toplevel{% endif %}">
          {%- render 'icon', name: 'user' -%}
          <span class="{% if show_icons == false %}navtext{% else %}visually-hidden{% endif %}">{{ 'layout.header.account' | t }}</span>
        </a>
      </div>
    {%- endif -%}
    <div class="header__mobile__button">
      <a href="{{ routes.cart_url }}" class="navlink {{ navlink_cart_classes }}" data-cart-toggle>
        {{ cart_status }}
      </a>
    </div>
  </div>
{%- endcapture -%}

{%- capture buttons -%}
  <div class="header__desktop__buttons{% if show_icons == false %} header__desktop__buttons--text{% else %} header__desktop__buttons--icons{% endif %}{% if settings.type_nav_caps %} caps{% endif %}">
    {%- if header_style != 'logo_above' -%}
      {%- if show_socials  -%}
        <div class="header__desktop__button">
          {%- render 'social-icons' -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if header_popouts -%}
      {%- assign unique = section.id | append: '-header-desktop' -%}

      <div class="header__desktop__button">
        {%- render 'localization' unique: unique, show_locale_selector: show_locale_selector, show_country_selector: show_country_selector, show_country_flag: show_country_flag, show_country_name: show_country_name, class: 'header', short_country_name: true -%}
      </div>
    {%- endif -%}

    {%- if shop.customer_accounts_enabled -%}
      <div class="header__desktop__button">
        <a href="{{ routes.account_url }}" class="navlink{% if show_icons == false %} navlink--toplevel{% endif %}" title="{{ 'customer.account.title' | t }}">
          {%- render 'icon', name: 'user' -%}
          <span class="{% if show_icons == false %}navtext{% else %}visually-hidden{% endif %}">{{ 'layout.header.account' | t }}</span>
        </a>
      </div>
    {%- endif -%}

    {%- if section.settings.enable_search -%}
      <div class="header__desktop__button">
        <header-search-popdown data-easing="cubic-bezier(0.2, 0, 0, 1)" data-duration="400">
          <details>
            <summary class="navlink navlink--search{% if show_icons == false %} navlink--toplevel{% endif %}" aria-haspopup="dialog" title="{{ 'general.search.search' | t }}">
              <span data-search-popdown-trigger-icon>
                {%- render 'icon', name: 'magnifying-glass' -%}
              </span>
              {%- render 'icon', name: 'x' -%}
              <span
                class="{% if show_icons == false %}navtext{% else %}visually-hidden{% endif %}"
                {% if show_icons == false %}
                  data-search-popdown-trigger-text
                {% endif %}
              >
                {{- 'layout.header.search' | t -}}
              </span>
            </summary>

            {%- render 'header-search-popdown', unique: 'desktop' -%}

            <span class="underlay" data-popdown-underlay></span>
          </details>
        </header-search-popdown>
      </div>
    {%- endif -%}

    <div class="header__desktop__button">
      <a href="{{ routes.cart_url }}" class="navlink {{ navlink_cart_classes }}" title="{{ 'cart.general.title' | t }}" data-cart-toggle>
        {{ cart_status }}
      </a>
    </div>
  </div>
{%- endcapture -%}

{%- assign drawer_nav_html = '' -%}
{%- assign drawer_parts = menu_block_html | split: '<menu-data data-meta-drawer-nav style="display:none">' -%}
{%- if drawer_parts.size > 1 -%}
  {%- assign drawer_nav_html = drawer_parts[1] | split: '</menu-data>' | first -%}
  {%- assign menu_html = drawer_parts[0] -%}
{%- else -%}
  {%- assign menu_html = menu_block_html -%}
{%- endif -%}

{%- assign toolbar_menu = '' -%}
{%- assign show_toolbar_menu = false -%}
{%- assign toolbar_menu_parts = toolbar_html | split: '<toolbar-data data-meta-menu style="display:none">' -%}
{%- if toolbar_menu_parts.size > 1 -%}
  {%- assign toolbar_menu = toolbar_menu_parts[1] | split: '</toolbar-data>' | first -%}
  {%- assign show_toolbar_menu = true -%}
  {%- assign toolbar_after_menu = toolbar_menu_parts[1] | split: '</toolbar-data>' | last -%}
  {%- assign toolbar_html = toolbar_menu_parts[0] | append: toolbar_after_menu -%}
{%- endif -%}

{%- capture gift_card_link -%}
  {%- if show_toolbar_gift_card -%}
    <div class="toolbar__utility">
      <a class="gift-card-link" href="{{ routes.root_url }}products/{{ 'layout.header.gift_card_url' | t }}">{{ 'layout.header.gift_card' | t }}</a>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture drawer -%}
  <header-drawer class="drawer drawer--header{% if settings.type_nav_caps %} caps{% endif %}"
    data-drawer="hamburger"
    id="header-menu">
    <div class="drawer__inner" data-drawer-inner>
      <div class="drawer__head">
        <button class="drawer__close"
          data-drawer-close
          aria-label="{{ 'general.accessibility.show_menu' | t }}"
          aria-haspopup="true"
          aria-expanded="true"
          aria-controls="header-menu">

          {%- render 'icon', name: 'x' -%}
        </button>
      </div>

      <div class="drawer__body">
        <div class="drawer__content" data-drawer-content>
          <div class="drawer__content__scroll" data-scroll-lock-scrollable>
            <nav class="drawer__menu" data-scroll-lock-scrollable data-sliderule-pane="0">
              <div class="drawer__main-menu">
                {{ drawer_nav_html }}
              </div>
            </nav>
          </div>
        </div>

        {%- if show_toolbar_menu or header_popouts_mobile or show_toolbar_gift_card or show_socials -%}

          <div class="drawer__bottom{% unless show_socials %} mobile{% endunless %}">
            {%- if show_toolbar_menu -%}
              {%- assign animation_delay = item_animation_delay | plus: animation_delay_increment -%}
              <div class="drawer__bottom__row drawer__bottom__row--menu mobile"
                data-animation="{{ animation_name }}"
                data-animation-delay="{{ animation_delay }}"
              >
                <div class="toolbar__menu">
                  {{ toolbar_menu }}
                </div>
              </div>
            {%- endif -%}

            {%- if header_popouts_mobile or show_toolbar_gift_card -%}
              {%- liquid
                assign animation_delay = animation_delay | plus: animation_delay_increment
                assign unique = section.id | append: '-header-mobile'
              -%}

              <div class="drawer__bottom__row drawer__bottom__row--localization-gift"
                data-animation="{{ animation_name }}"
                data-animation-delay="{{ animation_delay }}"
              >
                {%- if header_popouts_mobile -%}
                  {%- liquid
                    assign drawer_show_locale = show_locale_selector | default: show_locale_selector_toolbar
                    assign drawer_show_country = show_country_selector | default: show_country_selector_toolbar
                    assign drawer_show_country_flag = show_country_flag | default: show_country_flag_toolbar
                    assign drawer_show_country_name = show_country_name | default: show_country_name_toolbar
                  -%}
                  {%- render 'localization' unique: unique, show_locale_selector: drawer_show_locale, show_country_selector: drawer_show_country, show_country_flag: drawer_show_country_flag, show_country_name: drawer_show_country_name, class: 'header', short_country_name: true -%}
                {%- endif -%}

                {%- if show_toolbar_gift_card -%}
                  {{ gift_card_link }}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if show_socials or show_toolbar_socials -%}
              {%- assign animation_delay = animation_delay | plus: animation_delay_increment -%}
              <div class="drawer__bottom__row drawer__bottom__row--socials"
                data-animation="{{ animation_name }}"
                data-animation-delay="{{ animation_delay }}"
              >
                {%- render 'social-icons' -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <span class="underlay drawer__underlay" data-drawer-underlay></span>
  </header-drawer>
{%- endcapture -%}

{%- render 'stylesheet', name: 'header-dropdown.css', async: true -%}

{%- if section.settings.enable_search -%}
  <script src="{{ 'header-search-popdown.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if has_toolbar -%}
  <script src="{{ 'ticker.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if announcement_html != blank -%}
  {{ announcement_html }}
{%- endif -%}

<header-component
  class="header__wrapper{% if is_floating %} header-floating{% endif %}"
  data-header-wrapper
  {% if transparent_header %}
    data-header-transparent
  {% endif %}
  {% if section.settings.header_sticky %}
    data-header-sticky
  {% endif %}
  {% if is_floating %}
    data-header-floating
  {% endif %}
  data-header-style="{{ header_style }}"
  data-section-id="{{ section.id }}"
  data-section-type="header"
>
  <header
    class="theme__header"
    role="banner"
    data-header-height
  >
    {%- if toolbar_html != blank -%}
      {{ toolbar_html }}
    {%- endif -%}

    <div class="section-padding{% if is_floating %} header-floating__card{% endif %}">
      <div class="header__mobile header__padded">
        {{ minimal }}
      </div>

      <div class="header__desktop" data-header-desktop>
        {%- case header_style -%}
          {%- when 'logo_beside' -%}
            <div class="header__desktop__upper header__padded" data-takes-space-wrapper>
              <div data-child-takes-space class="header__desktop__bar__l">{{ logos }}</div>

              <div data-child-takes-space class="header__desktop__bar__c">{{ menu_html }}</div>

              <div data-child-takes-space class="header__desktop__bar__r">{{ buttons }}</div>
            </div>
          {%- when 'logo_center_menu_left' -%}
            <div class="header__desktop__upper header__desktop__upper--reverse header__padded" data-takes-space-wrapper>
              <div data-child-takes-space class="header__desktop__bar__l">{{ logos }}</div>

              <div data-child-takes-space class="header__desktop__bar__c">{{ menu_html }}</div>

              <div data-child-takes-space class="header__desktop__bar__r">{{ buttons }}</div>
            </div>
          {%- when 'drawer' -%}
            {%- comment -%} Do nothing for drawer {%- endcomment -%}
          {%- else -%}
            {%- comment -%} 'logo_above' is default case, this covers migrated settings {%- endcomment -%}
            <div class="header__desktop__upper header__padded" data-takes-space-wrapper>
              <div class="header__desktop__bar__l">
                {%- if show_socials -%}
                  <div data-child-takes-space>
                    {%- render 'social-icons' -%}
                  </div>
                {%- endif -%}
              </div>
              <div data-child-takes-space class="header__desktop__bar__c">{{ logos }}</div>

              <div class="header__desktop__bar__r">
                {%- if buttons != blank -%}
                  <div data-child-takes-space>
                    {{ buttons }}
                  </div>
                {%- endif -%}
              </div>
            </div>
            <div class="header__desktop__lower header__padded" data-takes-space-wrapper>
              <div data-child-takes-space class="header__desktop__bar__c">{{ menu_html }}</div>
            </div>
        {%- endcase -%}
      </div>
    </div>
  </header>

  {{ drawer }}
</header-component>

<div class="header__backfill" data-header-backfill></div>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if logo %}
      "logo": {{ logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.x_link | json }},
      {{ settings.facebook_link | json }},
      {{ settings.instagram_link | json }},
      {{ settings.pinterest_link | json }},
      {{ settings.youtube_link | json }},
      {{ settings.tiktok_link | json }},
      {{ settings.linkedin_link | json }},
      {{ settings.snapchat_link | json }}
    ],
    "url": {{ shop.url | append: page.url | json }}
  }
</script>

{%- if template.name == 'index' -%}
  {%- assign potential_action_target = shop.url | append: '/search?q={search_term_string}' -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ shop.url | append: page.url | json }}
    }
  </script>
{%- endif -%}

{%- if request.design_mode -%}
  <script>
    function handleHoverDisclosureEvent(event, type) {
      const hoverDisclosure = event.target.closest('hover-disclosure');
      if (!hoverDisclosure) return;
      if (type === 'select' && typeof hoverDisclosure.showDisclosure === 'function') {
        hoverDisclosure.showDisclosure(event);
      } else if (type === 'deselect' && typeof hoverDisclosure.hideDisclosure === 'function') {
        hoverDisclosure.hideDisclosure(event);
      }
    }

    {%- if has_toolbar -%}
      function handleTickerEvent(event, type) {
        const ticker = event.target.matches('ticker-bar')
          ? event.target
          : event.target.querySelector('ticker-bar') || event.target.closest('ticker-bar');
        if (!ticker) return;
        if (type === 'select') {
          ticker.setAttribute('paused', '');
        } else if (type === 'deselect') {
          ticker.removeAttribute('paused');
        }
      }
    {%- endif -%}

    document.addEventListener('shopify:block:select', (event) => {
      handleHoverDisclosureEvent(event, 'select');

      {%- if has_toolbar -%}
        handleTickerEvent(event, 'select');
      {%- endif -%}
    });
    document.addEventListener('shopify:block:deselect', (event) => {
      handleHoverDisclosureEvent(event, 'deselect');

      {%- if has_toolbar -%}
        handleTickerEvent(event, 'deselect');
      {%- endif -%}
    });
  </script>
{%- endif -%}
