<!-- /sections/section-hero.liquid -->
{%- liquid
  assign image = section.settings.image
  assign banner_link = section.settings.link
  assign section_width = section.settings.width
  assign desktop_height = section.settings.height
  assign flex_align_desktop = section.settings.flex_align_desktop
  assign mobile_image = section.settings.mobile_image
  assign mobile_height = section.settings.mobile_height
  assign flex_align_mobile = section.settings.flex_align_mobile
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign selected_color_scheme = section.settings.color_scheme | strip
  assign scheme_bg_color = settings.color_schemes[selected_color_scheme].settings.bg
  assign show_text_background = section.settings.show_text_background
  assign overlay_opacity = section.settings.overlay_opacity | times: 0.01
  assign show_overlay_text = section.settings.show_overlay_text
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
  assign show_placeholder = section.settings.show_placeholder
  assign upsell_product = section.settings.product
  assign content_block_count = section.blocks.size

  # Rendering conditions
  assign render_section = false
  assign render_image = true
  assign render_image_overlay = false
  assign render_metafield_info = false
  assign render_content_blocks = false

  if image != blank or mobile_image != blank or show_placeholder or request.design_mode
    assign render_section = true
  endif
  unless show_overlay_text or overlay_opacity == 0.0
    assign render_image_overlay = true
  endunless
  if image == blank and mobile_image == blank and show_placeholder == false
    assign render_image = false
    assign render_metafield_info = true
  endif
  if content_block_count != 0 and image != blank or mobile_image != blank or show_placeholder == true
    assign render_content_blocks = true
  endif

  capture sizes
    if section_width == 'wrapper--full'
      echo '100vw'
    else
      echo '(min-width: 990px) calc(100vw - 100px), (min-width: 750px) calc(100vw - 60px), calc(100vw - 32px)'
    endif
  endcapture

  capture sizes_mobile
    if section_width == 'wrapper--full'
      echo '100vw'
    else
      echo 'calc(100vw - 32px)'
    endif
  endcapture

  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  assign preload = false
  assign image_priority = false

  if template.name == 'index' and section.location == 'template' and section.index == 1
    assign image_priority = true
  elsif section.index < 3
    assign loading = 'eager'
  endif

  assign hero_transparent = true
  if show_text_background and scheme_bg_color.alpha != 0.0 or scheme_bg_color != blank
    assign hero_transparent = false
  endif

  assign show_header_backdrop = false
  if hero_transparent and show_overlay_text
    assign show_header_backdrop = true
  endif

  if upsell_product != blank
    assign upsell_position_primary = 'right'
    assign upsell_position_vertical = section.settings.product_desktop_alignment_vertical
    assign upsell_position_horizontal = section.settings.product_desktop_alignment_horizontal
    assign upsell_position_secondary = upsell_position_vertical
    assign upsell_animation_order = section.blocks.size | plus: 1

    if flex_align_desktop == 'align--top-right-desktop' or flex_align_desktop == 'align--middle-right-desktop' or flex_align_desktop == 'align--bottom-right-desktop'
      assign upsell_position_primary = 'left'
    endif

    if flex_align_desktop == 'align--top-center-desktop'
      assign upsell_position_primary = 'bottom'
    endif

    if flex_align_desktop == 'align--bottom-center-desktop'
      assign upsell_position_primary = 'top'
      assign upsell_animation_order = 0
    endif

    if flex_align_desktop == 'align--middle-center-desktop'
      assign upsell_position_primary = 'center'
    endif

    if flex_align_desktop == 'align--top-center-desktop' or flex_align_desktop == 'align--bottom-center-desktop' or flex_align_desktop == 'align--middle-center-desktop'
      assign upsell_position_secondary = upsell_position_horizontal
    endif
  endif

  assign promote_homepage_h1 = false
  if template.name == 'index' and section.location == 'template' and section.index == 1
    assign promote_homepage_h1 = true
  endif

  capture rendered_blocks
    content_for 'blocks'
  endcapture

  capture badge_blocks
    render 'badge-blocks', source: rendered_blocks, part: 'badges'
  endcapture

  capture content_blocks
    render 'badge-blocks', source: rendered_blocks, part: 'content'
  endcapture
-%}

{%- style -%}
  #{{ section.id }} {
    --PT: {{ padding_top }}px;
    --PB: {{ padding_bottom }}px;
    --hero-content-width: {{ section.settings.content_width }}%;
  }
{%- endstyle -%}

<div
  class="index-hero section-padding {{ color_scheme }} no-bg"
  id="{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-badge-host
  data-shape-divider-root
>
  {%- if render_section -%}
    <div class="hero__wrapper frame {{ section_width }}{% if upsell_product != blank %} hero__wrapper--upsell hero__wrapper--upsell-{{ upsell_position_primary }}{% if upsell_position_secondary != blank %} hero__wrapper--upsell-position-{{ upsell_position_secondary }}{% endif %}{% endif %}">
      {%- if banner_link != blank -%}
        <a class="hero__images frame__item" href="{{ banner_link }}">
      {%- else -%}
        <div class="hero__images frame__item">
      {%- endif -%}

      {%- if render_image -%}
        {%- assign image_modifier = '' -%}
        {%- if section_width == 'wrapper--full' -%}
          {%- assign image_modifier = 'image-square' -%}
        {%- endif -%}

        <div class="hero__split-image{% if image == blank %} hero__split-image--blank{% endif %}">
          {%- render 'image-hero',
            image_desktop: image,
            image_mobile: mobile_image,
            sizes: sizes,
            loading: loading,
            preload: preload,
            fetchpriority: fetchpriority,
            priority: image_priority,
            desktop_height: desktop_height,
            mobile_height: mobile_height,
            modifier: image_modifier
          -%}
        </div>
      {%- endif -%}

      {%- if render_metafield_info -%}
        <div class="image__hero__missing-metafield-image">{{ 'products.general.missing_metafield_image' | t }}</div>
      {%- endif -%}

      {%- if render_image_overlay -%}
        <div class="image-overlay" style="--overlay-opacity: {{ overlay_opacity }};"></div>
      {%- endif -%}

      {{ badge_blocks }}

      {%- if banner_link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}

      {%- if render_content_blocks -%}
        <div
          class="hero__content__wrapper frame__item {{ flex_align_desktop }} {{ flex_align_mobile }}{% if show_header_backdrop %} backdrop--linear{% endif %}"
          {% if show_header_backdrop %}
            style="--header-overlay-color: var(--OVERLAY-BG); --header-overlay-opacity: {{ overlay_opacity }};"
          {% endif %}
        >
          <div
            class="hero__content hero__content--padding-default hero__content--width{% if hero_transparent %} hero__content--transparent{% endif %}{% if show_overlay_text %} backdrop--radial{% endif %}"
            {% if overlay_opacity != 0.0 %}
              style="--overlay-opacity: {{ overlay_opacity }};"
            {% endif %}
          >
            {%- render 'heading-auto-promote', content_blocks: content_blocks, promote: promote_homepage_h1 -%}
          </div>

          {%- if upsell_product != blank -%}
            <div
              class="hero__content__aside"
              data-aos="hero"
              data-aos-anchor="{{ section.id }}"
              data-aos-order="{{ upsell_animation_order }}"
            >
              {%- render 'upsell-product',
                upsell_product: upsell_product,
                upsell_modifier: 'product-upsell__holder--mini-mobile product-upsell__holder--frosted-glass',
                unique_id: section.id,
                color_scheme: section.settings.upsell_color_scheme,
                button_type: section.settings.upsell_button_type,
                button_size: section.settings.upsell_button_size,
                button_style: section.settings.upsell_button_style,
                is_compact: true
              -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Image banner",
  "class": "section-overlay-header section-floating",
  "blocks": [
    {"type": "heading"},
    {"type": "subheading"},
    {"type": "text"},
    {"type": "button"},
    {"type": "code"},
    {"type": "reviews"},
    {"type": "countdown-timer"},
    {"type": "group-buttons"},
    {"type": "_badges"},
    {"type": "shape-divider"}
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Primary image",
      "info": "3200 x 1200px .jpg recommended. [Learn more](http://presidiodev.com/link/headlands/images)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Image link"
    },
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "select",
      "visible_if": "{{ section.settings.flex_align_desktop != 'align--top-center-desktop' and section.settings.flex_align_desktop != 'align--bottom-center-desktop' and section.settings.flex_align_desktop != 'align--middle-center-desktop' }}",
      "id": "product_desktop_alignment_vertical",
      "label": "Desktop alignment",
      "default": "bottom",
      "options": [
        {"value": "top", "label": "Top"},
        {"value": "middle", "label": "Middle"},
        {"value": "bottom", "label": "Bottom"}
      ]
    },
    {
      "type": "select",
      "visible_if": "{{ section.settings.flex_align_desktop == 'align--top-center-desktop' or section.settings.flex_align_desktop == 'align--bottom-center-desktop' or section.settings.flex_align_desktop == 'align--middle-center-desktop' }}",
      "id": "product_desktop_alignment_horizontal",
      "label": "Desktop alignment",
      "default": "center",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ]
    },
    {
      "type": "color_scheme",
      "id": "upsell_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "upsell_button_type",
      "label": "Button color",
      "default": "btn--secondary",
      "options": [
        {"value": "btn--black", "label": "Black"},
        {"value": "btn--white", "label": "White"},
        {"value": "btn--primary", "label": "Primary"},
        {"value": "btn--secondary", "label": "Secondary"}
      ]
    },
    {
      "type": "select",
      "id": "upsell_button_size",
      "label": "Button size",
      "default": "btn--small",
      "options": [
        {"label": "Small", "value": "btn--small"},
        {"label": "Medium", "value": ""},
        {"label": "Large", "value": "btn--large"}
      ]
    },
    {
      "type": "select",
      "id": "upsell_button_style",
      "label": "Button style",
      "default": "btn--outline",
      "options": [
        {"label": "Solid", "value": "btn--solid"},
        {"label": "Outline", "value": "btn--outline"}
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full",
      "options": [
        {"value": "wrapper--full", "label": "Full width"},
        {"value": "wrapper--full-padded", "label": "Full width padded"}
      ]
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "screen-height-three-quarters",
      "options": [
        {"value": "image-height", "label": "Image height"},
        {"value": "screen-height-full", "label": "Full screen height"},
        {"value": "screen-height-three-quarters", "label": "3/4 of screen"},
        {"value": "screen-height-two-thirds", "label": "2/3 of screen"},
        {"value": "screen-height-one-half", "label": "1/2 of screen"},
        {"value": "screen-height-one-third", "label": "1/3 of screen"},
        {"value": "seven-fifty-height-hero", "label": "750px"},
        {"value": "six-fifty-height-hero", "label": "650px"},
        {"value": "five-fifty-height-hero ", "label": "550px"},
        {"value": "four-fifty-height-hero", "label": "450px"}
      ]
    },
    {
      "type": "select",
      "id": "flex_align_desktop",
      "label": "Desktop alignment",
      "default": "align--middle-center-desktop",
      "options": [
        {"value": "align--top-left-desktop", "label": "Top left"},
        {"value": "align--top-center-desktop", "label": "Top center"},
        {"value": "align--top-right-desktop", "label": "Top right"},
        {"value": "align--middle-left-desktop", "label": "Middle left"},
        {"value": "align--middle-center-desktop", "label": "Absolute center"},
        {"value": "align--middle-right-desktop", "label": "Middle right"},
        {"value": "align--bottom-left-desktop", "label": "Bottom left"},
        {"value": "align--bottom-center-desktop", "label": "Bottom center"},
        {"value": "align--bottom-right-desktop", "label": "Bottom right"}
      ]
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Content width",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image",
      "info": "1200 x 1600px .jpg recommended. [Learn more](http://presidiodev.com/link/headlands/images)"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Height",
      "default": "screen-height-three-quarters--mobile",
      "options": [
        {"value": "image-height--mobile", "label": "Image height"},
        {"value": "screen-height-full--mobile", "label": "Full screen height"},
        {"value": "screen-height-three-quarters--mobile", "label": "3/4 of screen"},
        {"value": "screen-height-two-thirds--mobile", "label": "2/3 of screen"},
        {"value": "screen-height-one-half--mobile", "label": "1/2 of screen"},
        {"value": "screen-height-one-third--mobile", "label": "1/3 of screen"},
        {"value": "seven-fifty-height-hero--mobile", "label": "750px"},
        {"value": "six-fifty-height-hero--mobile", "label": "650px"},
        {"value": "five-fifty-height-hero--mobile", "label": "550px"},
        {"value": "four-fifty-height-hero--mobile", "label": "450px"}
      ]
    },
    {
      "type": "select",
      "id": "flex_align_mobile",
      "label": "Mobile alignment",
      "default": "align--middle-center-mobile",
      "options": [
        {"value": "align--top-left-mobile", "label": "Top left"},
        {"value": "align--top-center-mobile", "label": "Top center"},
        {"value": "align--top-right-mobile", "label": "Top right"},
        {"value": "align--middle-left-mobile", "label": "Middle left"},
        {"value": "align--middle-center-mobile", "label": "Absolute center"},
        {"value": "align--middle-right-mobile", "label": "Middle right"},
        {"value": "align--bottom-left-mobile", "label": "Bottom left"},
        {"value": "align--bottom-center-mobile", "label": "Bottom center"},
        {"value": "align--bottom-right-mobile", "label": "Bottom right"}
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "show_text_background",
      "label": "Show text background",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "info": "Increase contrast for legible text.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_overlay_text",
      "label": "Overlay behind text only",
      "default": false,
      "info": "Overlay opacity must be greater than 0."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show placeholder image",
      "info": "Disable if using a metafield",
      "default": true
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Image banner",
      "category": "Image",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "Image banner"
          }
        },
        {
          "type": "text"
        },
        {
          "type": "group-buttons"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
