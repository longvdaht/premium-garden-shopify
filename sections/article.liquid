<!-- /sections/article.liquid -->

{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign article_url = article.url
  assign content_block_count = content_section_blocks.size
  assign show_sidebar = false
  if content_block_count != 0
    assign show_sidebar = true
  endif

  assign show_date = section.settings.show_date
  assign show_author = section.settings.show_author
  assign article_topic = article.tags | first
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign header_color = settings.menu_transparent_color
  assign selected_color_scheme = section.settings.color_scheme | strip
  assign scheme_bg_color = settings.color_schemes[selected_color_scheme].settings.bg

  assign transparent = false
  if scheme_bg_color == 'rgba(0,0,0,0)' or scheme_bg_color == blank
    assign transparent = true
  endif
-%}

{%- render 'stylesheet', name: 'article.css' -%}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;

  {%- unless scheme_bg_color == 'rgba(0,0,0,0)' or scheme_bg_color == blank -%}
    --bg: {{ scheme_bg_color }};
  {%- else -%}
    --bg: transparent;
  {%- endunless -%}
{%- endcapture -%}

<section
  class="article-single section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="article"
  {% if shape_divider_blocks != blank %}data-shape-divider-host{% endif %}
  style="{{ style }}"
>
  <div class="article__hero text-center">
    <div class="wrapper">
      {%- if article_topic != blank -%}
        <p class="article__eyebrow">
          <a href="{{ blog.url }}/tagged/{{ article_topic | handleize }}">{{ article_topic }}</a>
        </p>
      {%- endif -%}

      <h1 class="article__title h2">{{ article.title }}</h1>

      {%- if show_date or show_author -%}
        <p class="article__meta">
          {%- assign published_at = article.published_at | date: format: 'full_date' -%}

          {%- if show_date -%}
            <time datetime="{{ published_at }}">{{ published_at }}</time>
          {%- endif -%}

          {%- assign read_time = article.metafields.custom.read_time.value -%}
          {%- if read_time != blank -%}
            <span class="article__read-time">{{ read_time }} min read</span>
          {%- endif -%}

          {%- if show_author -%}
            <span class="article__author">{{ 'blogs.article.by_author' | t: author: article.author }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if section.settings.show_image and article.image -%}
        <div class="article__image {{ section.settings.height }} {{ section.settings.mobile_height }}">
          {%- render 'image-hero',
            image: article.image,
            sizes: '(min-width: 750px) 50vw, calc(100vw - 32px)',
            desktop_height: section.settings.height,
            mobile_height: section.settings.mobile_height,
            show_backfill: false
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="wrapper article__wrapper">
    <div class="grid{% if show_sidebar %} grid--article{% else %} grid--1{% endif %}">
      <article class="article article--single">
        <div class="article__content__wrapper">
          <div class="article__content rte">
            {{ article.content }}
          </div>
        </div>

        {%- if article.user.bio and show_author -%}
          <div class="hr"></div>

          <div class="article__author-bio h6">
            {%- if article.user.image != blank -%}
              <div class="article__author__image">
                {%- render 'image',
                  image: article.user.image,
                  width: 160,
                  widths: '80, 120, 160, 240',
                  sizes: '80px'
                -%}
              </div>
            {%- endif -%}

            <div class="article__author__text">
              <h3>
                {{ article.user.first_name }}
                {{ article.user.last_name }}
              </h3>

              <p class="rte">{{ article.user.bio | newline_to_br }}</p>
            </div>
          </div>
        {%- endif -%}

        {%- if article_topic != blank or section.settings.show_sharing -%}
          <div class="article__footer-links">
            <div class="article__footer-meta">
              {%- if article_topic != blank -%}
                <span class="article__footer-label">Topic:</span>
                <a href="{{ blog.url }}/tagged/{{ article_topic | handleize }}" class="article__footer-link">{{ article_topic | downcase | capitalize }}</a>
                <span class="article__footer-sep">·</span>
                <span class="article__footer-label">Shop:</span>
                <a href="{{ routes.root_url }}collections/{{ article_topic | handleize }}" class="article__footer-link">{{ article_topic | downcase | capitalize }}</a>
              {%- endif -%}
            </div>

            {%- if section.settings.show_sharing -%}
              <div class="article__footer-share">
                {%- assign share_url = article.url | prepend: request.origin -%}
                <span class="article__footer-label">Share:</span>
                <a href="mailto:?subject={{ article.title | url_encode }}&body={{ share_url | url_encode }}" class="article__footer-link">Email</a>
                <span class="article__footer-sep">·</span>
                <button
                  class="article__footer-link article__footer-copy-link"
                  data-copy-url="{{ share_url }}"
                  type="button"
                >Copy link</button>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.arrows -%}
          {%- if blog.next_article or blog.previous_article -%}
            <aside class="flex justify-space-between">
              {%- if blog.previous_article -%}
                <small>
                  {%- for post in blog.articles -%}
                    {%- if post.url == blog.previous_article -%}
                      <a
                        href="{{ post.url }}"
                        class="btn btn--text btn--text-no-underline btn--small"
                        title="{{ post.title | strip_html | escape }}"
                      >
                        {%- render 'icon', name: 'caret-left' -%}

                        <span>[PREVIOUS ARTICLE]</span>
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </small>
              {%- endif -%}

              {%- if blog.next_article -%}
                <small>
                  {%- for post in blog.articles -%}
                    {%- if post.url == blog.next_article -%}
                      <a
                        href="{{ post.url }}"
                        class="btn btn--text btn--text-no-underline btn--small"
                        title="{{ post.title | strip_html | escape }}"
                      >
                        <span>[NEXT ARTICLE]</span>

                        {%- render 'icon', name: 'caret-right' -%}
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </small>
              {%- endif -%}
            </aside>
          {%- endif -%}
        {%- endif -%}
      </article>
      <!-- end article -->

      {%- if show_sidebar -%}
        <aside class="sidebar">
          <div class="sidebar__contents">
            {%- for block in content_section_blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {%- render block -%}
                {%- when 'links' -%}
                  <div class="widget widget--topics" {{ block.shopify_attributes }}>
                    {%- assign topics_title = block.settings.title | default: 'Topics' -%}
                    <h3 class="widget__title">{{ topics_title }}</h3>
                    <ul class="widget__links">
                      {%- if block.settings.blog_linklist != blank -%}
                        {%- for link in linklists[block.settings.blog_linklist].links -%}
                          <li{% if article.tags contains link.title or article_topic == link.title %} class="widget__links--active"{% endif %}>
                            <a class="widget__link" href="{{ link.url }}">{{ link.title | downcase | capitalize }}</a>
                          </li>
                        {%- endfor -%}
                      {%- elsif blog.all_tags.size > 0 -%}
                        {%- for tag in blog.all_tags -%}
                          <li{% if article.tags contains tag %} class="widget__links--active"{% endif %}>
                            <a class="widget__link" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | downcase | capitalize }}</a>
                          </li>
                        {%- endfor -%}
                      {%- else -%}
                        {%- assign default_topics = 'Growing,Potting,Planting,Watering,Feeding,Pruning,Goods' | split: ',' -%}
                        {%- for topic in default_topics -%}
                          <li{% if article_topic == topic %} class="widget__links--active"{% endif %}>
                            <a class="widget__link" href="{{ blog.url }}/tagged/{{ topic | handle }}">{{ topic | downcase | capitalize }}</a>
                          </li>
                        {%- endfor -%}
                      {%- endif -%}
                    </ul>
                  </div>

                {%- when 'related' -%}
                  {% comment %} Extract product handles from metafield, settings, or links in article content {% endcomment %}
                  {%- assign guide_products = article.metafields.custom.related_products.value -%}
                  {%- assign article_content = article.content | split: '/products/' -%}
                  {%- assign handles = '' -%}
                  {%- if article_content.size > 1 and block.settings.product_list.count < 1 and guide_products == blank -%}
                    {%- for item in article_content -%}
                      {%- unless forloop.index0 == 0 -%}
                        {%- assign starts_with_handle = item | url_encode | split: '%' -%}
                        {%- assign handles = handles | append: starts_with_handle[0] | append: ',' -%}
                      {%- endunless -%}
                    {%- endfor -%}
                  {%- endif -%}
                  {%- assign handles_arr = handles | split: ',' | compact | uniq -%}

                  <div class="widget widget--tools" {{ block.shopify_attributes }}>
                    {%- assign tools_title = block.settings.title | default: 'Tools in this guide' -%}
                    <h3 class="widget__title">{{ tools_title }}</h3>

                    <div class="widget__products">
                      {%- liquid
                        if guide_products != blank and guide_products.count > 0
                          for product in guide_products limit: 5
                            render 'upsell-product', upsell_product: product, is_compact: true, upsell_button_text: 'ADD', button_style: 'btn--outline'
                          endfor
                        elsif block.settings.product_list.count > 0
                          for product in block.settings.product_list
                            render 'upsell-product', upsell_product: product, is_compact: true, upsell_button_text: 'ADD', button_style: 'btn--outline'
                          endfor
                        elsif handles_arr.size > 0
                          for handle in handles_arr limit: 5
                            assign product = all_products[handle]
                            if product.id != ''
                              render 'upsell-product', upsell_product: product, is_compact: true, upsell_button_text: 'ADD', button_style: 'btn--outline'
                            endif
                          endfor
                        endif
                      -%}
                    </div>
                  </div>

                {%- when 'collection' -%}
                  {%- liquid
                    assign sidebar_collection = article.metafields.custom.related_collections.value | first
                    if sidebar_collection == blank and block.settings.collection != blank
                      assign sidebar_collection = block.settings.collection
                    endif
                    if sidebar_collection == blank and article_topic != blank
                      assign topic_handle = article_topic | handleize
                      assign sidebar_collection = collections[topic_handle]
                    endif
                    if sidebar_collection == blank
                      assign sidebar_collection = collections.first
                    endif

                    assign collection_image = block.settings.image | default: sidebar_collection.image | default: sidebar_collection.featured_image | default: sidebar_collection.products.first.featured_image

                    assign collection_desc = block.settings.description | default: sidebar_collection.description
                    if collection_desc == blank
                      assign handle_key = sidebar_collection.handle | default: topic_handle
                      case handle_key
                        when 'pruning'
                          assign collection_desc = 'Edge tools for shaping, maintenance, and collecting'
                        when 'growing'
                          assign collection_desc = 'Essentials, tools, and supplies for sowing, tending, and harvesting'
                        when 'potting'
                          assign collection_desc = 'Containers, potting mixes, tools and workbenches'
                        when 'planting'
                          assign collection_desc = 'Bulbs, tools, soil preparation, and planting gear'
                        when 'watering'
                          assign collection_desc = 'Hoses, cans, sprayers, and irrigation equipment'
                        when 'feeding'
                          assign collection_desc = 'Organic fertilizers, composts, and plant nutrients'
                        when 'goods'
                          assign collection_desc = 'Handcrafted garden goods, accessories, and wear'
                        else
                          assign collection_desc = 'Tools and essentials for the working garden'
                      endcase
                    endif
                  -%}
                  {%- if sidebar_collection != blank -%}
                    <div class="widget widget--collection" {{ block.shopify_attributes }}>
                      {%- assign collection_title = block.settings.title | default: 'Shop the collection' -%}
                      <h3 class="widget__title">{{ collection_title }}</h3>
                      <a href="{{ sidebar_collection.url }}" class="widget__collection-image-link" aria-label="{{ sidebar_collection.title }}">
                        <div class="widget__collection-image">
                          {%- if collection_image != blank -%}
                            {%- render 'image',
                              image: collection_image,
                              widths: '320, 480, 640',
                              sizes: '(min-width: 750px) 320px, calc(100vw - 40px)'
                            -%}
                          {%- else -%}
                            {{ 'collection-1' | placeholder_svg_tag: 'svg-placeholder' }}
                          {%- endif -%}
                        </div>
                      </a>
                      <h4 class="widget__collection-name">
                        <a href="{{ sidebar_collection.url }}">{{ sidebar_collection.title }}</a>
                      </h4>
                      {%- if collection_desc != blank -%}
                        <p class="widget__collection-tagline">{{ collection_desc | strip_html | truncate: 120 }}</p>
                      {%- endif -%}
                      <a href="{{ sidebar_collection.url }}" class="btn btn--text widget__collection-cta">
                        <span>{{ block.settings.cta_text | default: 'Shop the collection' }}</span>
                      </a>
                    </div>
                  {%- endif -%}

                {%- when 'recent' -%}
                  {%- liquid
                    assign article_limit = 3
                    assign counter = 0
                    assign topic_handle = article_topic | handleize
                  -%}

                  {%- capture recent_markup -%}
                    {% comment %} First: try matching topic/tag {% endcomment %}
                    {%- for recent_article in blog.articles -%}
                      {%- if recent_article.handle == article.handle -%}
                        {%- continue -%}
                      {%- endif -%}
                      {%- assign post_matches_topic = false -%}
                      {%- if article_topic != blank -%}
                        {%- for t in recent_article.tags -%}
                          {%- assign thandle = t | handleize -%}
                          {%- if thandle == topic_handle -%}
                            {%- assign post_matches_topic = true -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}

                      {%- if post_matches_topic or article_topic == blank -%}
                        <article class="widget__article-card">
                          {%- if recent_article.image != blank -%}
                            <a class="widget__article-image-link" href="{{ recent_article.url }}" aria-label="{{ recent_article.title | strip_html | escape }}">
                              <div class="widget__article-image">
                                {%- render 'image', image: recent_article.image, widths: '160, 240, 320', sizes: '88px' -%}
                              </div>
                            </a>
                          {%- endif -%}

                          <div class="widget__article-info">
                            <h4 class="widget__article-title">
                              <a href="{{ recent_article.url }}">{{ recent_article.title }}</a>
                            </h4>
                            {%- assign recent_read_time = recent_article.metafields.custom.read_time.value -%}
                            <p class="widget__article-meta">
                              {%- if recent_read_time != blank -%}
                                {{ recent_read_time }} min read
                              {%- elsif show_date -%}
                                {{ recent_article.published_at | date: format: 'full_date' }}
                              {%- endif -%}
                            </p>
                          </div>
                        </article>
                        {%- assign counter = counter | plus: 1 -%}
                        {%- if counter == article_limit -%}{%- break -%}{%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}

                    {% comment %} Fallback: if fewer than article_limit, fill with other recent articles {% endcomment %}
                    {%- if counter < article_limit -%}
                      {%- for recent_article in blog.articles -%}
                        {%- if recent_article.handle == article.handle -%}
                          {%- continue -%}
                        {%- endif -%}
                        <article class="widget__article-card">
                          {%- if recent_article.image != blank -%}
                            <a class="widget__article-image-link" href="{{ recent_article.url }}" aria-label="{{ recent_article.title | strip_html | escape }}">
                              <div class="widget__article-image">
                                {%- render 'image', image: recent_article.image, widths: '160, 240, 320', sizes: '88px' -%}
                              </div>
                            </a>
                          {%- endif -%}

                          <div class="widget__article-info">
                            <h4 class="widget__article-title">
                              <a href="{{ recent_article.url }}">{{ recent_article.title }}</a>
                            </h4>
                            {%- assign recent_read_time = recent_article.metafields.custom.read_time.value -%}
                            <p class="widget__article-meta">
                              {%- if recent_read_time != blank -%}
                                {{ recent_read_time }} min read
                              {%- elsif show_date -%}
                                {{ recent_article.published_at | date: format: 'full_date' }}
                              {%- endif -%}
                            </p>
                          </div>
                        </article>
                        {%- assign counter = counter | plus: 1 -%}
                        {%- if counter == article_limit -%}{%- break -%}{%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endcapture -%}

                  <div class="widget widget--recent" {{ block.shopify_attributes }}>
                    {%- liquid
                      if block.settings.title != blank
                        assign more_title = block.settings.title
                      elsif article_topic != blank
                        assign more_title = 'More in ' | append: article_topic
                      else
                        assign more_title = 'More guides'
                      endif
                    -%}
                    <h3 class="widget__title">{{ more_title }}</h3>
                    <div class="widget__recent-list">
                      {{ recent_markup }}
                    </div>
                  </div>

                {%- when 'image' -%}
                  {%- if article.image -%}
                    <div class="widget widget--image" {{ block.shopify_attributes }}>
                      {%- if block.settings.title != blank -%}
                        <h3 class="widget__title">{{ block.settings.title }}</h3>
                      {%- endif -%}

                      <div class="widget__image">
                        {%- render 'image',
                          image: article.image,
                          widths: '320, 480, 560, 640, 780, 960, 1280, 1440, 1960',
                          sizes: '(min-width: 750px) 320px, calc(100vw - 32px)'
                        -%}
                      </div>
                    </div>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
        <!-- end sidebar -->
      {%- endif -%}
    </div>

    {%- if blog.comments_enabled? -%}
      <div class="grid{% if show_sidebar %} grid--article{% else %} grid--1{% endif %}">
        <div class="comments-container">
          {% paginate article.comments by 5 %}
            {% if article.comments_count > 0 %}
              <div class="comments" id="comments">
                <div class="hr"></div>
                {% assign number_of_comments = article.comments_count %}
                <h3 class="h4">{{ 'blogs.comments.comments_with_count' | t: count: number_of_comments }}</h3>
                <div class="hr"></div>
                <!-- a "just published" comment -->
                {% if comment and comment.created_at %}
                  <div id="comment-{{ comment.id }}" class="comment">
                    <div class="comment-body">
                      <div class="comment-meta">
                        {% assign comment_date = comment.created_at | date: format: 'full_date' %}
                        <span class="author">{{ comment.author }}</span>
                        <span class="label"
                          ><time datetime="{{ comment_date }}">{{ comment_date }}</time></span
                        >
                      </div>
                      {{ comment.content }}
                    </div>
                  </div>
                {% endif %}
                <!-- previous comments -->
                {% for comment in article.comments %}
                  <div id="comment-{{ comment.id }}" class="comment">
                    <div class="comment-body">
                      <div class="comment-meta">
                        {% assign comment_date = comment.created_at | date: format: 'full_date' %}
                        <span class="author">{{ comment.author }}</span>
                        <span class="label"
                          ><time datetime="{{ comment_date }}">{{ comment_date }}</time></span
                        >
                      </div>
                      {{ comment.content }}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}

            {% if paginate.pages > 1 %}
              <div class="paginate">
                {% if paginate.previous %}
                  <span class="left">{{ '&larr;' | link_to: paginate.previous.url }}</span>
                {% endif %}
                {% for part in paginate.parts %}
                  {% if part.is_link %}
                    <span class="num">{{ part.title | link_to: part.url }}</span>
                  {% else %}
                    <span class="num current">{{ part.title }}</span>
                  {% endif %}
                {% endfor %}
                {% if paginate.next %}
                  <span class="right">{{ '&rarr;' | link_to: paginate.next.url }}</span>
                {% endif %}
              </div>
              <div class="hr"></div>
            {% endif %}

            <div class="comments-form">
              <div class="hr"></div>
              <h3 class="h4">{{ 'blogs.comments.title' | t }}</h3>
              <div class="hr"></div>
              {% form article %}
                {% if form.posted_successfully? %}
                  {% if blog.moderated? %}
                    <p class="flash">
                      <em>{{ 'blogs.comments.success_moderated' | t }}</em>
                    </p>
                  {% else %}
                    <p class="flash">
                      <em>{{ 'blogs.comments.success' | t }}</em>
                    </p>
                  {% endif %}
                {% endif %}
                {% if form.errors %}
                  <p class="error">{{ 'general.forms.post_error' | t }}</p>
                {% endif %}
                <div class="form-row">
                  <div class="form-field">
                    <label for="comment_author">{{ 'blogs.comments.name' | t }}</label>
                    <input
                      type="text"
                      id="comment_author"
                      name="comment[author]"
                      value="{{ form.author }}"
                      placeholder="{{ 'blogs.comments.name' | t }}"
                    >
                  </div>
                  <div class="form-field">
                    <label for="comment_email">{{ 'blogs.comments.email' | t }}</label>
                    <input
                      type="text"
                      id="comment_email"
                      name="comment[email]"
                      value="{{ form.email }}"
                      placeholder="{{ 'blogs.comments.email' | t }}"
                    >
                  </div>
                </div>
                <div class="form-field">
                  <label for="comment_body">{{ 'blogs.comments.comment' | t }}</label>
                  <textarea
                    id="comment_body"
                    name="comment[body]"
                    rows="5"
                    placeholder="{{ 'blogs.comments.comment' | t }}"
                  >{{ form.body }}</textarea>
                </div>

                <div class="form-field">
                  <div class="form__legal">
                    {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
                  </div>
                  {% if blog.moderated? %}
                    <p>
                      <em>{{ 'blogs.comments.moderated' | t }}</em>
                    </p>
                  {% endif %}

                  <input
                    type="submit"
                    value="{{ 'blogs.comments.post' | t }}"
                    id="comment-submit"
                    class="btn btn--primary btn--solid"
                  >

                  {% if form.errors %}
                    <script>
                      window.location.hash = '#add-comment-title';
                    </script>
                  {% endif %}

                  {% if form.posted_successfully? %}
                    <script>
                      window.location.hash = '#comments';
                    </script>
                  {% endif %}
                </div>
              {% endform %}
            </div>
          {% endpaginate %}
        </div>
      </div>
      <!-- end comments -->
    {%- endif -%}
  </div>
  {%- render 'shape-dividers', mode: 'host' -%}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const copyBtn = document.querySelector('.article__footer-copy-link');
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        const url = this.getAttribute('data-copy-url');
        if (navigator.clipboard && url) {
          navigator.clipboard.writeText(url).then(function() {
            const originalText = copyBtn.textContent;
            copyBtn.textContent = 'Copied!';
            setTimeout(function() {
              copyBtn.textContent = originalText;
            }, 2000);
          });
        }
      });
    }
  });
</script>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ shop.url | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {%- assign article_seo_desc = article.metafields.custom.summary.value | default: article.excerpt -%}
    {% if article_seo_desc != blank %}
      "description": {{ article_seo_desc | strip_html | json }},
    {% endif %}
    {% if article.image %}
      "image": [
        {{ article | image_url: article.image.width | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
</script>

