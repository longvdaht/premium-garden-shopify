{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign animation_order = 0
  assign animation_anchor = 'Collection--' | append: section.id
  assign layout_mobile = section.settings.layout_mobile
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign link_text = section.settings.link_text
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign button_markup = ''
  assign has_content = false
  if heading != blank or description != blank or link_text != blank
    assign has_content = true
  endif

  assign grid_columns = section.settings.grid
  assign grid_rows = section.settings.rows
  assign layout = section.settings.layout

  assign featured_collection = collections[section.settings.featured_collection]
  assign limit_products = 20
  assign limit_onboarding = 8

  capture product_grid_classes
    echo 'grid'

    if layout_mobile == 'slider'
      echo ' grid--mobile-slider'
    else
      echo ' grid--mobile-vertical'
    endif
  endcapture

  assign columns_desktop = grid_columns | plus: 0
  assign columns_medium = 3
  assign columns_small = 2
  assign columns_mobile = layout_mobile | plus: 0

  if columns_desktop == 2 or columns_desktop == 4
    assign columns_medium = 2
  endif

  assign limit_products = grid_columns | times: grid_rows
  assign limit_onboarding = limit_products

  if grid_columns == 2 or grid_columns == 4
    assign columns_medium = 2
  endif

  assign button_style = section.settings.button_style
  if button_style == 'btn--text' and section.settings.show_arrow
    assign button_style = button_style | append: ' btn--text-no-underline'
  endif

  assign featured_images_array = ''

  # Get metaobject type from settings, default to 'collection_featured_promo'
  assign collection_promo_meta = section.settings.collection_promo_meta | default: 'collection_featured_promo'

  # Check if metaobject type exists and process promos directly
  assign has_metaobject_promos = false
  if featured_collection != blank and shop.metaobjects[collection_promo_meta]
    assign all_promos = shop.metaobjects[collection_promo_meta].values

    # Filter and process metaobjects by collection reference
    if all_promos.size > 0
      for promo in all_promos
        if promo.collection.value and promo.collection.value.id == featured_collection.id
          assign has_metaobject_promos = true

          capture current_featured_image
            assign featured_image_position = promo.position.value | default: 1
            assign featured_image_order = featured_image_position | append: '-' | append: forloop.index

            if featured_image_position < 10
              assign featured_image_order = featured_image_order | prepend: '0'
            endif

            render 'collection-featured-image', promo_metaobject: promo, index: forloop.index
          endcapture

          assign featured_image_position = promo.position.value | default: 1
          assign featured_image_order = featured_image_position | append: '-' | append: forloop.index

          if featured_image_position < 10
            assign featured_image_order = featured_image_order | prepend: '0'
          endif

          assign featured_image = promo.image.value
          if featured_image == blank and promo.video.value != blank
            assign featured_image = promo.video.value.preview_image
          endif

          assign featured_images_array = featured_images_array | append: featured_image_order | append: '#featured_image_position#' | append: featured_image_position | append: '#featured_image_html#' | append: current_featured_image | append: '#featured_image#' | append: featured_image | append: '@@'
        endif
      endfor
    endif
  endif

  # Fallback to blocks for backward compatibility
  unless has_metaobject_promos
    for block in content_section_blocks
      capture current_featured_image
        assign featured_image = block.settings.featured_image
        assign featured_image_position = block.settings.position
        assign featured_image_order = featured_image_position | append: '-' | append: forloop.index

        if featured_image_position < 10
          assign featured_image_order = featured_image_order | prepend: '0'
        endif

        render 'collection-featured-image', block: block
      endcapture

      assign featured_images_array = featured_images_array | append: featured_image_order | append: '#featured_image_position#' | append: featured_image_position | append: '#featured_image_html#' | append: current_featured_image | append: '#featured_image#' | append: featured_image | append: '@@'
    endfor
  endunless

  assign featured_images_array = featured_images_array | split: '@@' | sort
-%}

{%- style -%}
  #Collection--{{ section.id }} {
     --PT: {{ section.settings.padding_top }}px;
     --PB: {{ section.settings.padding_bottom }}px;

     {%- if has_content -%}
       --PT-MOBILE: max({{ section.settings.padding_top }}px, calc(var(--gap) * 2));
     {%- endif -%}

     --COLUMNS: {{ columns_desktop }};
     --COLUMNS-MEDIUM: {{ columns_medium }};
     --COLUMNS-SMALL: {{ columns_small }};
     --COLUMNS-MOBILE: {{ columns_mobile }};
   }
{%- endstyle -%}

{%- if link_text != blank -%}
  {%- capture button_markup -%}
    <a
      class="btn {{ button_style }} {{ section.settings.button_size }} {{ section.settings.button_type }}"
      href="{% if section.settings.link_url != blank %}{{ section.settings.link_url }}{% else %}{{ featured_collection.url }}{% endif %}"
    >
      <span>{{ link_text | escape }}</span>

      {%- if section.settings.show_arrow -%}
        {%- render 'icon', name: 'caret-right' -%}
      {%- endif -%}
    </a>
  {%- endcapture -%}
{%- endif -%}

<section
  id="Collection--{{ section.id }}"
  class="index-products section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="product-grid"
  {% if shape_divider_blocks != blank %}
    data-shape-divider-host
  {% endif %}
>
  <div class="grid-container{% if layout == 'left' %} grid-container--inline{% endif %} {{ section.settings.width }}">
    {%- if has_content -%}
      <div class="grid__heading-holder{% if layout == 'inline' %} grid__heading-holder--inline{% elsif layout == 'left' %} grid__heading-holder--sticky{% elsif layout == 'center' %} text-center{% endif %}">
        {%- if heading != blank or description != blank -%}
          <div class="grid__heading-text">
            {%- if heading != blank -%}
              {%- liquid
                assign animation_order = animation_order | plus: 1
                assign heading_tag = 'h2'

                unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
                  assign heading_tag = section.settings.heading_tag
                endunless
              -%}

              <{{ heading_tag }}
                class="grid__heading {{ section.settings.heading_font_size }}"
                data-aos="hero"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-order="{{ animation_order }}"
              >
                {{- heading -}}
              </{{ heading_tag }}>
            {%- endif -%}

            {%- if description != blank -%}
              {%- assign animation_order = animation_order | plus: 1 -%}
              <div
                class="grid__description {{ section.settings.text_font_size }}"
                data-aos="hero"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-order="{{ animation_order }}"
              >
                {{- description -}}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if link_text != blank -%}
          {%- assign animation_order = animation_order | plus: 1 -%}
          <div
            class="grid__heading-actions{% if section.settings.button_bottom_mobile %} desktop{% endif %}"
            data-aos="hero"
            data-aos-anchor="{{ animation_anchor }}"
            data-aos-order="{{ animation_order }}"
          >
            {{ button_markup }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid__items-holder">
      <div class="grid-outer">
        <div class="{{ product_grid_classes }}">
          {%- assign counter_grid = 1 -%}
          {%- assign added_images_index = '' -%}

          {%- if featured_collection != blank -%}
            {%- if featured_collection.products_count > 0 -%}
              {%- liquid
                assign products_rendered = 0

                for product in featured_collection.products
                  # Process featured images for every product position
                  if featured_images_array.size > 0
                    for featured_image in featured_images_array
                      if featured_image == ''
                        continue
                      endif

                      assign featured_image_index = forloop.index
                      assign featured_image_position = featured_image | split: '#featured_image_position#' | last | split: '#featured_image_html#' | first | times: 1
                      assign featured_image_markup = featured_image | split: '#featured_image_html#' | last | split: '#featured_image#' | first
                      assign featured_image_index_tag = '@' | append: featured_image_index | append: '@'

                      if featured_image_position <= counter_grid
                        unless added_images_index contains featured_image_index_tag
                          assign counter_grid = counter_grid | plus: 1
                          assign added_images_index = added_images_index | append: '@' | append: featured_image_index | append: '@#'

                          echo featured_image_markup
                          assign products_rendered = products_rendered | plus: 1
                        endunless
                      endif
                    endfor

                    assign counter_grid = counter_grid | plus: 1
                  endif

                  # Only render visible products
                  unless product.tags contains 'hide'
                    # Only render up to the limit
                    if products_rendered < limit_products
                      assign animation_delay = products_rendered | times: 1
                      assign grid_int = grid_columns | times: 1
                      assign animation_delay = products_rendered | modulo: grid_int | times: 1
                      assign products_rendered = products_rendered | plus: 1

                      render 'product-card', product: product, animation_delay: animation_delay, index: products_rendered
                    endif
                  endunless

                  # Break if we've rendered enough products
                  if products_rendered >= limit_products
                    break
                  endif
                endfor
              -%}
            {%- else -%}
              <div class="no-results">
                <p>
                  <strong>{{ 'collections.general.no_matches' | t }}</strong>
                </p>
              </div>
            {%- endif -%}
          {%- else -%}
            {%- liquid
              for i in (1..limit_onboarding)
                if featured_images_array.size > 0
                  for featured_image in featured_images_array
                    if featured_image == ''
                      continue
                    endif

                    assign featured_image_index = forloop.index
                    assign featured_image_position = featured_image | split: '#featured_image_position#' | last | split: '#featured_image_html#' | first | times: 1
                    assign featured_image_markup = featured_image | split: '#featured_image_html#' | last | split: '#featured_image#' | first
                    assign featured_image_index_tag = '@' | append: featured_image_index | append: '@'

                    if featured_image_position <= counter_grid
                      unless added_images_index contains featured_image_index_tag
                        assign counter_grid = counter_grid | plus: 1
                        assign added_images_index = added_images_index | append: '@' | append: featured_image_index | append: '@#'

                        echo featured_image_markup
                      endunless
                    endif
                  endfor

                  assign counter_grid = counter_grid | plus: 1
                endif

                render 'product-card', product: null, index: forloop.index, animation_delay: forloop.index0
              endfor
            -%}
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- if link_text != blank and section.settings.button_bottom_mobile -%}
      <div class="grid__foot-holder mobile">
        {{ button_markup }}
      </div>
    {%- endif -%}
  </div>
  {%- render 'shape-dividers', mode: 'host' -%}
</section>

