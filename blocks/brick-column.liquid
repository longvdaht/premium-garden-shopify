{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'brick-column', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "Column",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "text-left",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Center"
        },
        {
          "value": "text-right",
          "label": "Right"
        }
      ],
      "default": "text-left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_mobile",
      "label": "Alignment",
      "options": [
        {
          "value": "text-left--mobile",
          "label": "Left"
        },
        {
          "value": "text-center--mobile",
          "label": "Center"
        },
        {
          "value": "text-right--mobile",
          "label": "Right"
        }
      ],
      "default": "text-left--mobile"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "Inherit color scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Top / Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_inline",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Left / Right",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Column",
      "category": "Layout"
    }
  ]
}
{% endschema %}
