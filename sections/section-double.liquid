<!-- /sections/section-double.liquid -->

{%- render 'section-double' -%}

{% schema %}
{
  "name": "Image with text",
  "class": "section-overlay-header",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Primary image",
      "info": "2000 x 1400px .jpg recommended. [Learn more](http://presidiodev.com/link/headlands/images)"
    },
    {
      "type": "checkbox",
      "id": "image_shape_enable",
      "label": "Enable image shape",
      "default": false
    },
    {
      "type": "select",
      "id": "image_crop",
      "label": "Crop",
      "default": "none",
      "visible_if": "{{ section.settings.image_shape_enable == true }}",
      "options": [
        {"value": "none", "label": "No crop"},
        {"value": "square", "label": "Square"},
        {"value": "portrait", "label": "Portrait"}
      ]
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "default": "scalloped-circle-1",
      "visible_if": "{{ section.settings.image_shape_enable == true }}",
      "options": [
        {"value": "archway", "label": "Archway"},
        {"value": "blob-1", "label": "Blob 1"},
        {"value": "blob-2", "label": "Blob 2"},
        {"value": "blob-3", "label": "Blob 3"},
        {"value": "circle", "label": "Circle"},
        {"value": "diamond", "label": "Diamond"},
        {"value": "scalloped-circle-1", "label": "Scalloped circle 1"},
        {"value": "scalloped-circle-2", "label": "Scalloped circle 2"},
        {"value": "star", "label": "Star"},
        {"value": "svg", "label": "SVG"}
      ]
    },
    {
      "type": "image_picker",
      "id": "image_shape_svg",
      "label": "Custom SVG",
      "info": "Upload an SVG with a solid shape on a transparent background. The image is clipped to that shape.",
      "visible_if": "{{ section.settings.image_shape_enable == true and section.settings.image_shape == 'svg' }}"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Secondary image",
      "info": "Displays both images at a 50% width. 2000 x 1400px .jpg recommended. [Learn more](http://presidiodev.com/link/headlands/images)"
    },
    {
      "type": "checkbox",
      "id": "image_2_shape_enable",
      "label": "Enable shape for secondary image",
      "default": false,
      "visible_if": "{{ section.settings.image_2 != blank }}"
    },
    {
      "type": "select",
      "id": "image_2_crop",
      "label": "Crop",
      "default": "none",
      "visible_if": "{{ section.settings.image_2 != blank and section.settings.image_2_shape_enable == true }}",
      "options": [
        {"value": "none", "label": "No crop"},
        {"value": "square", "label": "Square"},
        {"value": "portrait", "label": "Portrait"}
      ]
    },
    {
      "type": "select",
      "id": "image_2_shape",
      "label": "Image shape",
      "default": "scalloped-circle-1",
      "visible_if": "{{ section.settings.image_2 != blank and section.settings.image_2_shape_enable == true }}",
      "options": [
        {"value": "archway", "label": "Archway"},
        {"value": "blob-1", "label": "Blob 1"},
        {"value": "blob-2", "label": "Blob 2"},
        {"value": "blob-3", "label": "Blob 3"},
        {"value": "circle", "label": "Circle"},
        {"value": "diamond", "label": "Diamond"},
        {"value": "scalloped-circle-1", "label": "Scalloped circle 1"},
        {"value": "scalloped-circle-2", "label": "Scalloped circle 2"},
        {"value": "star", "label": "Star"},
        {"value": "svg", "label": "SVG"}
      ]
    },
    {
      "type": "image_picker",
      "id": "image_2_shape_svg",
      "label": "Custom SVG",
      "info": "Upload an SVG with a solid shape on a transparent background. The image is clipped to that shape.",
      "visible_if": "{{ section.settings.image_2 != blank and section.settings.image_2_shape_enable == true and section.settings.image_2_shape == 'svg' }}"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
      "default": "one-half",
      "options": [
        {"value": "one-half", "label": "50%"},
        {"value": "three-quarters", "label": "75%"}
      ]
    },
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Not shown on the storefront while an image shape is enabled."
    },
    {
      "type": "color_scheme",
      "id": "upsell_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "upsell_button_type",
      "label": "Button color",
      "default": "btn--secondary",
      "options": [
        {"value": "btn--black", "label": "Black"},
        {"value": "btn--white", "label": "White"},
        {"value": "btn--primary", "label": "Primary"},
        {"value": "btn--secondary", "label": "Secondary"}
      ]
    },
    {
      "type": "select",
      "id": "upsell_button_size",
      "label": "Button size",
      "default": "btn--small",
      "options": [
        {"label": "Small", "value": "btn--small"},
        {"label": "Medium", "value": ""},
        {"label": "Large", "value": "btn--large"}
      ]
    },
    {
      "type": "select",
      "id": "upsell_button_style",
      "label": "Button style",
      "default": "btn--outline",
      "options": [
        {"label": "Solid", "value": "btn--solid"},
        {"label": "Outline", "value": "btn--outline"}
      ]
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "text-left",
      "options": [
        {"value": "text-left", "label": "Left"},
        {"value": "text-center", "label": "Centered"}
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "",
      "options": [
        {"value": "", "label": "Image left, text right"},
        {"value": "is-reversed", "label": "Text left, image right"}
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full",
      "options": [
        {"value": "wrapper--full", "label": "Full width"},
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Normal"}
      ]
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "screen-height-three-quarters",
      "options": [
        {"value": "image-height", "label": "Image height"},
        {"value": "screen-height-full", "label": "Full screen height"},
        {"value": "screen-height-three-quarters", "label": "3/4 of screen"},
        {"value": "screen-height-two-thirds", "label": "2/3 of screen"},
        {"value": "screen-height-one-half", "label": "1/2 of screen"},
        {"value": "screen-height-one-third", "label": "1/3 of screen"},
        {"value": "seven-fifty-height-hero", "label": "750px"},
        {"value": "six-fifty-height-hero", "label": "650px"},
        {"value": "five-fifty-height-hero", "label": "550px"},
        {"value": "four-fifty-height-hero", "label": "450px"}
      ]
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Height",
      "default": "screen-height-one-half--mobile",
      "options": [
        {"value": "image-height--mobile", "label": "Image height"},
        {"value": "screen-height-full--mobile", "label": "Full screen height"},
        {"value": "screen-height-three-quarters--mobile", "label": "3/4 of screen"},
        {"value": "screen-height-two-thirds--mobile", "label": "2/3 of screen"},
        {"value": "screen-height-one-half--mobile", "label": "1/2 of screen"},
        {"value": "screen-height-one-third--mobile", "label": "1/3 of screen"},
        {"value": "seven-fifty-height-hero--mobile", "label": "750px"},
        {"value": "six-fifty-height-hero--mobile", "label": "650px"},
        {"value": "five-fifty-height-hero--mobile", "label": "550px"},
        {"value": "four-fifty-height-hero--mobile", "label": "450px"}
      ]
    },
    {
      "type": "checkbox",
      "id": "reverse_blocks",
      "label": "Reverse block placement",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Content background"
    },
    {
      "type": "checkbox",
      "id": "content_gutter",
      "label": "Enable gutter",
      "default": false,
      "visible_if": "{{ section.settings.content_bg != blank }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show placeholder image",
      "info": "Disable if using a metafield",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Image with text"
        },
        {
          "type": "select",
          "id": "heading_font_size",
