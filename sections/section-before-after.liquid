<!-- /sections/section-before-after.liquid -->
{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign unique = 'SectionBeforeAfter--' | append: section.id
  assign animation_order = 0
  assign animation_anchor = unique
  assign aspect_ratio = 1 | divided_by: section.settings.aspect_ratio
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign blocks_size = content_section_blocks.size
  assign wrapper = section.settings.width
  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2

  if blocks_size == 0
    assign compare_images_width = 'full'
  else
    assign compare_images_width = 'half'
  endif
-%}

{%- render 'stylesheet', name: 'section-before-after.css' -%}

{%- style -%}
  #{{ unique }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="{{ unique }}"
  class="section-before-after section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="before-after"
  {% if shape_divider_blocks != blank %}data-shape-divider-host{% endif %}
  {% if badge_blocks != blank %}data-badge-host{% endif %}
>
  <div class="{{ wrapper }}">
    <div class="before-after">
      {%- if blocks_size > 0 -%}
        <div class="before-after__content">
          {%- for block in content_section_blocks -%}
            {%- liquid
              capture block_style
                echo '--block-padding-bottom:' | append: block.settings.padding_bottom | append: 'px;'
              endcapture
            -%}

            {%- case block.type -%}
              {%- when 'heading' -%}
                {%- liquid
                  assign animation_order = animation_order | plus: 1
                  assign heading_tag = 'h2'

                  unless block.settings.heading_tag == 'automatic' or block.settings.heading_tag == blank
                    assign heading_tag = block.settings.heading_tag
                  endunless
                -%}

                <{{ heading_tag }}
                  class="{{ block.settings.heading_font_size }} block-padding"
                  data-aos="hero"
                  data-aos-order="{{ animation_order }}"
                  data-aos-anchor="{{ animation_anchor }}"
                  {{ block.shopify_attributes }}
                  style="{{ block_style }}"
                >
                  {{ block.settings.heading }}
                </{{ heading_tag }}>

              {%- when 'text' -%}
                {%- assign animation_order = animation_order | plus: 1 -%}
                <div
                  class="hero__description {{ block.settings.text_font_size }} block-padding"
                  data-aos="hero"
                  data-aos-order="{{ animation_order }}"
                  data-aos-anchor="{{ animation_anchor }}"
                  {{ block.shopify_attributes }}
                  style="{{ block_style }}"
                >
                  {{ block.settings.description }}
                </div>

              {%- when 'button' -%}
                {%- liquid
                  capture button_classes
                    assign button_style = block.settings.button_style
                    if button_style == 'btn--text' and block.settings.show_arrow
                      assign button_style = button_style | append: ' btn--text-no-underline'
                    endif
                    echo 'btn ' | append: button_style | append: ' ' | append: block.settings.button_type | append: ' ' | append: block.settings.button_size
                  endcapture

                  if forloop.last
                    assign last_block = true
                  endif
                -%}

                {%- capture button_html -%}
                  <a class="{{ button_classes }}"
                    href="{{ block.settings.link_url | default: '#!' }}">
                    <span>{{ block.settings.link_text | escape }}</span>

                    {%- if block.settings.show_arrow -%}
                      {%- render 'icon', name: 'caret-right'-%}
                    {%- endif -%}
                  </a>
                {%- endcapture -%}

                {%- assign button_block_attributes = block.shopify_attributes -%}
                {%- assign animation_order = animation_order | plus: 1 -%}

                <div
                  class="before-after__buttons desktop block-padding"
                  data-aos="hero"
                  data-aos-order="{{ animation_order }}"
                  data-aos-anchor="{{ animation_anchor }}"
                  {{ button_block_attributes }}
                  style="{{ block_style }}"
                >
                  {{ button_html }}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="before-after__images{% if compare_images_width == 'full' %} before-after__images--full-width{% endif %}">
        {%- render 'compare-images',
          image_1: image_1,
          image_2: image_2,
          aspect_ratio: aspect_ratio,
          animation_anchor: animation_anchor,
          wrapper: wrapper
        -%}
      </div>
    </div>

    {%- if button_html != blank -%}
      {%- unless last_block -%}
        {%- assign animation_order = animation_order | plus: 1 -%}
      {%- endunless -%}

      <div
        class="before-after__buttons mobile"
        data-aos="hero"
        data-aos-order="{{ animation_order }}"
        data-aos-anchor="{{ animation_anchor }}"
        {{ button_block_attributes }}
      >
        {{ button_html }}
      </div>
    {%- endif -%}
  </div>
  {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
  {%- render 'shape-dividers', mode: 'host' -%}
</section>

{% schema %}
{
  "name": "Before and after",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image_1",
