{%- doc -%}
  Dependencies:
  - CSS: logos.css
  - JS:  logos-slider.js
  - Snippets: image, no-blocks
{%- enddoc -%}

{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign logo_opacity_default = section.settings.logo_opacity | default: 100
  assign logo_opacity = logo_opacity_default | times: 0.01
  assign show_slider_text = false
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign enable_slider = section.settings.enable_heading_slider
  assign unique = 'Logos--' | append: section.id
  assign animation_anchor = unique
  assign animation_order = 1
  assign scroll_to_logo_label = 'general.accessibility.scroll_to_logo' | t
  assign logo_blocks = content_section_blocks | where: 'type', 'logo-item'
  assign logo_block_count = logo_blocks.size
  assign remainder = content_section_blocks.size | modulo: 2

  if remainder == 0
    assign initial_index = content_section_blocks.size | divided_by: 2 | minus: 1
  else
    assign initial_index = content_section_blocks.size | minus: 1 | divided_by: 2
  endif
-%}

{%- render 'stylesheet', name: 'section-logos.css' -%}

<script src="{{ 'logos-slider.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #{{ unique }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
    --logo-opacity: {{ logo_opacity }};
  }
{%- endstyle -%}

{%- if section.settings.title != blank -%}
  {%- capture heading -%}
    <p class="logos__title subheading"
      data-aos="hero"
      data-aos-anchor="{{ animation_anchor }}"
      data-aos-order="{{ animation_order }}"
    >
      {{ section.settings.title }}
    </p>
  {%- endcapture -%}
{%- endif -%}

{%- for block in logo_blocks -%}
  {%- capture slides -%}
    {{ slides }}

    {%- liquid
      assign logo = block.settings.logo
      assign logo_width = block.settings.logo_width
      assign sizes = logo_width | append: 'px'
      assign width = logo_width | times: 2
      assign width_retina = logo_width | times: 2
      assign widths = '100, 120, 140, 160, 180, 200, 240, 280, 320, 360, ' | append: logo_width | append: ', ' | append: width_retina
      assign link = block.settings.link

      if block.settings.text != blank and section.settings.enable_heading_slider
        assign show_slider_text = true
      endif
    -%}

    <swiper-slide
      class="logos__slide"
      data-index="{{ forloop.index0 }}"
      {{ block.shopify_attributes }}
    >
      {%- if enable_slider -%}
        <button
          class="logos__slide__link"
          type="button"
          aria-label="{{ scroll_to_logo_label }}"
        >
      {%- endif -%}

      {%- if link != blank and enable_slider == false -%}
        <a class="logos__slide__link" href="{{ link }}" aria-label="{{ logo.alt | strip_html | escape }}">
      {%- endif -%}

      <div class="logos__logo">
        {%- if logo != blank -%}
          <div
            class="logos__img"
            style="width: {{ logo_width }}px; height: {{ logo_width | divided_by: logo.aspect_ratio }}px;"
          >
            {%- render 'image', image: logo, sizes: sizes, width: width, widths: widths, show_backfill: false -%}
          </div>
        {%- else -%}
          <div class="logos__img svg-placeholder" style="width: {{ logo_width }}px; height: {{ logo_width }}px;">
            {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- if link != blank and enable_slider == false -%}
        </a>
      {%- endif -%}

      {%- if enable_slider -%}
        </button>
      {%- endif -%}
    </swiper-slide>
  {%- endcapture -%}

  {%- capture contents -%}
    {{ contents }}

    <swiper-slide
      class="logos__slide"
      data-index="{{ forloop.index0 }}"
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.text != blank -%}
        {%- liquid
          assign heading_tag = 'p'

          if block.settings.heading_tag == 'automatic' or block.settings.heading_tag == blank
            if forloop.index0 == initial_index
              assign heading_tag = 'h2'

              if template.name == 'index' and section.location == 'template' and section.index == 1
                assign heading_tag = 'h1'
              endif
            endif
          else
            assign heading_tag = block.settings.heading_tag
          endif
        -%}
        <{{ heading_tag }} class="logos__slide__text {{ block.settings.text_font_size }}">
          {{- block.settings.text -}}
        </{{ heading_tag }}>
      {%- endif -%}
    </swiper-slide>
  {%- endcapture -%}
{%- endfor -%}

<logos-slider
  id="{{ unique }}"
  class="logos swiper section-padding{% if enable_slider %} logos-press{% endif %} {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="logos"
  {% if shape_divider_blocks != blank %}
    data-shape-divider-host
  {% endif %}
  {% if badge_blocks != blank %}
    data-badge-host
  {% endif %}
>
  <div class="logos__wrapper">
    {{ heading }}

    {%- if logo_block_count != 0 -%}
      {%- assign animation_order = animation_order | plus: 1 -%}
      <div
        class="logos__slider__outer"
        data-aos="hero"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-order="{{ animation_order }}"
      >
        <div
          class="logos__slider"
          {% if request.design_mode %}
            data-block-scroll
          {% endif %}
        >
          {%- liquid
            assign initial_index = 0
            assign remainder = content_section_blocks.size | modulo: 2
            if remainder == 0
              assign initial_index = content_section_blocks.size | divided_by: 2 | minus: 1
            else
              assign initial_index = content_section_blocks.size | minus: 1 | divided_by: 2
            endif
            assign autoplay = section.settings.autoplay
            assign autoplay_delay = 0
            if autoplay
              assign autoplay_delay = section.settings.autoplay_delay | times: 1000
            endif
          -%}

          <swiper-container
            data-slider-logos
            loop="false"
            centered-slides="true"
            slides-per-view="5"
            effect="coverflow"
            coverflow-effect-slide-shadows="false"
            coverflow-effect-rotate="0"
            initial-slide="{{ initial_index }}"
            {%- if autoplay %}
              autoplay="{{ autoplay }}"
              autoplay-delay="{{ autoplay_delay }}"
              autoplay-disable-on-interaction="false"
            {%- endif -%}
          >
            {{ slides }}
          </swiper-container>
        </div>
      </div>
    {%- else -%}
      {%- render 'no-blocks' -%}
    {%- endif -%}

    {%- if show_slider_text -%}
      {%- assign animation_order = animation_order | plus: 1 -%}

      <div
        class="logos__slider-text wrapper"
        data-aos="hero"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-order="{{ animation_order }}"
      >
        <swiper-container
          data-slider-text
          loop="false"
          slides-per-view="1"
          initial-slide="{{ initial_index }}"
          effect="fade"
          fade-effect-cross-fade="true"
        >
          {{- contents -}}
        </swiper-container>
      </div>
    {%- endif -%}
  </div>
  {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
  {%- render 'shape-dividers', mode: 'host' -%}
</logos-slider>

