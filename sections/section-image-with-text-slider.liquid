{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign desktop_height = section.settings.height
  assign mobile_height = section.settings.mobile_height
  assign width = section.settings.width
  assign enable_slider = false
  assign enable_text_slider = false
  assign show_placeholder = section.settings.show_placeholder
  assign color_scheme = 'color-' | append: section.settings.color_scheme

  assign unique = 'ImageWithTextSlider--' | append: section.id
  assign animation_anchor = unique
  assign animation_order = 0

  assign autoplay = section.settings.autoplay
  assign autoplay_delay = 0

  if autoplay
    assign autoplay_delay = section.settings.autoplay_delay | times: 1000
  endif

  if content_section_blocks.size > 1
    assign enable_text_slider = true

    for block in content_section_blocks
      if block.settings.image
        assign enable_slider = true
        assign enable_text_slider = false
        break
      endif
    endfor
  endif

  capture style
    echo '--PT: ' | append: section.settings.padding_top | append: 'px;'
    echo '--PB: ' | append: section.settings.padding_bottom | append: 'px;'
  endcapture

  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2
  assign image_width = section.settings.image_width
  capture sizes
    if image_1 and image_2
      if image_width == 'three-quarters'
        echo '(min-width: 750px) 37.5vw, 100vw'
      else
        echo '(min-width: 750px) 25vw, 100vw'
      endif
    else
      if image_width == 'three-quarters'
        echo '(min-width: 750px) 75vw, 100vw'
      else
        echo '(min-width: 750px) 50vw, 100vw'
      endif
    endif
  endcapture

  assign figure_width_class = ''

  if image_width == 'three-quarters'
    assign figure_width_class = ' brick__block--three-quarters'
  endif

  assign enable_image_slider = false
  if image_1 != blank and image_2 != blank
    assign enable_image_slider = true
  endif
-%}

{%- capture section_images -%}
  {%- liquid
    assign image_element_tag = 'div'
    assign image_element_class = 'brick__block__image'
    if enable_image_slider
      assign image_element_tag = 'swiper-slide'
      assign image_element_class = image_element_class
    endif
  -%}
  {%- if image_1 != blank -%}
    <{{ image_element_tag }} class="{{ image_element_class }}">
      {%- render 'image-hero' image: image_1, sizes: sizes, desktop_height: desktop_height, mobile_height: mobile_height -%}
    </{{ image_element_tag }}>
  {%- endif -%}

  {%- if image_2 != blank -%}
    <{{ image_element_tag }} class="{{ image_element_class }}">
      {%- render 'image-hero' image: image_2, sizes: sizes, desktop_height: desktop_height, mobile_height: mobile_height -%}
    </{{ image_element_tag }}>
  {%- endif -%}

  {%- if image_1 == blank and image_2 == blank -%}
    <{{ image_element_tag }} class="{{ image_element_class }}">
      {%- render 'image-hero' sizes: sizes, desktop_height: desktop_height, mobile_height: mobile_height -%}
    </{{ image_element_tag }}>
  {%- endif -%}
{%- endcapture -%}

{%- render 'stylesheet', name: 'section-image-with-text-slider.css' -%}

<section
  id="{{ unique }}"
  data-section-id="{{ section.id }}"
  data-section-type="double"
  {% if shape_divider_blocks != blank %}data-shape-divider-host{% endif %}
  {% if badge_blocks != blank %}data-badge-host{% endif %}
  class="index-image-text section-padding {{ section.settings.text_alignment }} {{ color_scheme }}"
  style="{{ style }}"
>
  {%- if content_section_blocks.size != 0 -%}
    {%- if enable_slider -%}
      <div class="swiper brick__slider {{ width }}">
        <swiper-container
          loop="true"
          slides-per-view="1"
          speed="500"
          grab-cursor="true"
          navigation="true"
          navigation-prev-el=".{{ section.id }}--button.swiper-button-prev"
          navigation-next-el=".{{ section.id }}--button.swiper-button-next"
          {%- if autoplay %}
            autoplay="{{ autoplay }}"
            autoplay-delay="{{ autoplay_delay }}"
            autoplay-disable-on-interaction="false"
          {%- endif -%}
          {%- unless settings.dots_style == 'hidden' -%}
            pagination="true"
            pagination-clickable="true"
            pagination-el=".{{ section.id }}--pagination.swiper-pagination"
          {%- endunless -%}
        >
          {%- for block in content_section_blocks -%}
            {%- liquid
              assign image = block.settings.image
              assign subheading = block.settings.subheading
              assign title = block.settings.title
              assign text = block.settings.text
              assign button_text = block.settings.button_text
            -%}

            <swiper-slide
              class="brick__section{% if section.settings.layout == 'is-reversed' %} brick__section--reversed{% endif %}{% if section.settings.reverse_blocks %} brick__section--reversed-mobile{% endif %} {{ desktop_height }} {{ mobile_height }}"
              {{ block.shopify_attributes }}
            >
              <div class="brick__block brick__block--images{{ figure_width_class }}">
                {%- if image -%}
                  <div class="brick__block__image">
                    {%- render 'image-hero',
                      image: image,
                      sizes: sizes,
                      desktop_height: desktop_height,
                      mobile_height: mobile_height
                    -%}
                  </div>
                {%- else -%}
                  {{ section_images }}
                {%- endif -%}
              </div>

              <div
                class="brick__block brick__block--text"
                {% if style != blank %}
                  style="{{ style }}"
                {% endif %}
              >
                <div class="brick__block__text">
                  <div class="hero__content hero__content--compact">
                    {%- if subheading != blank -%}
                      <p class="hero__subheading">
                        {{ subheading }}
                      </p>
                    {%- endif -%}

                    {%- if title != blank -%}
                      {%- liquid
                        assign heading_tag = 'h2'

                        unless block.settings.heading_tag == 'automatic' or block.settings.heading_tag == blank
                          assign heading_tag = block.settings.heading_tag
                        endunless
                      -%}

                      <{{ heading_tag }} class="hero__title {{ block.settings.heading_font_size }}">
                        {{ title }}
                      </{{ heading_tag }}>
                    {%- endif -%}

                    {%- if text != blank -%}
                      <div class="hero__rte {{ block.settings.text_font_size }}">
                        {{ text }}
                      </div>
                    {%- endif -%}

                    {%- if button_text != blank -%}
                      {%- liquid
                        capture button_classes
                          assign button_style = block.settings.button_style
                          if button_style == 'btn--text' and block.settings.show_arrow
                            assign button_style = button_style | append: ' btn--text-no-underline'
                          endif
                          echo 'btn ' | append: button_style | append: ' ' | append: block.settings.button_type | append: ' ' | append: block.settings.button_size
                        endcapture
                      -%}

                      <div class="hero__button">
                        <a
                          href="{{ block.settings.button_url | default: '#!' }}"
                          class="{{ button_classes }}"
                        >
                          <span>{{ button_text }}</span>

                          {%- if block.settings.show_arrow -%}
                            {%- render 'icon', name: 'caret-right' -%}
                          {%- endif -%}
                        </a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </swiper-slide>
          {%- endfor -%}
        </swiper-container>

        <button
          type="button"
          class="{{ section.id }}--button swiper-button-prev"
          aria-label="{{ 'general.accessibility.previous_slide' | t }}"
        >
          {%- render 'icon', name: 'caret-left' -%}
        </button>
        <button
          type="button"
          class="{{ section.id }}--button swiper-button-next"
          aria-label="{{ 'general.accessibility.next_slide' | t }}"
        >
          {%- render 'icon', name: 'caret-right' -%}
        </button>

        {% unless settings.dots_style == 'hidden' %}
          <div class="{{ section.id }}--pagination swiper-pagination swiper-pagination-bullets"></div>
        {% endunless %}
      </div>
    {%- else -%}
      {%- capture content_markup -%}
        {%- for block in content_section_blocks -%}
          {%- if enable_text_slider -%}
            <swiper-slide
              class="grid-item"
              {{ block.shopify_attributes }}
            >
          {%- endif -%}

          {%- if block.settings.subheading != blank -%}
            <p class="hero__subheading">
              {{ block.settings.subheading }}
            </p>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            {%- liquid
              assign heading_tag = 'h2'

              unless block.settings.heading_tag == 'automatic' or block.settings.heading_tag == blank
                assign heading_tag = block.settings.heading_tag
              endunless
            -%}

            <{{ heading_tag }} class="hero__title {{ block.settings.heading_font_size }}">
              {{ block.settings.title }}
            </{{ heading_tag }}>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="hero__rte {{ block.settings.text_font_size }}">
              {{ block.settings.text }}
            </div>
          {%- endif -%}

        {%- if block.settings.button_text != blank -%}
          {%- liquid
            capture button_classes
              assign button_style = block.settings.button_style
              if button_style == 'btn--text' and block.settings.show_arrow
                assign button_style = button_style | append: ' btn--text-no-underline'
              endif
              echo 'btn ' | append: button_style | append: ' ' | append: block.settings.button_type | append: ' ' | append: block.settings.button_size
            endcapture
          -%}

            <div class="hero__button">
              <a
                href="{{ block.settings.button_url | default: '#!' }}"
                class="{{ button_classes }}"
              >
                <span>{{ block.settings.button_text }}</span>

                {%- if block.settings.show_arrow -%}
                  {%- render 'icon', name: 'caret-right'-%}
                {%- endif -%}
              </a>
            </div>
          {%- endif -%}

          {%- if enable_text_slider -%}
            </swiper-slide>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      <div class="brick__section{% if section.settings.layout == 'is-reversed' %} brick__section--reversed{% endif %}{% if section.settings.reverse_blocks %} brick__section--reversed-mobile{% endif %} {{ width }} {{ desktop_height }} {{ mobile_height }}">
        {%- capture images_markup -%}
          {%- if image_1 != blank or image_2 != blank or show_placeholder -%}
            {{ section_images }}
          {%- elsif request.design_mode -%}
            <div class="brick__section-missing-metafield-image">
              {{ 'products.general.missing_metafield_image' | t }}
            </div>
          {%- endif -%}
        {%- endcapture -%}

        {%- if enable_image_slider -%}
          <div class="brick__block brick__block--images{{ figure_width_class }}">
            <div class="swiper">
              <swiper-container
                breakpoint="(max-width: 749px)"
                {%- if autoplay %}
                  autoplay="{{ autoplay }}"
                  autoplay-delay="{{ autoplay_delay }}"
                  autoplay-disable-on-interaction="false"
                {%- endif -%}
              >
                {{ images_markup }}
              </swiper-container>
            </div>
          </div>
        {%- else -%}
          <div class="brick__block brick__block--images{{ figure_width_class }}">
            {{ images_markup }}
          </div>
        {%- endif -%}

        <div
          class="brick__block brick__block--text{% if enable_slider %} brick__block--slider{% endif %}"
          {% if style != blank %}
            style="{{ style }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="brick__block__text">
            {%- if enable_text_slider -%}
              <div class="hero__content hero__content--compact">
                <div class="swiper">
                  <swiper-container
                    class="grid--mobile-slider"
                    breakpoint="(min-width: 768px)"
                    loop="true"
                    grab-cursor="true"
                    {%- if autoplay %}
                      autoplay="{{ autoplay }}"
                      autoplay-delay="{{ autoplay_delay }}"
                      autoplay-disable-on-interaction="false"
                    {%- endif -%}
                    {%- unless settings.dots_style == 'hidden' -%}
                      pagination="true"
                      pagination-clickable="true"
                      pagination-el=".{{ section.id }}--pagination.swiper-pagination"
                    {%- endunless -%}
                    {% if request.design_mode %}
                      data-block-scroll
                    {% endif %}
                  >
                    {{ content_markup }}
                  </swiper-container>

                  {% unless settings.dots_style == 'hidden' %}
                    <div class="{{ section.id }}--pagination swiper-pagination swiper-pagination-bullets"></div>
                  {% endunless %}
                </div>
              </div>
            {%- else -%}
              <div class="hero__content hero__content--compact hero__content--no-padding">
                {{ content_markup }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- else -%}
    {%- render 'no-blocks' -%}
  {%- endif -%}
  {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
  {%- render 'shape-dividers', mode: 'host' -%}
</section>

{% schema %}
