{%- doc -%}
  Renders the product variant picker: one fieldset per option as buttons, a dropdown or swatches, plus the size chart link.
  Shared by the Product page and Featured product sections and the quick view modal.

  @param {object} product - Product whose variants are picked
  @param {string} product_form_id - Id of the product form the option inputs submit with
  @param {object} [block] - Variants block; its settings set the size chart page and style
  @param {string} [block_style] - Inline style attribute for the block wrapper
  @param {boolean} [enable_size_chart] - Show the size chart link
  @param {boolean} [featured_product] - Rendered by the Featured product section
  @param {string} [unique] - Unique id prefix for the option inputs
  @param {object} [current_variant] - Ignored; the snippet always uses the selected or first available variant
  @param {string} [animation_name] - Animation name for the quick view
  @param {number} [animation_delay] - Animation delay for the quick view
  @param {section} [section] - Parent section; available automatically when rendered from a section

  @example
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id, enable_size_chart: true %}
{%- enddoc -%}

{%- liquid
  assign uniq_id = unique | append: 'product-' | append: product.id | append: '-'
  assign hide_labels_class = ''
  assign current_variant = product.selected_or_first_available_variant
  assign enable_size_chart = enable_size_chart | default: false
  assign show_size_chart = false
  assign tags_string = product.tags | join: ','
  assign size_separator = '_size_'
  assign specific_pages = ''
  assign form_style = settings.form_style
  assign featured_product = featured_product | default: false
  assign meta_products = ''
  assign meta_product_details = ''
  assign meta_swatches = ''
  assign size_style = block.settings.size_chart_style
  assign specific_pages = ''

  assign metaobject_color_entries = null
  if settings.enable_swatches
    assign metaobject_color_entries = metaobjects[settings.theme_color].values | where: 'name'
  endif

  if block.settings.info_page != blank
    assign size_translation = 'general.size_chart.size' | t
    assign info_page = pages[block.settings.info_page]
  endif

  if tags_string contains size_separator
    for tag in product.tags
      if tag contains size_separator
        assign page_handle = tag | split: size_separator | last | split: ',' | first
        assign specific_pages = specific_pages | append: page_handle | append: ','
      endif
    endfor
  endif
-%}

{%- capture size_chart -%}
  {%- if enable_size_chart -%}
    {%- if block.settings.info_page != blank or specific_pages != '' -%}
      {%- liquid
        assign show_size_chart = true
        assign specific_pages_arr = specific_pages | split: ','
      -%}

      {%- capture size_button_options -%}
        <a href="{{ info_page.url }}" data-popup-open class="radio__legend__link body-x-small{% if product.has_only_default_variant %} size-popup-link{% endif %}{% if size_style == 'text' %} text-link{% endif %}">
          {%- case size_style -%}
            {%- when 'text' -%}
              <span class="radio__legend__link__label">
                {{- 'general.size_chart.title' | t -}}
              </span>

            {%- when 'ruler' -%}
              <span class="btn-size-chart">
                {%- render 'icon', name: 'ruler' -%}
              </span>

            {%- when 'question' -%}
              <span class="btn-size-chart">
                {%- render 'icon', name: 'info' -%}
              </span>
          {%- endcase -%}
        </a>
      {%- endcapture -%}

      {%- capture size_chart_link -%}
        {%- render 'stylesheet', name: 'tabs.css', blocking: true -%}

        <popup-component>
          {% comment %}
            <size-chart-button></size-chart-button> will be replaced by size_button_options markup
          {% endcomment %}
          <size-chart-button></size-chart-button>

          <dialog class="product-modal" aria-hidden="true" inert data-scroll-lock-required>
            <form method="dialog">
              <button class="visually-hidden" aria-label="{{ 'general.accessibility.close' | t }}"></button>
            </form>

            <div class="product-modal__outer">
              <div class="product-modal__content small" data-scroll-lock-scrollable>
                <button type="button" class="product-modal__close" data-popup-close aria-label="{{ 'general.accessibility.close' | t }}">
                  {%- render 'icon', name: 'x' -%}
                </button>

                <tabs-component class="rte product-tabs">
                  {%- liquid
                    assign tabs_navigation = ''
                    assign tabs = ''
                    assign has_current = false
                    assign number_tabs = 0
                  -%}

                  {%- for page_handle in specific_pages_arr -%}
                    {%- assign page_size_chart = pages[page_handle] -%}

                    {%- if page_size_chart.title != blank -%}
                      {%- capture tabs_navigation -%}
                        {{ tabs_navigation }}

                        <li class="tab-link tab-link-{{ forloop.index0 }}{% if forloop.index == 1 %} current{% endif %}" data-tab="{{ forloop.index0 }}" tabindex="0">
                          <span>{{ page_size_chart.title }}</span>
                        </li>
                      {%- endcapture -%}

                      {%- capture tabs -%}
                        {{ tabs }}

                        <div class="tab-content tab-content-{{ forloop.index0 }}{% unless has_current %} current{% endunless %}">
                          {{ page_size_chart.content }}
                        </div>
                      {%- endcapture -%}

                      {%- assign has_current = true -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if info_page -%}
                    {%- assign number_tabs = specific_pages_arr.size -%}

                    {%- capture tabs_navigation -%}
                      {{ tabs_navigation }}

                      <li class="tab-link tab-link-{{ number_tabs }}" data-tab="{{ number_tabs }}" data-lock-scroll tabindex="0">
                        <span>{{ info_page.title }}</span>
                      </li>
                    {%- endcapture -%}

                    {%- capture tabs -%}
                      {{ tabs }}

                      <div class="tab-content tab-content-{{ number_tabs }}{% unless has_current %} current{% endunless %}">
                        {{ info_page.content }}
                      </div>
                    {%- endcapture -%}

                    {%- assign has_current = true -%}
                  {%- endif -%}

                  {%- if specific_pages_arr.size > 1 -%}
                    <native-scrollbar class="tabs__head product-tabs__head">
                      <ul class="tabs product-tabs-title" data-scrollbar data-scrollbar-slider data-scroll-lock-scrollable>
                        {{ tabs_navigation }}
                      </ul>

                      <button type="button" class="tabs__arrow tabs__arrow--prev" data-scrollbar-arrow-prev disabled>
                        {%- render 'icon', name: 'caret-left' -%}
                        <span class="visually-hidden">{{ 'products.general.see_all' | t }}</span>
                      </button>

                      <button type="button" class="tabs__arrow tabs__arrow--next" data-scrollbar-arrow-next disabled>
                        {%- render 'icon', name: 'caret-right' -%}
                        <span class="visually-hidden">{{ 'products.general.see_all' | t }}</span>
                      </button>
                    </native-scrollbar>
                  {%- endif -%}

                  {%- if tabs != '' -%}
                    {{ tabs }}
                  {%- endif -%}
                </tabs-component>
              </div>
            </div>
          </dialog>
        </popup-component>
      {%- endcapture -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture product_variant_options -%}
  {%- if settings.show_labels == false -%}
    {%- assign hide_labels_class = ' variant__labels--hide' -%}
  {%- endif -%}

  {%- capture form_fields -%}
    {%- unless product.has_only_default_variant -%}
      {%- assign options_html = '' -%}
      <div class="product__selectors">
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign current_value = current_variant.options[forloop.index0]
            assign option_name = option.name
            assign option_name_string = option.name

            assign option_name_handle_separator = option_name | handle | prepend: ',' | append: ','

            comment
              Determine if current option matches size handle translations
            endcomment
            assign is_size_option = false
            assign size_translation = 'general.size_chart.size' | t
            assign translation_string_size = size_translation | remove: '  ' | replace: ', ', ',' | replace: ' ,', ',' | replace: ',', '____' | handle | replace: '____', ',' | append: ',' | prepend: ','

            if translation_string_size contains option_name_handle_separator
              assign is_size_option = true
            endif

            comment
              Determine if current option matches swatch handle translations
            endcomment
            assign is_native_swatch_option = false
            assign is_theme_swatch_option = false

            if settings.enable_swatches
              for value in option.values
                if value.swatch
                  assign is_native_swatch_option = true
                  break
                endif
              endfor


              assign swatch_translation = 'general.swatches.color' | t
              assign translation_string = swatch_translation | remove: '  ' | replace: ', ', ',' | replace: ' ,', ',' | replace: ',', '____' | handle | replace: '____', ',' | append: ',' | prepend: ','
              if translation_string contains option_name_handle_separator
                assign is_theme_swatch_option = true
              endif
            endif

            assign picker_type = 'button'
            if is_native_swatch_option or is_theme_swatch_option
              assign picker_type = 'swatch'
            elsif settings.variant_boxes == false
              assign picker_type = 'dropdown'
            endif

            comment
              Determine if current option should show stacked variant images
            endcomment
            assign has_variant_option_image = false
            if settings.show_variant_image and picker_type == 'button'
              assign variant_option_image_translation = 'products.product.variant_option_image' | t
              assign translation_string_variant_option_image = variant_option_image_translation | remove: '  ' | replace: ', ', ',' | replace: ' ,', ',' | replace: ',', '____' | handle | replace: '____', ',' | append: ',' | prepend: ','

              if translation_string_variant_option_image contains option_name_handle_separator
                assign has_variant_option_image = true
              endif
            endif

            capture fieldset_class
              if settings.variant_boxes or is_native_swatch_option or is_theme_swatch_option
                echo 'radio__fieldset'

                if is_native_swatch_option or is_theme_swatch_option
                  echo ' radio__fieldset--swatches'
                endif

                if has_variant_option_image
                  echo ' radio__fieldset--variant-option-image'
                endif
              else
                echo 'select__fieldset'
              endif
            endcapture

            comment
              Variables for colors split
            endcomment
            assign show_default_swatches = false
            assign default_swatches_checked = false
            assign color_swatches = ''
            assign swatch_group_array = ''
          -%}

          {%- if picker_type == 'swatch' -%}
            {%- for value in option.values -%}
              {%- assign swatch_group = '' -%}
              {%- if value.variant != blank -%}
                {%- if value.variant.metafields.theme.swatch_group != blank -%}
                  {%- assign swatch_group = value.variant.metafields.theme.swatch_group -%}
                {%- endif -%}
              {%- endif -%}

              {%- capture value_swatch -%}
                {% render 'product-variant-option',
                  product: product,
                  product_form_id: product_form_id,
                  index: forloop.index0,
                  value: value,
                  option: option,
                  picker_type: picker_type,
                  metaobject_color_entries: metaobject_color_entries
                %}
              {%- endcapture -%}

              {%- if swatch_group != '' -%}
                {%- assign swatch_group_array = swatch_group_array | append: '@@@@' | append: swatch_group | append: '####' | append: value_swatch -%}
              {%- else -%}
                {%- assign show_default_swatches = true -%}

                {%- if value.selected -%}
                  {%- assign default_swatches_checked = true -%}
                {%- endif -%}

                {%- capture color_swatches -%}
                  {{ color_swatches }}

                  {{ value_swatch }}
                {%- endcapture -%}
              {%- endif -%}
            {%- endfor -%}

            {%- assign swatch_group_array = swatch_group_array | remove_first: '@@@@' | split: '@@@@' | sort -%}
          {%- endif -%}

          {%- capture options_html -%}
            {{ options_html }}

            {%- if picker_type != 'swatch' or show_default_swatches -%}
              <div
                class="selector-wrapper{% if settings.variant_boxes and is_size_option %} selector-wrapper--size{% elsif settings.variant_boxes or is_theme_swatch_option %} selector-wrapper--fullwidth{% endif %}"
                data-variant-buttons
                data-option-position="{{ option.position }}"
              >
                {%- if picker_type == 'swatch' -%}
                  <fieldset class="product-form__input">
                    <div class="radio__buttons radio__buttons--top radio__buttons--swatches" data-variant-buttons>
                      {{ color_swatches }}
                    </div>
                  </fieldset>
                {%- elsif picker_type == 'button' -%}
                  <fieldset class="product-form__input">
                    {% render 'product-variant-options',
                      product: product,
                      product_form_id: product_form_id,
                      option: option,
                      picker_type: picker_type,
                      has_variant_option_image: has_variant_option_image,
                      metaobject_color_entries: metaobject_color_entries
                    %}
                  </fieldset>
                {%- elsif picker_type == 'dropdown' -%}
                  <popout-select class="select-popout product-form__input">
                    <button
                      type="button"
                      class="select-popout__toggle"
                      aria-expanded="false"
                      aria-controls="{{ uniq_id }}-select-{{ option.name | handle }}"
                      aria-labelledby="{{ uniq_id }}-select-{{ option.name | handle }}-label"
                      data-select-soldout=" - {{ 'products.product.sold_out' | t }}"
                      data-select-unavailable=" - {{ 'products.product.unavailable' | t }}"
                      data-popout-toggle
                    >
                      <span data-popout-toggle-text>{{ option.selected_value }}</span>
                      {%- render 'icon', name: 'caret-down' -%}
                    </button>

                    {% render 'product-variant-options',
                      product: product,
                      product_form_id: product_form_id,
                      option: option,
                      picker_type: picker_type,
                      metaobject_color_entries: metaobject_color_entries
                    %}
                  </popout-select>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endcapture -%}

          {%- capture swatch_group_html -%}
            {%- if swatch_group_array.size > 0 and picker_type == 'swatch' -%}
              {%- assign previous_prefix = '' -%}
              {%- assign group = '' -%}
              {%- for swatch_group_option in swatch_group_array -%}
                {%- assign parts = swatch_group_option | split: '####' -%}
                {%- assign prefix = parts | first -%}
                {%- assign suffix = parts | last -%}
                {%- assign next_item = swatch_group_array[forloop.index] -%}

                {% if next_item %}
                  {% assign next_prefix = next_item | split: "####" | first %}
                {% else %}
                  {% assign next_prefix = "" %}
                {% endif %}

                {%- capture group -%}
                  {{ group }}
                  {{ suffix }}
                {%- endcapture -%}

                {% if prefix != next_prefix %}
                  <fieldset>
                    <div class="{{ fieldset_class }}">

                      {%- capture group_legend -%}
                        <legend class="radio__legend">
                          <span class="radio__legend__label{% if size_style == 'text' %} radio__legend__label--text{% endif %}">
                            <span class="radio__legend__option-name">
                              {{ prefix }}
                            </span>

                            {%- if settings.show_labels and group contains 'data-swatch-input-checked' -%}
                              <small class="radio__legend__value">
                                {%- if group contains 'data-swatch-input-checked' -%}
                                  <span data-option-value="{{ option.position }}">{{ current_value }}</span>
                                {%- endif -%}
                              </small>
                            {%- endif -%}
                          </span>
                        </legend>
                      {%- endcapture -%}

                      {%- capture group_swatches -%}
                        <div
                          class="selector-wrapper{% if settings.variant_boxes or is_theme_swatch_option %} selector-wrapper--fullwidth{% endif %}"
                        >
                          <fieldset class="product-form__input">
                            <div class="radio__buttons radio__buttons--top radio__buttons--swatches">
                              {{ group }}
                              {%- assign group = '' -%}
                            </div>
                          </fieldset>
                        </div>
                      {%- endcapture -%}

                      {%- if form_style == 'modern' -%}
                        <div class="fieldset__column fieldset__column--aside">
                          {{ group_legend }}
                        </div>

                        <div class="fieldset__column fieldset__column--content">
                          {{ group_swatches }}
                        </div>
                      {%- else -%}
                        {{ group_legend }}

                        {{ group_swatches }}
                      {%- endif -%}
                    </div>
                  </fieldset>
                {% endif %}

                {% assign previous_prefix = prefix %}
              {%- endfor -%}
            {%- endif -%}
          {%- endcapture -%}

          <div class="selector-wrapper{% if settings.variant_boxes and is_size_option %} selector-wrapper--size{% elsif settings.variant_boxes %} selector-wrapper--fullwidth{% endif %}"
            data-option-position="{{ option.position }}"
          >
            {%- if picker_type != 'swatch' or show_default_swatches -%}
              <fieldset>
                <div class="{{ fieldset_class }}">
                  {%- if form_style == 'modern' -%}
                    <div class="fieldset__column fieldset__column--aside">
                  {%- endif -%}

                  <legend class="radio__legend{% if is_size_option and size_chart_link %} radio__legend--size{% endif %}">
                    <span class="radio__legend__label{% if size_style == 'text' %} radio__legend__label--text{% endif %}" id="{{ uniq_id }}-select-{{ option.name | handle }}-label">
                      {%- if option_name_string != '' -%}
                        <span class="radio__legend__option-name">
                          {{ option_name_string }}
                        </span>
                      {%- endif -%}

                      {%- if is_size_option -%}
                        {{- size_chart_link | replace: '<size-chart-button></size-chart-button>', size_button_options -}}
                      {%- endif -%}

                      {%- if settings.show_labels -%}
                        {%- if default_swatches_checked or picker_type != 'swatch' or show_default_swatches -%}
                          <small class="radio__legend__value">
                            {%- if default_swatches_checked or picker_type != 'swatch' -%}
                              <span data-option-value="{{ option.position }}">{{ current_value }}</span>
                            {%- endif -%}
                          </small>
                        {%- endif -%}
                      {%- endif -%}
                    </span>
                  </legend>
            {%- endif -%}

            {%- if form_style == 'classic' -%}
              {{ options_html }}
              {%- assign options_html = '' -%}
            {%- endif -%}

            {%- if picker_type != 'swatch' or show_default_swatches -%}
                  {%- if form_style == 'modern' -%}
                    </div>

                    <div class="fieldset__column fieldset__column--content">
                      {{ options_html }}
                      {%- assign options_html = '' -%}
                    </div>
                  {%- endif -%}
                </div>
              </fieldset>
            {%- endif -%}

            {{ swatch_group_html }}
          </div>
        {%- endfor -%}
      </div>

    {%- endunless -%}
  {%- endcapture -%}

  {{- form_fields -}}
{%- endcapture -%}

{%- if product_variant_options != blank -%}
  <div
    class="product__block{% if settings.show_lines %} product__block--lines{% endif %} product__form__holder block-padding"
    {{ block_style }}
    {{ block.shopify_attributes }}
    {% if animation_name %}
      data-animation="{{ animation_name }}"
      data-animation-delay="{{ animation_delay }}"
    {% endif %}
  >
    <div class="product__form__outer{{ hide_labels_class }}">
      <variant-selects
        id="variant-selects-{{ section.id }}"
        data-section="{{ section.id }}"
        {{ block.shopify_attributes }}
      >
        {{ product_variant_options }}

        <script type="application/json" data-selected-variant>
          {{ product.selected_or_first_available_variant | json }}
        </script>
      </variant-selects>
    </div>
  </div>
{%- endif -%}

{%- if request.design_mode and product_variant_options == blank -%}
  <div {{ block.shopify_attributes }}></div>
{%- endif -%}
