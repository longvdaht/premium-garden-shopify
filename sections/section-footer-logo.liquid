{%- doc -%}
  Full-width logo section for the footer group.

  Dependencies:
  - CSS: section-footer-logo.css
  - Snippets: image, stylesheet
{%- enddoc -%}

{%- liquid
  assign unique = 'FooterLogo--' | append: section.id
  assign animation_anchor = unique
  assign animation_order = 1
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign logo = section.settings.logo
  assign badge_blocks = section.blocks | where: 'type', 'badges'
-%}

{%- style -%}
  #{{ unique }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- render 'stylesheet', name: 'section-footer-logo.css' -%}

<section
  id="{{ unique }}"
  class="footer-logo section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="footer-logo"
  {% if badge_blocks != blank %}data-badge-host{% endif %}
>
  <div class="wrapper--full-padded">
    <a
      href="{{ routes.root_url }}"
      class="footer-logo__link"
      aria-label="{{ 'general.accessibility.footer_logo' | t }}"
      data-aos="hero"
      data-aos-anchor="{{ animation_anchor }}"
      data-aos-order="{{ animation_order }}"
    >
      {%- if logo != blank -%}
        {%- render 'image',
          image: logo,
          sizes: '(min-width: 990px) calc(100vw - 100px), (min-width: 750px) calc(100vw - 60px), calc(100vw - 32px)',
          show_backfill: false,
          alt: shop.name
        -%}
      {%- else -%}
        {{ 'logo' | placeholder_svg_tag: 'svg-placeholder' }}
      {%- endif -%}
    </a>
  </div>

  {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
</section>

{% schema %}
{
  "name": "Full width logo",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Image",
      "info": "3200 x 1200px .jpg recommended. [Learn more](http://presidiodev.com/link/headlands/images)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "badges",
      "name": "Badges",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "badge_width",
          "label": "Badge width",
          "min": 100,
          "max": 300,
          "step": 10,
          "unit": "px",
          "default": 180
        },
        {
          "type": "checkbox",
          "id": "half_width_mobile",
          "label": "Half width on mobile",
          "default": true
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New"
        },
        {
          "type": "select",
          "id": "shape",
          "label": "Shape",
          "default": "circle",
          "options": [
            {
              "value": "fit-to-text",
              "label": "Fit to text"
            },
            {
              "value": "circle",
              "label": "Circle"
            },
            {
              "value": "diamond",
              "label": "Diamond"
            },
            {
              "value": "oval",
              "label": "Oval"
            },
            {
              "value": "scalloped-1",
              "label": "Scalloped circle 1"
            },
            {
              "value": "scalloped-2",
              "label": "Scalloped circle 2"
            },
            {
              "value": "semicircle",
              "label": "Semicircle"
            },
            {
              "value": "star-1",
              "label": "Star 1"
            },
            {
              "value": "star-2",
              "label": "Star 2"
            }
          ]
        },
        {
          "type": "select",
          "id": "heading_font_size",
          "label": "Heading size",
          "default": "heading-x-small",
          "options": [
            {
              "value": "heading-mini",
              "label": "Mini"
            },
            {
              "value": "heading-x-small",
              "label": "Extra small"
            },
            {
              "value": "heading-small",
              "label": "Small"
            },
            {
              "value": "heading-medium",
              "label": "Medium"
            },
            {
              "value": "heading-large",
              "label": "Large"
            },
            {
              "value": "heading-x-large",
              "label": "Extra large"
            }
          ]
        },
        {
          "type": "header",
          "content": "Custom image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the shape and text. 400 x 400px recommended."
        },
        {
          "type": "header",
          "content": "Position"
        },
        {
          "type": "range",
          "id": "position_x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 85
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 15
        },
        {
          "type": "range",
          "id": "rotate",
          "label": "Rotate",
          "min": -90,
          "max": 90,
          "step": 2,
          "unit": "deg",
          "default": 0
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "checkbox",
          "id": "show_on_mobile",
          "label": "Show on mobile",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_on_desktop",
          "label": "Show on desktop",
          "default": true
        },
        {
          "type": "header",
          "content": "Animation"
        },
        {
          "type": "select",
          "id": "animation",
          "label": "Animation",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "rotate",
              "label": "Rotate"
            },
            {
              "value": "rotate-scroll",
              "label": "Rotate on scroll"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "enable_parallax",
          "label": "Enable parallax",
          "info": "When enabled badges will scroll faster than the rest of the page.",
          "default": false
        },
        {
          "type": "range",
          "id": "parallax_speed",
          "label": "Parallax speed",
          "visible_if": "{{ block.settings.enable_parallax == true }}",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 3
        },
        {
          "type": "header",
          "content": "Color"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Full width logo"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
