          "type": "color_scheme",
          "id": "color_scheme",
          "default": "scheme-3",
          "label": "Color scheme"
        },
        {
          "type": "checkbox",
          "id": "pin_to_bottom",
          "label": "Pin to bottom",
          "default": false
