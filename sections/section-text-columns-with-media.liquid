<!-- /sections/section-text-columns-with-media.liquid -->

{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign unique = 'SectionTextColumnsWithMedia--' | append: section.id
  assign animation_order = 0
  assign animation_anchor = unique
  assign heading = section.settings.title
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign blocks_size = content_section_blocks.size
  assign show_video_background = false

  assign layout = section.settings.layout
  assign layout_mobile = section.settings.layout_mobile
  assign grid_columns = section.settings.grid

  assign multicolumn = true
  if layout
    assign multicolumn = false
  endif

  assign enable_slider = false
  if layout == 'slider'
    assign enable_slider = true
  endif

  assign has_slider = false
  if layout == 'slider' or layout_mobile == 'slider'
    assign has_slider = true
  endif

  assign scroller_id = unique | append: '-scroller'

  if multicolumn
    assign column_count = blocks_size | at_least: 2
    assign column_count_float = column_count | times: 1.000000
    assign column_width = 100 | divided_by: column_count_float
  else
    assign columns_desktop = grid_columns | plus: 0
    assign columns_medium = 3
    assign columns_small = 2

    if columns_desktop == 2 or columns_desktop == 4
      assign columns_medium = 2
    endif

    assign column_width = 100 | divided_by: columns_desktop
  endif

  assign columns_mobile = layout_mobile | plus: 0

  if heading != blank
    assign has_content = true
  endif

  assign eager_images_limit = grid_columns | default: 3

  if grid_columns == 4
    assign eager_images_limit = grid_columns | times: 2
  endif

  capture layout_class
    echo 'grid'

    if multicolumn
      echo ' multicolumn'
    endif

    if layout == 'slider'
      echo ' grid--slider'
    endif

    if layout_mobile == 'slider'
      echo ' grid--mobile-slider'
    endif
  endcapture
-%}

{%- render 'stylesheet', name: 'multicolumn.css' -%}

{%- style -%}
  #{{ unique }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    {%- unless multicolumn or enable_slider -%}
      --COLUMNS: {{ columns_desktop }};
      --COLUMNS-MEDIUM: {{ columns_medium }};
      --COLUMNS-SMALL: {{ columns_small }};
    {%- endunless -%}

    --COLUMNS-MOBILE: {{ columns_mobile }};
  }
{%- endstyle -%}

<div
  id="{{ unique }}"
  class="section-columns section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="columns"
  {% if shape_divider_blocks != blank %}data-shape-divider-host{% endif %}
  {% if badge_blocks != blank %}data-badge-host{% endif %}
>
  <div class="{{ section.settings.width }}">
    {%- if has_content -%}
      <div class="grid__heading-holder {{ section.settings.align_heading }}">
        {%- if heading != blank -%}
          {%- liquid
            assign animation_order = animation_order | plus: 1
            assign heading_tag = 'h2'

            unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
              assign heading_tag = section.settings.heading_tag
            endunless
          -%}

          <{{ heading_tag }}
            class="grid__heading {{ section.settings.heading_font_size }}"
            data-aos="hero"
            data-aos-anchor="{{ animation_anchor }}"
            data-aos-order="{{ animation_order }}"
          >
            {{- heading -}}
          </{{ heading_tag }}>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if blocks_size > 0 -%}
      {%- capture columns_content -%}
        <div class="{{ layout_class }} {{ section.settings.align_columns }} {{ section.settings.align_text }}"
          {% if has_slider %}
            id="{{ scroller_id }}"
            data-grid-slider
          {% endif %}

          {% if request.design_mode %}
            data-block-scroll
          {% endif %}
        >
          {%- for block in content_section_blocks -%}
            {%- liquid
              assign animation_order = animation_order | plus: 1
              assign title = block.settings.title
              assign text = block.settings.text
              assign image = block.settings.image
              assign image_aspect_ratio = block.settings.image_aspect_ratio | default: 1
              assign image_aspect_ratio_mobile = block.settings.mobile_image_aspect_ratio | default: aspect_ratio
              assign aspect_ratio = 1 | divided_by: image_aspect_ratio
              assign aspect_ratio_mobile = 1 | divided_by: image_aspect_ratio_mobile
              assign button_text = block.settings.button_text
              assign column_content = ''

              if forloop.index > eager_images_limit and layout != 'slider' or forloop.index > 4 and layout == 'slider'
                assign loading = 'lazy'
              endif

              if enable_slider
                assign column_width = 33.333333
              endif

              assign column_width_multiplier = column_width | times: 0.01

              capture button_classes
                assign button_style = block.settings.button_style
                if button_style == 'btn--text' and block.settings.show_arrow
                  assign button_style = button_style | append: ' btn--text-no-underline'
                endif
                echo 'btn ' | append: button_style | append: ' ' | append: block.settings.button_type | append: ' ' | append: block.settings.button_size
              endcapture

              capture image_sizes
                echo '(min-width: 990px) calc((100vw - 100px) * ' | append: column_width_multiplier | append: '), (min-width: 750px) calc((100vw - 60px) / 2), calc(100vw - 32px - 50px)'
              endcapture

              capture block_style
                echo 'style="'

                if multicolumn
                  echo '--desktop-width: ' | append: column_width | append: '%;'
                endif

                echo '"'
              endcapture
            -%}

            {%- if title != blank or text != blank or button_text != blank -%}
              {%- capture column_content -%}
                <div class="column__content grid-item__content">
                  {%- if title != blank -%}
                    {%- liquid
                      assign heading_tag = 'h2'

                      unless block.settings.heading_tag == 'automatic' or block.settings.heading_tag == blank
                        assign heading_tag = block.settings.heading_tag
                      endunless
                    -%}

                    <{{ heading_tag }} class="column__heading {{ block.settings.heading_font_size }}">
                      {{- title -}}
                    </{{ heading_tag }}>
                  {%- endif -%}

                  {%- if text != blank -%}
                    <div class="column__text rte {{ block.settings.text_font_size }}">
                      {{- text -}}
                    </div>
                  {%- endif -%}

                  {%- if button_text != blank -%}
                    <div class="column__btn">
                      <a href="{{ block.settings.button_url | default: '#!' }}" class="{{ button_classes }}" aria-label="{{ button_text }}">
                        <span>{{ button_text }}</span>

                        {%- if block.settings.show_arrow -%}
                          {%- render 'icon', name: 'caret-right'-%}
                        {%- endif -%}
                      </a>
                    </div>
                  {%- endif -%}
                </div>
              {%- endcapture -%}
            {%- endif -%}

            {%- case block.type -%}
              {%- when 'video' -%}
                {%- assign video = block.settings.video -%}

                <div class="grid-item"
                  {{ block_style }}
                  {% if enable_slider %}
                    data-grid-item
                  {% endif %}
                  {% if has_slider %}
                    data-slider-progress-item
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  <div class="column__inner"
                    data-aos="hero"
                    data-aos-anchor="{{ animation_anchor }}"
                    data-aos-order="{{ animation_order }}">
                    <div class="column__image" data-column-image>
                      {%- capture column_video -%}
                        <div
                          class="video-background image-height image-height--mobile"
                          style="--aspect-ratio: {{ aspect_ratio }}; --aspect-ratio-mobile: {{ aspect_ratio_mobile }};"
                        >
                          {%- if video != null -%}
                            {%- unless show_video_background -%}
                              {%- assign show_video_background = true -%}

                              <script src="{{ 'video-background.js' | asset_url }}" defer="defer"></script>
                            {%- endunless -%}

                            <video-background
                              class="video__player"
                              data-video-player
                              data-video-id="{{ section.id }}-video-background"
                            >
                              <template data-video-template>
                                {{ video | video_tag: image_size: '500x', autoplay: true, loop: true, muted: true, controls: false }}
                              </template>
                            </video-background>
                          {%- else -%}
                            {%- liquid
                              assign class_desktop = ''
                              assign class_mobile = ''

                              if aspect_ratio != aspect_ratio_mobile
                                assign class_desktop = 'desktop'
                                assign class_mobile = 'mobile'
                              endif

                              render 'image' placeholder: 'image', aspect_ratio: aspect_ratio, modifier: class_desktop

                              if aspect_ratio != aspect_ratio_mobile
                                render 'image' placeholder: 'image', aspect_ratio: aspect_ratio_mobile, modifier: class_mobile
                              endif
                            -%}
                          {%- endif -%}
                        </div>
                      {%- endcapture -%}

                      {%- if block.settings.button_url != blank and button_text == blank -%}
                        <a href="{{ block.settings.button_url }}" aria-label="{{ image.alt | default: title | default: text | strip_html | escape }}">
                          {{ column_video }}
                        </a>
                      {%- else -%}
                        {{ column_video }}
                      {%- endif -%}
                    </div>

                    {%- if column_content != '' -%}
                      {{ column_content }}
                    {%- endif -%}
                  </div>
                </div>

              {%- when 'image' -%}
                <div class="grid-item"
                  {{ block_style }}
                  {% if enable_slider %}
                    data-grid-item
                  {% endif %}
                  {% if has_slider %}
                    data-slider-progress-item
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  <div class="column__inner"
                    data-aos="hero"
                    data-aos-anchor="{{ animation_anchor }}"
                    data-aos-order="{{ animation_order }}">
                    <div class="column__image" data-column-image>
                      {%- liquid
                        capture column_image
                          assign class_desktop = ''
                          assign class_mobile = ''

                          if aspect_ratio != aspect_ratio_mobile
                            assign class_desktop = 'desktop'
                            assign class_mobile = 'mobile'
                          endif

                          if image
                            render 'image' image: image, sizes: image_sizes, aspect_ratio: aspect_ratio, loading: loading, modifier: class_desktop

                            if aspect_ratio != aspect_ratio_mobile
                              render 'image' image: image, sizes: image_sizes, aspect_ratio: aspect_ratio_mobile, loading: loading, modifier: class_mobile
                            endif
                          else
                            render 'image' placeholder: 'image', aspect_ratio: aspect_ratio, modifier: class_desktop

                            if aspect_ratio != aspect_ratio_mobile
                              render 'image' placeholder: 'image', aspect_ratio: aspect_ratio_mobile, modifier: class_mobile
                            endif
                          endif
                        endcapture
                      -%}

                      {%- if block.settings.button_url != blank and button_text == blank -%}
                        <a href="{{ block.settings.button_url }}" aria-label="{{ image.alt | default: title | default: text | strip_html | escape }}">
                          {{ column_image }}
                        </a>
                      {%- else -%}
                        {{ column_image }}
                      {%- endif -%}
                    </div>

                    {%- if column_content != '' -%}
                      {{ column_content }}
                    {%- endif -%}
                  </div>
                </div>

            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endcapture -%}

      {%- if enable_slider -%}
        <grid-slider align-arrows>
          <div class="slider__arrows">
            <button
              type="button"
              class="slider__button slider__button--prev"
              data-button-arrow
              data-button-prev
            >
              {{ 'general.pagination.prev' | t }}
            </button>
            <button
              type="button"
              class="slider__button slider__button--next"
              data-button-arrow
              data-button-next
            >
              {{ 'general.pagination.next' | t }}
            </button>
          </div>

          {{ columns_content }}
        </grid-slider>
      {%- else -%}
        {{ columns_content }}
      {%- endif -%}

      {%- if has_slider -%}
        <slider-progress for="{{ scroller_id }}"{% if layout == 'slider' %} data-desktop-slider{% endif %}{% if layout_mobile == 'slider' %} data-mobile-slider{% endif %}>
          <div class="slider-progress__container" data-slider-progress hidden>
            <div class="slider-progress__track">
              <div class="slider-progress__fill" data-slider-progress-fill style="--slider-progress: 0;"></div>
            </div>
            <div class="slider-progress__counter body-x-small" data-slider-counter aria-live="polite"></div>
          </div>
        </slider-progress>
      {%- endif -%}
    {%- endif -%}

    {%- if blocks_size == 0 -%}
      {%- render 'no-blocks' -%}
    {%- endif -%}
  </div>
  {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
  {%- render 'shape-dividers', mode: 'host' -%}
</div>

