{%- doc -%}
  Renders the spinning loader shown while a product is being added to the cart.

  @param {string} [class] - Extra classes for the SVG, added before "svg-loader"

  @example
  <span class="btn__loader">{%- render 'svg-loader' -%}</span>
{%- enddoc -%}

{%- liquid
  assign svg_class = 'svg-loader'
  if class != blank
    assign svg_class = class | append: ' ' | append: svg_class
  endif
-%}

<svg height="18" width="18" class="{{ svg_class }}" aria-hidden="true" focusable="false">
  <circle r="7" cx="9" cy="9" />
  <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
</svg>
