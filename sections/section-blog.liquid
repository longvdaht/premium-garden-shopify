<!-- /sections/section-blog.liquid -->
{%- liquid
  assign blog = blogs[section.settings.blog_name]
  assign blog_title = section.settings.title

  # Potager: "Guides for this product" (product template). Picked guides
  # (product.metafields.content.related_articles) first; otherwise the newest
  # guides tagged with one of the product's collections. No guides, no section.
  assign use_product_guides = false
  if section.settings.source == 'product' and product != blank
    assign use_product_guides = true
    assign guide_limit = section.settings.grid | times: section.settings.rows
    assign product_guides = product.metafields.content.related_articles.value

    if product_guides == blank or product_guides.size == 0
      assign product_guides = blog.articles | where: 'id', 0
      assign collection_handles = product.collections | map: 'handle'
      for article in blog.articles limit: 50
        if product_guides.size >= guide_limit
          break
        endif
        for tag in article.tags
          assign tag_handle = tag | handleize
          if collection_handles contains tag_handle
            assign one_article = blog.articles | where: 'id', article.id
            assign product_guides = product_guides | concat: one_article
            break
          endif
        endfor
      endfor
    endif
  endif
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign heading_tag = 'h2'
  assign articles_per_row = section.settings.grid
  assign columns_medium = 3
  if articles_per_row == 2 or articles_per_row == 4
    assign columns_medium = 2
  endif

  unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
    assign heading_tag = section.settings.heading_tag
  endunless

-%}

{%- if use_product_guides and product_guides.size == 0 -%}
  {%- comment -%} Potager: no guides for this product, so the section stays blank {%- endcomment -%}
{%- else -%}
{%- render 'stylesheet', name: 'blog.css' -%}
{%- render 'stylesheet', name: 'article.css' -%}

{%- style -%}
  #Blog--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    --COLUMNS: {{ articles_per_row }};
    --COLUMNS-MEDIUM: {{ columns_medium }};
  }
{%- endstyle -%}

<section
  id="Blog--{{ section.id }}"
  class="{{ section.settings.width }} blog-section section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="blog"
  data-shape-divider-root
>
  {%- content_for 'blocks' -%}

  {% if blog_title != blank %}
    {%- if section.settings.view_all_text != blank -%}<div class="blog__heading">{%- endif -%}
    <{{ heading_tag }} class="page__heading blog__title {{ section.settings.heading_font_size }}"
      ><a href="{{ blog.url | default: '#' }}">{{ blog_title }}</a></{{ heading_tag }}
    >
    {%- if section.settings.view_all_text != blank -%}
      <a href="{{ blog.url | default: '#' }}" class="ds-cta">{{ section.settings.view_all_text | escape }}</a>
      </div>
    {%- endif -%}
  {% endif %}

  {%- if use_product_guides -%}
    {%- render 'blog-posts', blog_articles: product_guides, is_blog_page: false, use_given_articles: true -%}
  {%- else -%}
    {%- render 'blog-posts', blog_articles: blog.articles, is_blog_page: false -%}
  {%- endif -%}
</section>
{%- endif -%}

