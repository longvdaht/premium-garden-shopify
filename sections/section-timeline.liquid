<!-- /sections/section-timeline.liquid -->

{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign unique = 'Timeline--' | append: section.id
  assign show_images = section.settings.show_images
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign dot_background = section.settings.dot_background
  assign title = section.settings.title
  assign text = section.settings.text
  assign animation_anchor = unique
  assign animation_order = 0
-%}

{%- render 'stylesheet', name: 'section-timeline.css' -%}

<script src="{{ 'section-timeline.js' | asset_url }}" defer="defer"></script>

<section
  id="{{ unique }}"
  class="timeline{% if show_images %} timeline--images{% endif %} section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="timeline"
  {% if shape_divider_blocks != blank %}data-shape-divider-host{% endif %}
  {% if badge_blocks != blank %}data-badge-host{% endif %}
>
  <div class="{% if show_images %}{{ section.settings.width }}{% else %}wrapper--narrow{% endif %}">
    <div class="timeline__wrapper">
      {%- if title != blank or text != blank -%}
        <div class="timeline__head hero__content__wrapper {{ section.settings.text_alignment }}">
          <div class="hero__content hero__content--compact">
            {%- if title != blank -%}
              {%- liquid
                assign animation_order = animation_order | plus: 1
                assign heading_tag = 'h2'

                unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
                  assign heading_tag = section.settings.heading_tag
                endunless
              -%}

              <{{ heading_tag }}
                class="hero__title {{ section.settings.heading_font_size }}"
                data-aos="hero"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-order="{{ animation_order }}"
              >
                {{ title }}
              </{{ heading_tag }}>
            {%- endif -%}

            {%- if text != blank -%}
              {%- assign animation_order = animation_order | plus: 1 -%}
              <div
                class="hero__rte {{ section.settings.text_font_size }}"
                data-aos="hero"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-order="{{ animation_order }}"
              >
                {{ text }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <timeline-component class="timeline__body">
        <div
          class="timeline__inner"
          data-timeline-rows
          data-aos="hero"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-order="{{ animation_order }}"
          {% if request.design_mode %}
            data-block-scroll
          {% endif %}
        >
          {%- assign blocks_counter = 0 -%}
          {%- for block in content_section_blocks -%}
            {%- if block.settings.subheading != blank
              or block.settings.title != blank
              or block.settings.text != blank
              or block.settings.button_text != blank
            -%}
              {%- assign blocks_counter = blocks_counter | plus: 1 -%}
              {%- assign animation_order = animation_order | plus: 1 -%}

              {%- capture row_contents -%}
                {{ row_contents }}

                <div
                  class="timeline__row{% if blocks_counter == 1 %} is-selected{% endif %}"
                  data-timeline-row-content
                  {{ block.shopify_attributes }}
                >
                  <div class="timeline__content">
                    <div
                      class="timeline__content__inner"
                      data-aos="hero"
                      data-aos-anchor="{{ animation_anchor }}"
                      data-aos-order="{{ animation_order }}"
                      data-target-index="{{ blocks_counter }}"
                    >
                      {%- if block.settings.subheading != blank -%}
                        <div class="timeline__reveal-container">
                          <p class="timeline__subheading hero__subheading">{{ block.settings.subheading }}</p>
                        </div>
                      {%- endif -%}

                      {%- if block.settings.title != blank -%}
                        {%- liquid
                          assign heading_tag = 'h2'

                          unless block.settings.heading_tag == 'automatic' or block.settings.heading_tag == blank
                            assign heading_tag = block.settings.heading_tag
                          endunless
                        -%}

                        <{{ heading_tag }}
                          class="timeline__title hero__title {{ block.settings.heading_font_size }}"
                        >
                          <button type="button" class="timeline__title__button" data-timeline-title>
                            {{- block.settings.title -}}
                          </button>
                        </{{ heading_tag }}>
                      {%- endif -%}

                      <div class="timeline__reveal-container">
                        <div class="timeline__reveal-inner">
                          <div class="timeline__indicator">
                            <span class="timeline__indicator__line">&nbsp;</span>
                          </div>

                          {%- if block.settings.text != blank -%}
                            <div class="hero__rte {{ block.settings.text_font_size }}">
                              {{ block.settings.text }}
                            </div>
                          {%- endif -%}

                          {%- if block.settings.button_text != blank -%}
                            {%- liquid
                              capture button_classes
                                assign button_style = block.settings.button_style
                                if button_style == 'btn--text' and block.settings.show_arrow
                                  assign button_style = button_style | append: ' btn--text-no-underline'
                                endif
                                echo 'btn ' | append: button_style | append: ' ' | append: block.settings.button_type | append: ' ' | append: block.settings.button_size
                              endcapture
                            -%}

                            <div class="hero__button">
                              <a
                                href="{{ block.settings.button_url | default: '#!' }}"
                                class="{{ button_classes }}"
                              >
                                <span>{{ block.settings.button_text }}</span>

                                {%- if block.settings.show_arrow -%}
                                  {%- render 'icon', name: 'caret-right' -%}
                                {%- endif -%}
                              </a>
                            </div>
                          {%- endif -%}

                          {%- if show_images -%}
                            <div class="timeline__image mobile">
                              {%- liquid
                                assign image_modifier = 'timeline__image-figure'
                                render 'image', image: block.settings.image, sizes: '100vw', widths: '254, 308, 360, 462, 512, 620, 670, 720, 924, 1024, 1240, 1340, 1440', modifier: image_modifier, cover: true
                              -%}
                            </div>
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endcapture -%}

              {%- capture row_images -%}
                {{ row_images }}

                <div
                  class="timeline__row{% if blocks_counter == 1 %} is-selected{% endif %}"
                  data-timeline-row-image
                >
                  <div class="timeline__image">
                    {%- liquid
                      assign image_modifier = 'timeline__image-figure'
                      render 'image', image: block.settings.image, sizes: '50vw, calc(100vw - 67px)', widths: '254, 308, 360, 462, 512, 620, 670, 720, 924, 1024, 1240, 1340, 1440, 1920, 2480', modifier: image_modifier, cover: true
                    -%}
                  </div>
                </div>
              {%- endcapture -%}
            {%- endif -%}
          {%- endfor -%}

          <div class="timeline__row__contents">
            {{ row_contents }}
          </div>

          {%- if show_images -%}
            <div class="timeline__row__images desktop">
              {{ row_images }}
            </div>
          {%- endif -%}
        </div>
      </timeline-component>
    </div>
  </div>
  {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
  {%- render 'shape-dividers', mode: 'host' -%}
</section>

{%- style -%}
  #{{ unique }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
    --counter: {{ blocks_counter }};
  }

  {%- if dot_background != 'rgba(0,0,0,0)' and dot_background != '' -%}
    #{{ unique }} .timeline__indicator,
    #{{ unique }} .timeline__dot { --text: {{ dot_background }}; }
  {%- endif -%}

  {%- if request.visual_preview_mode -%}
    .timeline__wrapper { max-height: 100vh; }
  {%- endif -%}
{%- endstyle -%}

{%- if request.design_mode -%}
  <script>
    document.addEventListener('shopify:block:select', (event) => {
      if (event.detail?.sectionId !== '{{ section.id }}') return;

      const timelineSectionRoot = event.target.closest('[data-section-id]');
      const timelineComponent = timelineSectionRoot?.querySelector('timeline-component');

      if (!timelineComponent) return;

      const row = event.target.closest('[data-timeline-row-content]');
      if (!row || !timelineSectionRoot.contains(row)) return;

      const index = [...timelineComponent.querySelectorAll('[data-timeline-row-content]')].indexOf(row);
      if (index === -1) return;

      timelineComponent.setAttribute('data-editor-block-selected', '');
      timelineComponent.pause();
      timelineComponent.selectedIndex = index;
      timelineComponent.clearRowSelection();
      timelineComponent.applyRowSelection(index);
    });

    document.addEventListener('shopify:block:deselect', (event) => {
      if (event.detail?.sectionId !== '{{ section.id }}') return;
      const timelineSectionRoot = event.target.closest('[data-section-id]');
      const timelineComponent = timelineSectionRoot?.querySelector('timeline-component');

      timelineComponent?.removeAttribute('data-editor-block-selected');
      timelineComponent?.resume();
    });
  </script>
{%- endif -%}

