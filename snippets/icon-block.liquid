{%- doc -%}
  Renders an icon block for the product page, cart drawer, cart page, mobile menu and announcement bar.
  On the product page, consecutive icon blocks are grouped into one row.

  @param {object} block - Icon block; its settings supply every value below that is not passed
  @param {object[]} [blocks] - Blocks the calling loop iterates, used to find this block's neighbours when grouping product icons into a row. Needed with is_product; without it each icon gets its own row.
  @param {number} [index] - forloop.index0 of this block within blocks
  @param {boolean} [is_product] - Group consecutive icon blocks into a product block row
  @param {boolean} [icon_with_text] - Hide the icon when the product block has no heading or text
  @param {string} [heading] - Heading text
  @param {string} [text] - Body text or rich text
  @param {object} [image] - Custom icon image, used instead of icon_key
  @param {string} [icon_key] - Icon snippet name
  @param {number} [icon_size] - Icon size in pixels
  @param {string} [icon_color] - Icon color
  @param {number} [padding_bottom] - Bottom padding in pixels
  @param {string} [alignment] - Alignment class
  @param {boolean} [not_block] - Render without the product block classes and block attributes

  @example
  {% render 'icon-block', block: block, blocks: content_section_blocks, index: forloop.index0, is_product: true %}
{%- enddoc -%}

{%- liquid
  assign is_product = is_product | default: false
  assign icon_with_text = icon_with_text | default: false
  assign heading = heading | default: block.settings.heading
  assign text = text | default: block.settings.text
  assign prev_index = index | minus: 1
  assign next_index = index | plus: 1
  assign prev_block = blocks[prev_index]
  assign next_block = blocks[next_index]
  assign image = image | default: block.settings.image
  assign icon_key = icon_key | default: block.settings.icon_key
  assign icon_size = icon_size | default: block.settings.icon_size
  assign icon_color = icon_color | default: block.settings.icon_color
  assign padding_bottom = padding_bottom | default: block.settings.padding_bottom | default: 0
  assign alignment = alignment | default: block.settings.alignment | default: ''
  assign not_block = not_block | default: false

  case block.settings.width
    when 'full'
      assign width = ' block__icon__container--full'
    when 'half'
      assign width = ' block__icon__container--half'
    when 'third'
      assign width = ' block__icon__container--third'
    when 'quarter'
      assign width = ' block__icon__container--quarter'
  endcase

  capture block_style
    echo 'style="'
    echo '--block-padding-bottom: ' | append: padding_bottom | append: 'px;'
    echo '"'
  endcapture
-%}

{%- if is_product -%}
  {%- if index == 0 or prev_block.type != 'icon' and prev_block.type != 'icon-text' -%}
    <div class="product__block block__icon__row">
  {%- endif -%}
{%- endif -%}

<div
  class="block__icon__container{% unless not_block %} product__block block-padding{% endunless %}{{ width }}{% if alignment != '' %} {{ alignment }}{% endif %}"
  {% unless not_block %}
    {{ block.shopify_attributes }}
    {{ block_style }}
  {% endunless %}
>
  {%- liquid
    capture icon_style
      echo 'style="'
      echo '--icon-size: ' | append: icon_size | append: 'px;'
      if icon_color != blank and icon_color != 'rgba(0,0,0,0)'
        echo ' --icons: ' | append: icon_color | append: ';'
      endif
      echo '"'
    endcapture
  -%}

  {%- unless icon_with_text and is_product and heading == blank and text == blank -%}
    <div class="block__icon" data-aos="img-in" {{ icon_style }}>
      {%- liquid
        if image
          assign icon_width = icon_size
          assign icon_width_retina = icon_width | times: 2
          assign icon_sizes = icon_width | append: 'px'
          assign icon_widths = icon_width | append: ', ' | append: icon_width_retina

          render 'image', image: image, width: icon_width_retina, sizes: icon_sizes, widths: icon_widths, show_backfill: false
        else
          render 'icon', name: icon_key
        endif
      -%}
    </div>
  {%- endunless -%}

  {%- if heading != blank or text != blank -%}
    <div class="block__icon__content">
      {%- if heading != blank -%}
        {%- liquid
          assign icon_heading_tag = 'h2'
          if is_product
            assign icon_heading_tag = 'p'
          endif
        -%}
        <{{ icon_heading_tag }}
          class="block__icon__heading {{ block.settings.heading_font_size | default: '' }}"
          data-aos="fade"
        >
          {{ heading }}
        </{{ icon_heading_tag }}>
      {%- endif -%}

      {%- if text != blank -%}
        {%- assign icon_text_tag = 'p' -%}
        {%- if text contains '<p>' -%}
          {%- assign icon_text_tag = 'div' -%}
        {%- endif -%}

        <div class="block__icon__text" data-aos="fade">
          <{{ icon_text_tag }} class="{{ block.settings.text_font_size | default: 'subheading' }}">
            {{- text -}}
          </{{ icon_text_tag }}>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{%- if is_product -%}
  {%- if next_block.type != 'icon' and next_block.type != 'icon-text' -%}
    </div>
  {%- endif -%}
{%- endif -%}
