{
  "sections": {
    "main": {
      "type": "product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {
            "subheading_option": "type_maker",
            "heading_font_size": "heading-medium",
            "padding_bottom": 8
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "text_font_size": "body-medium",
            "padding_bottom": 24
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "show_read_more": false,
            "padding_bottom": 24
          }
        },
        "variants": {
          "type": "variants",
          "settings": {
            "size_chart_style": "text",
            "padding_bottom": 24
          }
        },
        "buttons": {
          "type": "buttons",
          "settings": {
            "show_quantity": true,
            "button_type": "btn--secondary",
            "button_size": "",
            "button_style": "btn--solid",
            "show_payment_button": false,
            "show_gift_card_recipient": false,
            "padding_bottom": 16
          }
        },
        "shipping": {
          "type": "icon-text",
          "settings": {
            "icon_key": "package",
            "icon_size": 20,
            "heading": "",
            "text": "<p>Ships in [0] business days · USPS Ground Advantage or UPS Ground</p>",
            "text_font_size": "body-small",
            "width": "full",
            "alignment": "align--middle-left",
            "padding_bottom": 24
          }
        },
        "specs": {
          "type": "specs",
          "settings": {
            "heading": "Specifications",
            "default_open": true,
            "rows": "Steel type | custom.steel_type\nBlade length | custom.blade_length\nOverall length | custom.overall_length\nHandle material | custom.handle_material\nCutting capacity | custom.cutting_capacity\nFormulation | custom.formulation",
            "limit": 5,
            "show_maker": true,
            "show_sku": true,
            "padding_bottom": 0
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "description",
        "variants",
        "buttons",
        "shipping",
        "specs"
      ],
      "settings": {
        "show_breadcrumb": true,
        "product_sticky_enable": true,
        "variant_image_scroll": true,
        "show_cart_bar": true,
        "enable_zoom": false,
        "enable_video_looping": true,
        "image_layout": "grid-1",
        "image_size": "normal",
        "mobile_image_style": "slider",
        "image_aspect_ratio_mobile_enable": false,
        "color_scheme": "scheme-1",
        "padding_top": 32,
        "padding_bottom": 96
      }
    },
    "in_use": {
      "type": "section-rich-text",
      "blocks": {
        "eyebrow": {
          "type": "subheading",
          "settings": {
            "subheading": "In use",
            "padding_bottom": 16
          }
        },
        "title": {
          "type": "heading",
          "settings": {
            "title": "",
            "heading_font_size": "heading-large",
            "padding_bottom": 24
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "",
            "text_font_size": "body-large",
            "padding_bottom": 0
          }
        }
      },
      "block_order": [
        "eyebrow",
        "title",
        "text"
      ],
      "settings": {
        "align_text": "text-left",
        "width": "wrapper",
        "content_width": 60,
        "hide_without_heading": true,
        "color_scheme": "scheme-2",
        "padding_top": 96,
        "padding_bottom": 96,
        "padding_top_content": 0,
        "padding_bottom_content": 0
      }
    },
    "guides": {
      "type": "section-blog",
      "settings": {
        "blog_name": "guides",
        "source": "product",
        "aspect_ratio": 0.7,
        "title": "Guides",
        "view_all_text": "All guides",
        "heading_font_size": "heading-large",
        "title_font_size": "heading-small",
        "show_tags": true,
        "show_author": false,
        "show_date": false,
        "show_button": false,
        "show_comments": false,
        "width": "wrapper",
        "grid": 3,
        "rows": 1,
        "color_scheme": "scheme-1",
        "padding_top": 96,
        "padding_bottom": 48,
        "heading_tag": "automatic",
        "title_tag": "automatic"
      }
    },
    "related": {
      "type": "section-related-products",
      "blocks": {
        "related": {
          "type": "related",
          "settings": {
            "source": "collection",
            "product_recommendations_heading": "Also in [collection]",
            "limit": 4
          }
        }
      },
      "block_order": [
        "related"
      ],
      "settings": {
        "enable_tabs": false,
        "heading_alignment": "text-left",
        "heading_font_size": "heading-large",
        "heading_tag": "automatic",
        "layout_mobile": "2",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 96
      }
    }
  },
  "order": [
    "main",
    "in_use",
    "guides",
    "related"
  ]
}
