{%- doc -%}
  Dependencies:
  - CSS: highlights.css
  - Snippets: image, animated-icon
{%- enddoc -%}

{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign unique = 'Highlights--' | append: section.id
  assign animation_order = 0
  assign animation_anchor = unique
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign color_scheme = 'color-' | append: section.settings.color_scheme

  # blocks_style fallback for Square and Rectangle values
  assign blocks_style = 'circle'
  if section.settings.style == 'button'
    assign blocks_style = 'button'
  endif

  assign size_scale = section.settings.size | default: 100 | divided_by: 100.0
  assign columns_desktop = section.settings.grid | plus: 0
  assign columns_medium = 3
  assign columns_small = 2
  assign columns_mobile = 1
  assign columns_mobile_slider = section.settings.columns_mobile_slider | default: '1.5'
  assign columns_mobile_slider_gaps = columns_mobile_slider | plus: 0 | ceil | minus: 1
  unless section.settings.layout_mobile == 'slider'
    assign columns_mobile = section.settings.layout_mobile | plus: 0
  endunless

  assign image_scale = 1
  if blocks_style == 'circle'
    assign image_scale = size_scale
  endif

  capture sizes
    echo '(min-width: 990px) calc((100vw - 100px) / ' | append: columns_desktop | append: ' * ' | append: image_scale | append: '), '
    echo '(min-width: 750px) calc((100vw - 60px) / ' | append: columns_medium | append: ' * ' | append: image_scale | append: '), '
    if section.settings.layout_mobile == 'slider'
      echo 'calc((100vw - 32px) / ' | append: columns_mobile_slider | append: ' * ' | append: image_scale | append: ')'
    else
      echo '(min-width: 480px) calc((100vw - 32px) / ' | append: columns_small | append: ' * ' | append: image_scale | append: '), '
      echo 'calc((100vw - 32px) / ' | append: columns_mobile | append: ' * ' | append: image_scale | append: ')'
    endif
  endcapture

  capture items_classes
    echo 'highlights__items'
    if section.settings.layout_mobile == 'slider'
      echo ' highlights__items--mobile-slider'
    else
      echo ' highlights__items--mobile-grid'
    endif
  endcapture
-%}

{%- style -%}
  #{{ unique }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    --columns-desktop: {{ columns_desktop }};
    --columns-medium: {{ columns_medium }};
    --columns-small: {{ columns_small }};
    --columns-mobile: {{ columns_mobile }};
    --columns-mobile-slider: {{ columns_mobile_slider }};
    --columns-mobile-slider-gaps: {{ columns_mobile_slider_gaps }};
    --highlight-scale: {{ size_scale }};
  }
{%- endstyle -%}

{%- render 'stylesheet', name: 'section-highlights.css' -%}

<div
  class="highlights section-padding {{ color_scheme }}"
  id="{{ unique }}"
  data-section-id="{{ section.id }}"
  data-section-type="highlights"
  {% if shape_divider_blocks != blank %}
    data-shape-divider-host
  {% endif %}
  {% if badge_blocks != blank %}
    data-badge-host
  {% endif %}
>
  <div class="{{ section.settings.width }} highlights__container">
    {%- if heading != blank or subheading != blank -%}
      <div class="grid__heading-holder {{ section.settings.heading_position }}">
        {%- if subheading != blank -%}
          {%- assign animation_order = animation_order | plus: 1 -%}

          <p
            class="grid__subheading subheading"
            data-aos="hero"
            data-aos-anchor="{{ animation_anchor }}"
            data-aos-order="{{ animation_order }}"
          >
            {{ subheading }}
          </p>
        {%- endif -%}

        {%- if heading != blank -%}
          {%- liquid
            assign animation_order = animation_order | plus: 1
            assign heading_tag = 'h2'

            unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
              assign heading_tag = section.settings.heading_tag
            endunless
          -%}

          <{{ heading_tag }}
            class="highlights__title grid__heading {{ section.settings.heading_font_size }}"
            data-aos="hero"
            data-aos-anchor="{{ animation_anchor }}"
            data-aos-order="{{ animation_order }}"
          >
            {{- heading -}}
          </{{ heading_tag }}>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if content_section_blocks.size != 0 -%}
      <div class="{{ items_classes }}">
        {%- for block in content_section_blocks -%}
          {%- liquid
            assign image = block.settings.image
            assign bg_color = block.settings.bg_color
            assign text_color = block.settings.color
            assign border_color = block.settings.border_color

            assign link = block.settings.url
            assign animation_order = animation_order | plus: 1
            assign has_bg_color = false
            if bg_color != 'rgba(0,0,0,0)' and bg_color != blank
              assign has_bg_color = true
            endif

            assign has_text_color = false
            if text_color != 'rgba(0,0,0,0)' and text_color != blank
              assign has_text_color = true
            endif

            assign has_border_color = false
            if border_color != 'rgba(0,0,0,0)' and border_color != blank
              assign has_border_color = true
            endif

            capture aos
              echo 'data-aos="fade"'
              echo 'data-aos-order="' | append: animation_order | append: '"'
              echo 'data-aos-anchor="' | append: animation_anchor | append: '"'
            endcapture

            capture style
              echo 'style="'

              if has_bg_color
                echo '--btn-bg: ' | append: bg_color | append: ';'
                assign btn_primary_brightness = bg_color | color_brightness
                if btn_primary_brightness <= 65
                  assign bg_color_hover = bg_color | color_lighten: 10
                else
                  assign bg_color_hover = bg_color | color_darken: 5
                endif
                echo '--btn-bg-hover: ' | append: bg_color_hover | append: ';'
              endif

              if has_text_color
                echo '--btn-text: ' | append: text_color | append: ';'
                echo '--btn-text-hover: ' | append: text_color | append: ';'
              endif

              if has_border_color
                echo '--btn-border: ' | append: border_color | append: ';'
                echo '--btn-border-hover: ' | append: border_color | append: ';'
              endif

              echo '"'
            endcapture

            capture item_attributes
              echo 'class="highlights__item highlights__item--' | append: blocks_style

              echo '"'
              echo aos | append: ' ' | append: block.shopify_attributes
            endcapture

            capture item_inner_classes
              echo 'highlights__item-inner'
              if blocks_style == 'button'
                echo ' btn btn--primary btn--solid btn--large'
                unless link != blank
                  echo ' is-disabled'
                endunless
              elsif link != blank
                echo ' highlights__item-link'
              endif
            endcapture
          -%}

          <div {{ item_attributes }}>
            {%- if link != blank -%}
              <a href="{{ link }}" class="{{ item_inner_classes }}" {{ style }}>
            {%- else -%}
              <div class="{{ item_inner_classes }}" {{ style }}>
            {%- endif -%}

            {%- if image or blocks_style != 'button' -%}
              <div class="highlights__item__background{% if has_border_color %} highlights__item__background--border{% endif %}">
                {%- if image -%}
                  {%- render 'image', image: image, sizes: sizes, cover: true -%}
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="highlights__item__content {{ section.settings.text_font_size }}">
              <span>{{ block.settings.heading }}</span>
            </div>

            {%- if link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
  {%- render 'shape-dividers', mode: 'host' -%}
</div>

