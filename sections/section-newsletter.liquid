<!-- /sections/section-newsletter.liquid -->
{%- liquid
  # max_blocks also has to fit Badges and Shape dividers, so it cannot cap the columns.
  # The layout is built for two columns: render only the first two content blocks.
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges' | slice: 0, 2
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign block_count = content_section_blocks.size
  assign animation_anchor = 'Newsletter--' | append: section.id
  assign color_scheme = 'color-' | append: section.settings.color_scheme
-%}

{%- if content_section_blocks.size != 0 or shape_divider_blocks != blank -%}
  {%- style -%}
    #Newsletter--{{ section.id }} {
      --PT: {{ section.settings.padding_top }}px;
      --PB: {{ section.settings.padding_bottom }}px;
      --item-count: {{ block_count }};
    }
  {%- endstyle -%}

  <div
    id="Newsletter--{{ section.id }}"
    class="index-newsletter {{ color_scheme }}"
    data-section-id="{{ section.id }}"
    data-section-type="newsletter"
  {% if shape_divider_blocks != blank %}data-shape-divider-host{% endif %}
  {% if badge_blocks != blank %}data-badge-host{% endif %}
  >
    <div class="section-padding {{ section.settings.width }}">
      {%- if block_count > 0 -%}
        <div class="brick__section {{ section.settings.height }}">
          {%- for block in content_section_blocks -%}
            {%- case block.type -%}
              {%- when 'image' -%}
                {%- render 'brick-image', block: block, animation_anchor: animation_anchor -%}

              {%- when 'text' -%}
                {%- render 'brick-text', block: block, animation_anchor: animation_anchor -%}

              {%- when 'newsletter' -%}
                {%- render 'brick-newsletter', block: block, animation_anchor: animation_anchor -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
  {%- render 'shape-dividers', mode: 'host' -%}
  </div>
{%- endif -%}

{%- comment -%} App blocks {%- endcomment -%}
{%- for block in content_section_blocks -%}
  {%- if block.type == '@app' -%}
    {%- render block -%}
  {%- endif -%}
{%- endfor -%}

