<script>
  (function () {
    var root = document.querySelector('[data-sg]');
    if (!root) return;

    function toHex(value) {
      var c = String(value).match(/^color\(srgb ([\d.]+) ([\d.]+) ([\d.]+)(?: \/ ([\d.]+))?\)$/);
      if (c) value = 'rgba(' + [c[1], c[2], c[3]].map(function (n) { return Math.round(parseFloat(n) * 255); }).join(', ') + ', ' + (c[4] === undefined ? 1 : c[4]) + ')';
      var m = String(value).match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)$/);
      if (!m) return String(value).trim();
      if (m[4] !== undefined && parseFloat(m[4]) < 1) return 'rgba(' + m[1] + ', ' + m[2] + ', ' + m[3] + ', ' + parseFloat(m[4]) + ')';
      return '#' + [m[1], m[2], m[3]].map(function (n) { return ('0' + parseInt(n, 10).toString(16)).slice(-2); }).join('').toUpperCase();
    }
    function round(n) { return Math.round(n * 100) / 100; }
    function family(cs) { return cs.fontFamily.split(',')[0].replace(/["']/g, '').trim(); }
    function spec(el, noLineHeight) {
      var cs = getComputedStyle(el);
      var size = parseFloat(cs.fontSize);
      var out = family(cs) + ' ' + cs.fontWeight + ' · ' + round(size);
      if (!noLineHeight) out += ' / ' + round(parseFloat(cs.lineHeight) / size);
      var ls = cs.letterSpacing === 'normal' ? 0 : Math.round((parseFloat(cs.letterSpacing) / size) * 100);
      if (ls) out += ' · ' + (ls > 0 ? '+' : '') + ls + '%';
      if (cs.textTransform === 'uppercase') out += ' · caps';
      return out;
    }
    function mark(target, ok, actual, expected) {
      if (!target) return;
      target.textContent = (ok ? 'Matches · ' : 'Differs · ') + actual + (ok ? '' : ' (expected ' + expected + ')');
      target.className = target.className.replace(/\bsg-(ok|bad)\b/g, '').trim() + (ok ? ' sg-ok' : ' sg-bad');
    }

    function run() {
      var mobile = window.matchMedia('(max-width: 767px)').matches;
      var total = 0, passed = 0;

      root.querySelectorAll('[data-sg-spec]').forEach(function (el) {
        var expected = (mobile && el.dataset.expectMobile) || el.dataset.expect;
        var actual = spec(el, el.hasAttribute('data-sg-nolh'));
        var ok = actual === expected;
        total++; if (ok) passed++;
        mark(el.parentElement.querySelector('[data-result]'), ok, actual, expected);
      });

      root.querySelectorAll('[data-sg-color]').forEach(function (el) {
        var expected = el.dataset.sgColor.toUpperCase();
        var actual = toHex(getComputedStyle(el).backgroundColor);
        var ok = actual === expected;
        total++; if (ok) passed++;
        mark(el.parentElement.querySelector('[data-result]'), ok, actual, expected);
      });

      root.querySelectorAll('[data-check]').forEach(function (row) {
        var sel = row.dataset.check;
        var el = sel === ':root' ? document.documentElement : document.querySelector(sel);
        if (!el) return;
        var cs = getComputedStyle(el);
        var actual;
        if (row.dataset.var) actual = cs.getPropertyValue(row.dataset.var).trim();
        else if (row.dataset.prop === 'font') actual = family(cs) + ' ' + cs.fontWeight;
        else actual = toHex(cs[row.dataset.prop]);
        var expected = row.dataset.expect;
        var ok = actual.replace(/\s+/g, ' ').toLowerCase() === expected.toLowerCase();
        total++; if (ok) passed++;
        mark(row.querySelector('[data-result]'), ok, actual, expected);
      });

      var summary = root.querySelector('[data-sg-summary]');
      if (summary) summary.textContent = passed + ' of ' + total + ' live checks match the tokens at this screen width (' + (mobile ? 'mobile' : 'desktop') + ' sizes).';
    }

    root.querySelectorAll('[data-sg-qty]').forEach(function (qty) {
      var input = qty.querySelector('input');
      var buttons = qty.querySelectorAll('[data-sg-qty-step]');
      function sync() {
        var v = parseInt(input.value, 10) || 1;
        buttons[0].disabled = v <= parseInt(input.min, 10);
        buttons[1].disabled = v >= parseInt(input.max, 10);
      }
      buttons.forEach(function (b) {
        b.addEventListener('click', function () {
          var v = (parseInt(input.value, 10) || 1) + parseInt(b.dataset.sgQtyStep, 10);
          input.value = Math.min(parseInt(input.max, 10), Math.max(parseInt(input.min, 10), v));
          sync();
        });
      });
      input.addEventListener('change', sync);
      sync();
    });

    var timer;
    window.addEventListener('resize', function () { clearTimeout(timer); timer = setTimeout(run, 200); });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(run); else run();
  })();
</script>

{% stylesheet %}
  .sg { padding-bottom: var(--space-6); }
  .sg .ds-container { max-width: var(--container-max); }
  .sg p { margin: 0; }
  .sg h1, .sg h2, .sg h3 { margin: 0; }
  .sg-muted { color: var(--ink-muted); }
  .sg-mono { font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  .sg-tabular { font-variant-numeric: lining-nums tabular-nums; }
  .sg-reading { max-width: var(--container-reading); }
  .sg-gap-top { margin-top: var(--space-2) !important; }
  .sg-label { margin: var(--space-4) 0 var(--space-2) !important; }

  .sg-hero { padding-top: var(--space-7); padding-bottom: var(--space-6); }
  .sg-hero__title { margin: var(--space-2) 0 var(--space-3) !important; }
  .sg-lede { max-width: var(--container-reading); color: var(--ink-muted); }
  .sg-toc { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid var(--hairline); }
  .sg-toc a { font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); }
  .sg-toc a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .sg-summary { margin-top: var(--space-3) !important; }

  .sg-sec { padding: var(--space-6) 0; border-top: 1px solid var(--hairline); }
  .sg-sec__head { max-width: var(--container-reading); margin-bottom: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2); }
  .sg-subhead { margin-top: var(--space-5) !important; margin-bottom: var(--space-1) !important; }

  .sg-split { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--space-5); margin-top: var(--space-4); }
  .sg-split--even { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .sg-rules { display: flex; flex-direction: column; gap: var(--space-3); }

  .sg-table { width: 100%; border-collapse: collapse; font-size: 14px; line-height: 1.5; }
  .sg-table th { text-align: left; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--label); padding: 0 var(--space-2) var(--space-1) 0; border-bottom: 1px solid var(--hairline); }
  .sg .sg-table th, .sg .sg-table td { border: 0; border-bottom: 1px solid var(--hairline); background: none; }
  .sg-table td { padding: 12px var(--space-2) 12px 0; vertical-align: top; }
  .sg-table td:first-child { font-weight: 500; }
  .sg-table--compact td { padding-top: 10px; padding-bottom: 10px; }
  .sg-ok { color: var(--ink-muted); }
  .sg-ok::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 8px; background: var(--ink); vertical-align: 1px; }
  .sg-bad { color: var(--signal-press); font-weight: 600; }
  .sg-bad::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 8px; background: var(--signal); vertical-align: 1px; }

  .sg-grid { display: grid; gap: var(--space-3); }
  .sg-grid--swatches { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: var(--space-4); }
  .sg-grid--schemes { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--space-3); gap: 0; border: 1px solid var(--hairline); }
  .sg-grid--notes { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .sg-grid--gradients { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--space-4); }
  .sg-grid--logos { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: var(--space-3); }

  .sg-ratio { display: flex; height: 56px; margin: var(--space-2) 0 var(--space-1); }
  .sg-swatch { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .sg-swatch[data-theme="green"] { padding: 12px; }
  .sg-swatch__chip { aspect-ratio: 3 / 2; border: 1px solid var(--hairline); }
  .sg-swatch figcaption { display: flex; flex-direction: column; gap: 2px; }
  .sg-swatch__name { font-weight: 600; font-size: 14px; }

  .sg-scheme { padding: var(--space-3); display: flex; flex-direction: column; gap: var(--space-1); min-height: 200px; }
  .sg-scheme .subheading { color: inherit; opacity: 0.75; }
  .sg-scheme__name { margin-bottom: var(--space-2) !important; }
  .sg-scheme__btns { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: auto; }

  .sg-type { border-top: 1px solid var(--hairline); margin-bottom: var(--space-4); }
  .sg-type__row { display: grid; grid-template-columns: minmax(160px, 240px) minmax(0, 1fr); gap: var(--space-4); padding: var(--space-3) 0; border-bottom: 1px solid var(--hairline); align-items: start; }
  .sg-type__meta { display: flex; flex-direction: column; gap: var(--space-1); }
  .sg-type__sample { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-1); min-width: 0; }
  .sg-spec { margin-top: var(--space-1) !important; }

  .sg-spaces { list-style: none; margin: 0 0 var(--space-2); padding: 0; border-top: 1px solid var(--hairline); }
  .sg-space { display: grid; grid-template-columns: 120px 150px minmax(0, 1fr); gap: var(--space-2); align-items: center; padding: 10px 0; border-bottom: 1px solid var(--hairline); }
  .sg-space__bar { display: block; height: 12px; background: var(--green); max-width: 150px; }
  .sg-edges { display: flex; gap: var(--space-3); margin-bottom: var(--space-3); }
  .sg-edge { display: flex; flex-direction: column; gap: var(--space-1); flex: 1; }
  .sg-edge__box { height: 72px; background: var(--surface-raised); border: 1px solid var(--ink); border-radius: var(--radius-0); }
  .sg-edge__box--input { border-radius: var(--radius-1); background: var(--surface); }
  .sg-productgrid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); }
  .sg-productgrid .ds-ph { aspect-ratio: 4 / 5; }

  .sg-demo { padding: var(--space-4); border: 1px solid var(--hairline); display: flex; flex-direction: column; gap: var(--space-2); }
  .sg-demo--green { border-color: transparent; margin-top: var(--space-3); }
  .sg-btns { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .sg-btnnotes { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); list-style: none; margin: 0; padding: 0; }
  .sg-forms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4) var(--space-5); margin-bottom: var(--space-3); }
  .sg-forms .ds-field__input, .sg-forms .ds-field__select { margin: 0; max-width: none; }
  .sg-stack { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-1); }
  .sg-stack .body-x-small { margin-bottom: var(--space-2); }
  .sg-checks { display: flex; flex-direction: column; gap: var(--space-2); justify-content: center; }
  .sg .ds-check input { padding: 0; }
  .sg .ds-qty input { margin: 0; padding: 0; border-radius: 0; border-top: 0; border-bottom: 0; }

  .sg-frame { border: 1px solid var(--hairline); margin-bottom: var(--space-3); }
  .sg-frame .ds-nav__links a:hover, .sg-frame .ds-iconbtn:hover { color: var(--ink); }
  .sg-product { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-5); margin: var(--space-4) 0 var(--space-3); align-items: start; }
  .sg-product__card { max-width: 360px; }
  .sg-product__details .sg-label:first-child { margin-top: 0 !important; }
  .sg-price { margin-top: var(--space-3); }

  .sg-bands { margin: var(--space-4) 0 0; }
  .sg-gradient { padding: var(--space-4) var(--space-3); min-height: 200px; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px; }

  .sg-icons { list-style: none; margin: 0; padding: var(--space-3); display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: var(--space-3) var(--space-2); border: 1px solid var(--hairline); }
  .sg-icons--green { border-color: transparent; margin-top: var(--space-2); }
  .sg-icon { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; }
  .sg-list { margin: 0; padding: 0 0 0 1.1em; display: flex; flex-direction: column; gap: var(--space-1); }

  .sg-imagery { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: var(--space-3); align-items: end; }
  .sg-imagery figure { margin: 0; display: flex; flex-direction: column; gap: var(--space-1); }

  .sg-logo { min-height: 180px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: var(--space-2); border: 1px solid var(--hairline); }
  .sg-mark { display: grid; place-items: center; width: 72px; height: 72px; background: var(--green); color: var(--bone-page); font-family: var(--font-display); font-size: 44px; font-weight: 500; line-height: 1; }

  @media only screen and (max-width: 989px) {
    .sg-grid--swatches { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sg-grid--notes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sg-productgrid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sg-productgrid .ds-ph:nth-child(4) { display: none; }
    .sg-icons { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .sg-split { grid-template-columns: 1fr; }
  }
  @media only screen and (max-width: 767px) {
    .sg-hero { padding-top: var(--space-6); padding-bottom: var(--space-5); }
    .sg-sec { padding: var(--space-5) 0; }
    .sg-split--even, .sg-forms, .sg-product, .sg-imagery { grid-template-columns: 1fr; }
    .sg-grid--swatches, .sg-grid--schemes, .sg-grid--gradients, .sg-grid--logos, .sg-grid--notes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sg-productgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sg-productgrid .ds-ph:nth-child(3) { display: none; }
    .sg-type__row { grid-template-columns: 1fr; gap: var(--space-2); }
    .sg-space { grid-template-columns: 110px minmax(0, 1fr); }
    .sg-space .sg-muted { grid-column: 1 / -1; }
    .sg-table th:nth-child(2), .sg-table td:nth-child(2) { display: none; }
    .sg-demo { padding: var(--space-3); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Styleguide",
  "tag": "section",
  "class": "section-potager-styleguide",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Living reference for the Potager design system. Values come from Theme settings and assets/potager.css."
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark text",
      "default": "Potager",
      "info": "Temporary brand name. Replace when the final name is confirmed."
    },
    {
      "type": "text",
      "id": "legal_name",
      "label": "Legal name in footer example",
      "default": "Potager Labs LLC"
    }
  ]
}
{% endschema %}
