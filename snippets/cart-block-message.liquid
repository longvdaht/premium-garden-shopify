{% comment %}
  Renders discount on Cart page and Cart drawer

  Accepts:
  - block: {Object} Block object (required)

  Usage:
  {% render 'cart-block-message', block: block %}
{% endcomment %}

{%- liquid
  assign custom_message_text = block.settings.cart_message_text
  assign custom_message_link_text = block.settings.link_text
  assign modifier = modifier | default: ''
-%}

{%- if custom_message_text != blank or custom_message_link_text != blank -%}
  <div
    class="cart__message{% if custom_message_link_text != blank %} cart__message--link{% endif %} color-{{ block.settings.color_scheme }} {{ block.settings.align_text }} {{ block.settings.text_font_size }}{% if modifier != '' %} {{ modifier }}{% endif %}"
  >
    {%- if custom_message_text != blank -%}
      <p class="subheading">{{ block.settings.cart_message_text }}</p>
    {%- endif -%}

    {%- if custom_message_link_text != blank -%}
      <a
        href="{{ block.settings.link_url | default: '#!' }}"
        class="btn btn--text btn--small"
      >
        <span>{{ custom_message_link_text }}</span>
      </a>
    {%- endif -%}
  </div>
{%- endif -%}
