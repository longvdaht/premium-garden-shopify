{%- comment -%}
  Potager styleguide: a living reference for the design system, rendered with the
  theme's own settings and classes (headings, .subheading, .btn, color schemes) and
  the ds-* components in assets/potager.css. Each type style, colour and key theme
  setting reads its computed value in the browser and compares it with the token.
  Source: Potager Style Guide v1 and developer files v1 (9 October 2026).
  Template: templates/page.styleguide.json. Preview any page with ?view=styleguide.
{%- endcomment -%}

{%- liquid
  assign wordmark = section.settings.wordmark | default: 'Potager'
  assign legal_name = section.settings.legal_name
  assign icon_names = 'search,user,shopping-bag,menu,x,plus,minus,chevron-down,chevron-right,chevron-left,chevron-up,arrow-right,check,mail,truck,instagram' | split: ','
-%}

<div class="sg" data-sg>
  <header class="sg-hero ds-container">
    <p class="subheading">Brand style guide · Version 1</p>
    <h1 class="heading-x-large sg-hero__title">Design system</h1>
    <p class="body-large sg-lede">
      The visual reference for the Headlands build. Everything on this page is drawn with the theme's own settings and the
      design-system layer, and each value checks itself against the tokens.
    </p>
    <nav class="sg-toc" aria-label="Styleguide sections">
      <a href="#sg-start">Start here</a>
      <a href="#sg-color">Colour</a>
      <a href="#sg-type">Typography</a>
      <a href="#sg-layout">Layout and spacing</a>
      <a href="#sg-forms">Buttons and forms</a>
      <a href="#sg-product">Header and product</a>
      <a href="#sg-sections">Footer and sections</a>
      <a href="#sg-icons">Icons</a>
      <a href="#sg-imagery">Imagery</a>
      <a href="#sg-logo">Logo</a>
      <a href="#sg-checklist">Checklist</a>
    </nav>
    <p class="body-x-small sg-muted sg-summary" data-sg-summary aria-live="polite"></p>
  </header>

  {%- comment -%} Start here: theme settings map with live checks {%- endcomment -%}
  <section class="sg-sec" id="sg-start">
    <div class="ds-container">
      <div class="sg-sec__head">
        <p class="subheading">Start here</p>
        <h2 class="heading-large">Theme settings map</h2>
        <p class="body-large sg-lede">
          Set as much as possible through Headlands' Theme settings, then restyle components to match. The status column reads the
          live page.
        </p>
      </div>

      <div class="sg-split">
        <table class="sg-table">
          <thead>
            <tr><th scope="col">Setting</th><th scope="col">Value</th><th scope="col">On this page</th></tr>
          </thead>
          <tbody>
            <tr data-check="body" data-prop="backgroundColor" data-expect="#FBF9F4">
              <td>Page background</td><td>#FBF9F4 bone-page. Never #FFFFFF</td><td data-result></td>
            </tr>
            <tr data-check="body" data-prop="color" data-expect="#16271C">
              <td>Body and heading text</td><td>#16271C green. Never #000000</td><td data-result></td>
            </tr>
            <tr data-check="[data-sg-probe='btn-primary']" data-prop="backgroundColor" data-expect="#16271C">
              <td>Primary button</td><td>Fill #16271C, text #FBF9F4, hover #1E3527</td><td data-result></td>
            </tr>
            <tr data-check="[data-sg-probe='btn-signal']" data-prop="backgroundColor" data-expect="#D91E18">
              <td>Accent button (one per view)</td><td>Fill #D91E18, hover #B81A14</td><td data-result></td>
            </tr>
            <tr data-check="[data-sg-probe='dark']" data-prop="backgroundColor" data-expect="#16271C">
              <td>Dark colour scheme</td><td>Background #16271C, text #FBF9F4</td><td data-result></td>
            </tr>
            <tr data-check=":root" data-var="--hairline" data-expect="rgba(22, 39, 28, 0.14)">
              <td>Borders and dividers</td><td>1px rgba(22,39,28,.14)</td><td data-result></td>
            </tr>
            <tr data-check="[data-sg-probe='heading']" data-prop="font" data-expect="Fraunces 500">
              <td>Heading font</td><td>Fraunces, weight 500</td><td data-result></td>
            </tr>
            <tr data-check="body" data-prop="font" data-expect="Inter 400">
              <td>Body font</td><td>Inter, weights 400 / 500 / 600</td><td data-result></td>
            </tr>
            <tr data-check="[data-sg-probe='btn-primary']" data-prop="borderTopLeftRadius" data-expect="0px">
              <td>Corner radius</td><td>0 everywhere</td><td data-result></td>
            </tr>
            <tr data-check="[data-sg-probe='input']" data-prop="borderTopLeftRadius" data-expect="2px">
              <td>Form input radius</td><td>2px on form inputs only</td><td data-result></td>
            </tr>
            <tr data-check="[data-sg-probe='btn-primary']" data-prop="boxShadow" data-expect="none">
              <td>Shadows</td><td>None, on any element</td><td data-result></td>
            </tr>
            <tr data-check=":root" data-var="--WIDTH-NORMAL" data-expect="1280px">
              <td>Page width</td><td>1280px max · gutters 20px mobile, 40px desktop</td><td data-result></td>
            </tr>
            <tr data-check=":root" data-var="--LAYOUT-OUTER" data-expect="40px">
              <td>Desktop gutter</td><td>40px from 768px</td><td data-result></td>
            </tr>
          </tbody>
        </table>

        <div class="sg-rules">
          <p class="subheading">Three rules that matter most</p>
          <div class="ds-note">
            <p><strong>No pure white, no pure black, no shadows.</strong> These are what make a store look like a default theme.</p>
          </div>
          <div class="ds-note">
            <p><strong>Scarlet is punctuation.</strong> One scarlet action per screen, plus thin rules and small marks. Never large fills.</p>
          </div>
          <div class="ds-note">
            <p><strong>Space reads as quality.</strong> 96px between sections and 144px hero padding on desktop.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Colour {%- endcomment -%}
  <section class="sg-sec" id="sg-color">
    <div class="ds-container">
      <div class="sg-sec__head">
        <p class="subheading">Colour</p>
        <h2 class="heading-large">Racing green, oatmeal Bone, one scarlet</h2>
        <p class="body-large sg-lede">
          Split each view about 62% green, 33% Bone, 5% scarlet. Green carries full-bleed sections, the footer and type. Bone is the
          breathing room. Scarlet marks the one action that matters.
        </p>
      </div>

      <div class="sg-ratio" role="img" aria-label="Colour split: 62% green, 33% Bone, 5% scarlet">
        <span style="flex: 62; background: var(--green);"></span>
        <span style="flex: 33; background: var(--bone-ground);"></span>
        <span style="flex: 5; background: var(--signal);"></span>
      </div>
      <p class="body-x-small sg-muted">62% green · 33% Bone · 5% scarlet</p>

      {%- liquid
        capture swatches
          echo 'green|#16271C|Green|Text, dark sections, primary button;'
          echo 'green-raised|#1E3527|Green raised|Hover, raised areas on green;'
          echo 'green-deep|#0E1812|Green deep|Footer base, recessed panels;'
          echo 'green-lift|#2C4A36|Lift|Gradients only. Never a flat fill;'
          echo 'green-glow|#3A5E45|Glow|Gradients only. Never a flat fill;'
          echo 'signal|#D91E18|Signal scarlet|One action per view. Darken on hover, never lighten;'
          echo 'signal-press|#B81A14|Signal press|Hover and pressed. Small labels on Bone;'
          echo 'bone-page|#FBF9F4|Bone page|Page background;'
          echo 'bone-raised|#F4F0E7|Bone raised|Cards, raised areas;'
          echo 'bone-ground|#ECE6D8|Bone ground|Image placeholders, hover fills;'
          echo 'ink-muted|#3B4A40|Muted on Bone|Captions, hints'
        endcapture
        assign swatch_list = swatches | split: ';'
      -%}
      <div class="sg-grid sg-grid--swatches">
        {%- for swatch in swatch_list -%}
          {%- assign s = swatch | split: '|' -%}
          <figure class="sg-swatch">
            <div class="sg-swatch__chip" style="background: var(--{{ s[0] }});" data-sg-color="{{ s[1] }}"></div>
            <figcaption>
              <p class="sg-swatch__name">{{ s[2] }}</p>
              <p class="body-x-small sg-mono">{{ s[1] }} · --{{ s[0] }}</p>
              <p class="body-x-small sg-muted">{{ s[3] }}</p>
              <p class="body-x-small" data-result></p>
            </figcaption>
          </figure>
        {%- endfor -%}
        <figure class="sg-swatch" data-theme="green">
          <div class="sg-swatch__chip" style="background: var(--ink-muted);" data-sg-color="#C9C3B4"></div>
          <figcaption>
            <p class="sg-swatch__name">Muted on green</p>
            <p class="body-x-small sg-mono">#C9C3B4 · --ink-muted</p>
            <p class="body-x-small sg-muted">Captions on green</p>
            <p class="body-x-small" data-result></p>
          </figcaption>
        </figure>
      </div>

      <div class="sg-split sg-split--even">
        <div class="ds-note">
          <p>
            <strong>Small scarlet text fails contrast.</strong> Use scarlet as text only at 24px and above. Small labels (eyebrows,
            form labels) use #B81A14 on Bone.
          </p>
        </div>
        <div class="ds-note">
          <p>
            <strong>Gradients</strong> are allowed as matte tonal backgrounds in the green family only. No glossy shine, and never
            on buttons.
          </p>
        </div>
      </div>

      <h3 class="heading-medium sg-subhead">Colour schemes in Theme settings</h3>
      <p class="body-medium sg-muted sg-reading">
        Sections pick one of these nine schemes in the theme editor. Each one maps to the Bone or Green token theme.
      </p>
      {%- liquid
        capture schemes
          echo 'scheme-1|Bone page (default);scheme-2|Bone raised;scheme-3|Bone ground;scheme-4|Green;scheme-5|Green deep;'
          echo 'scheme-6|Green tonal;scheme-7|Green spot;scheme-8|Bone, scarlet primary;scheme-9|Green tonal deep'
        endcapture
        assign scheme_list = schemes | split: ';'
      -%}
      <div class="sg-grid sg-grid--schemes">
        {%- for scheme in scheme_list -%}
          {%- assign sc = scheme | split: '|' -%}
          <div class="sg-scheme color-{{ sc[0] }}"{% if sc[0] == 'scheme-4' %} data-sg-probe="dark"{% endif %}>
            <p class="subheading">{{ sc[0] | replace: '-', ' ' }}</p>
            <p class="heading-small font-heading sg-scheme__name">{{ sc[1] }}</p>
            <div class="sg-scheme__btns">
              <span class="btn btn--solid btn--primary">Primary</span>
              <span class="btn btn--outline btn--primary">Outline</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} Typography {%- endcomment -%}
  <section class="sg-sec" id="sg-type">
    <div class="ds-container">
      <div class="sg-sec__head">
        <p class="subheading">Typography</p>
        <h2 class="heading-large">Fraunces for display, Inter for everything else</h2>
        <p class="body-large sg-lede">
          A serif display face with a blunt sans: overbuilt, not precious. Display sizes step down below 768px; text sizes stay the
          same. The spec under each sample is read from the page.
        </p>
      </div>

      <div class="sg-type">
        <div class="sg-type__row">
          <div class="sg-type__meta">
            <p class="subheading">display-xl</p>
            <p class="body-x-small sg-muted">Hero headline. One per page. Theme: Heading extra large</p>
          </div>
          <div class="sg-type__sample">
            <p class="heading-x-large font-heading sg-type__text" data-sg-spec data-expect="Fraunces 500 · 64 / 1.05 · -1%" data-expect-mobile="Fraunces 500 · 40 / 1.1 · -1%">
              Cutting tools for the working garden.
            </p>
            <p class="body-x-small sg-spec" data-result></p>
          </div>
        </div>
        <div class="sg-type__row">
          <div class="sg-type__meta">
            <p class="subheading">display-l</p>
            <p class="body-x-small sg-muted">Section headlines. Theme: Heading large</p>
          </div>
          <div class="sg-type__sample">
            <p class="heading-large font-heading sg-type__text" data-sg-spec data-sg-probe="heading" data-expect="Fraunces 500 · 44 / 1.1 · -1%" data-expect-mobile="Fraunces 500 · 32 / 1.15 · -1%">
              Section headline
            </p>
            <p class="body-x-small sg-spec" data-result></p>
          </div>
        </div>
        <div class="sg-type__row">
          <div class="sg-type__meta">
            <p class="subheading">display-m</p>
            <p class="body-x-small sg-muted">Product name, card title, price. Theme: Heading medium</p>
          </div>
          <div class="sg-type__sample">
            <p class="heading-medium font-heading sg-type__text" data-sg-spec data-expect="Fraunces 500 · 28 / 1.2" data-expect-mobile="Fraunces 500 · 24 / 1.25">
              Kuroco bud scissors · <span class="sg-tabular">$[00]</span>
            </p>
            <p class="body-x-small sg-spec" data-result></p>
          </div>
        </div>
        <div class="sg-type__row">
          <div class="sg-type__meta">
            <p class="subheading">eyebrow</p>
            <p class="body-x-small sg-muted">Kickers, labels, accordion titles. Theme: Subheading</p>
          </div>
          <div class="sg-type__sample">
            <p class="subheading sg-type__text" data-sg-spec data-expect="Inter 600 · 11 / 1.4 · +20% · caps">
              Bud scissors · Yoshioka Hamono
            </p>
            <p class="body-x-small sg-spec" data-result></p>
          </div>
        </div>
        <div class="sg-type__row">
          <div class="sg-type__meta">
            <p class="subheading">body-l</p>
            <p class="body-x-small sg-muted">Ledes. Theme: Body large</p>
          </div>
          <div class="sg-type__sample">
            <p class="body-large sg-type__text sg-reading" data-sg-spec data-expect="Inter 400 · 18 / 1.6">
              Lede and intro copy, lines near 65 characters.
            </p>
            <p class="body-x-small sg-spec" data-result></p>
          </div>
        </div>
        <div class="sg-type__row">
          <div class="sg-type__meta">
            <p class="subheading">body</p>
            <p class="body-x-small sg-muted">Body copy. Theme: Body medium</p>
          </div>
          <div class="sg-type__sample">
            <p class="body-medium sg-type__text sg-reading" data-sg-spec data-expect="Inter 400 · 16 / 1.6">
              Paragraph copy and product descriptions.
            </p>
            <p class="body-x-small sg-spec" data-result></p>
          </div>
        </div>
        <div class="sg-type__row">
          <div class="sg-type__meta">
            <p class="subheading">meta</p>
            <p class="body-x-small sg-muted">Captions, hints. Theme: Body extra small</p>
          </div>
          <div class="sg-type__sample">
            <p class="body-x-small sg-type__text sg-muted" data-sg-spec data-expect="Inter 500 · 13 / 1.5">
              Captions, price notes, form hints
            </p>
            <p class="body-x-small sg-spec" data-result></p>
          </div>
        </div>
        <div class="sg-type__row">
          <div class="sg-type__meta">
            <p class="subheading">button</p>
            <p class="body-x-small sg-muted">Buttons, nav links, text CTAs. Theme: Buttons</p>
          </div>
          <div class="sg-type__sample">
            <span class="btn btn--solid btn--primary" data-sg-spec data-sg-nolh data-expect="Inter 600 · 12 · +14% · caps">Add to cart</span>
            <p class="body-x-small sg-spec" data-result></p>
          </div>
        </div>
      </div>

      <div class="ds-note sg-reading">
        <p>Headings use weight 500, not bold. Prices use lining, tabular figures. Never use Fraunces below 20px.</p>
      </div>
    </div>
  </section>

  {%- comment -%} Layout and spacing {%- endcomment -%}
  <section class="sg-sec" id="sg-layout">
    <div class="ds-container">
      <div class="sg-sec__head">
        <p class="subheading">Layout and spacing</p>
        <h2 class="heading-large">Generous space, square corners, hairlines</h2>
        <p class="body-large sg-lede">
          Luxury reads as space. Use these values in place of theme defaults; where Headlands only offers presets, choose the nearest
          larger option.
        </p>
      </div>

      <div class="sg-split">
        <div>
          <p class="subheading sg-label">Spacing scale (8px base)</p>
          {%- liquid
            capture spaces
              echo '1|8px|Icon-to-label gaps;2|16px|Form gaps, card padding;3|24px|Grid gaps between cards;'
              echo '4|40px|Between blocks inside a section;5|64px|Padding inside a full-bleed section;'
              echo '6|96px|Between sections;7|144px|Hero padding'
            endcapture
            assign space_list = spaces | split: ';'
          -%}
          <ul class="sg-spaces" role="list">
            {%- for space in space_list -%}
              {%- assign sp = space | split: '|' -%}
              <li class="sg-space">
                <span class="body-x-small sg-mono sg-space__name">space-{{ sp[0] }} · {{ sp[1] }}</span>
                <span class="sg-space__bar" style="width: var(--space-{{ sp[0] }});"></span>
                <span class="body-x-small sg-muted">{{ sp[2] }}</span>
              </li>
            {%- endfor -%}
          </ul>
          <p class="body-x-small sg-muted">On mobile, use one step down: 64px between sections, 96px hero padding.</p>
        </div>
        <div>
          <p class="subheading sg-label">Grid and breakpoints</p>
          <table class="sg-table sg-table--compact">
            <tbody>
              <tr><td>Max content width</td><td>1280px</td></tr>
              <tr><td>Reading column (articles, long copy)</td><td>720px</td></tr>
              <tr><td>Side gutter</td><td>20px below 768px · 40px from 768px</td></tr>
              <tr><td>Tablet layout starts</td><td>768px</td></tr>
              <tr><td>Desktop layout starts</td><td>1200px</td></tr>
              <tr><td>Product grid</td><td>4 across desktop · 3 tablet · 2 mobile</td></tr>
            </tbody>
          </table>
          <p class="subheading sg-label">Edges</p>
          <div class="sg-edges">
            <div class="sg-edge"><div class="sg-edge__box"></div><p class="body-x-small sg-muted">radius-0 · cards, buttons, images, drawers, modals</p></div>
            <div class="sg-edge"><div class="sg-edge__box sg-edge__box--input"></div><p class="body-x-small sg-muted">radius-1 · 2px, form inputs only</p></div>
          </div>
          <hr class="ds-rule">
          <p class="body-x-small sg-muted sg-gap-top">1px hairline dividers instead of cards and shadows. No drop shadows, glass effects or rounded pills anywhere.</p>
        </div>
      </div>

      <p class="subheading sg-label">Product grid · 4 across, 24px gaps, 4:5 images</p>
      <div class="sg-productgrid">
        {%- for i in (1..4) -%}
          <div class="ds-ph">4:5</div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} Buttons and forms {%- endcomment -%}
  <section class="sg-sec" id="sg-forms">
    <div class="ds-container">
      <div class="sg-sec__head">
        <p class="subheading">Buttons and form elements</p>
        <h2 class="heading-large">Actions and forms</h2>
        <p class="body-large sg-lede">
          Solid for most actions. Scarlet for the single most important action on a screen. Outline for secondary. Focus is a 2px green
          outline, offset 3px. No icons, shadows or gradients inside buttons.
        </p>
      </div>

      <p class="subheading sg-label">Buttons · 48px tall, square, uppercase (theme .btn)</p>
      <div class="sg-demo">
        <div class="sg-btns">
          <button type="button" class="btn btn--solid btn--primary" data-sg-probe="btn-primary">Add to cart</button>
          <button type="button" class="btn btn--solid btn--secondary" data-sg-probe="btn-signal">Checkout</button>
          <button type="button" class="btn btn--outline btn--primary">View specs</button>
          <button type="button" class="btn btn--solid btn--primary" disabled>Sold out</button>
        </div>
        <ul class="sg-btnnotes body-x-small sg-muted" role="list">
          <li>Solid · theme Primary button</li>
          <li>Scarlet · theme Secondary button, one per view</li>
          <li>Outline · secondary actions</li>
          <li>Disabled · Bone ground, muted text</li>
        </ul>
      </div>
      <div class="sg-demo sg-demo--green" data-theme="green">
        <div class="sg-btns">
          <button type="button" class="btn btn--solid btn--primary">Add to cart</button>
          <button type="button" class="btn btn--solid btn--secondary">Checkout</button>
          <button type="button" class="btn btn--outline btn--primary">View specs</button>
          <button type="button" class="btn btn--solid btn--primary" disabled>Sold out</button>
        </div>
        <p class="body-x-small sg-muted">The same buttons on a green section.</p>
      </div>

      <div class="sg-split sg-split--even">
        <div class="sg-stack">
          <p class="subheading sg-label">Text call to action</p>
          <p><a class="ds-cta" href="#sg-forms">Read the field guide</a></p>
          <p class="body-x-small sg-muted">Uppercase link with a 2px scarlet underline. For links that act.</p>
          <p><a class="btn btn--text btn--primary" href="#sg-forms"><span>Read the field guide</span></a></p>
          <p class="body-x-small sg-muted">The theme's text button, restyled to match.</p>
        </div>
        <div>
          <p class="subheading sg-label">Quantity</p>
          <div class="ds-qty" data-sg-qty>
            <button type="button" aria-label="Decrease quantity" data-sg-qty-step="-1" disabled>{%- render 'potager-icon', name: 'minus' -%}</button>
            <input type="number" value="1" min="1" max="6" aria-label="Quantity" inputmode="numeric">
            <button type="button" aria-label="Increase quantity" data-sg-qty-step="1">{%- render 'potager-icon', name: 'plus' -%}</button>
          </div>
          <p class="body-x-small sg-muted sg-gap-top">48px tall to sit level with the add-to-cart button. 2px radius.</p>
        </div>
      </div>

      <p class="subheading sg-label">Form fields</p>
      <div class="sg-forms">
        <div class="ds-field">
          <label class="ds-field__label" for="sg-email">Email</label>
          <input class="ds-field__input" id="sg-email" type="email" autocomplete="email" placeholder="you@example.com" aria-describedby="sg-email-hint" data-sg-probe="input">
          <p class="ds-field__hint" id="sg-email-hint">We send one seasonal note a week.</p>
        </div>
        <div class="ds-field ds-field--error">
          <label class="ds-field__label" for="sg-postcode">Postcode</label>
          <input class="ds-field__input" id="sg-postcode" type="text" value="9412" aria-invalid="true" aria-describedby="sg-postcode-hint">
          <p class="ds-field__hint" id="sg-postcode-hint">Error: enter all five digits.</p>
        </div>
        <div class="ds-field">
          <label class="ds-field__label" for="sg-handle">Handle length</label>
          <div class="ds-select">
            <select class="ds-field__select" id="sg-handle">
              <option>330mm</option>
              <option>380mm</option>
            </select>
            {%- render 'potager-icon', name: 'chevron-down' -%}
          </div>
        </div>
        <div class="sg-checks">
          <label class="ds-check"><input type="checkbox" name="sg-note" checked> Email me the seasonal note</label>
          <label class="ds-check"><input type="checkbox" name="sg-gift"> This is a gift</label>
        </div>
      </div>
      <p class="body-x-small sg-muted sg-reading">
