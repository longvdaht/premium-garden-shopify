<!doctype html>
<html class="js supports-no-cookies no-touch" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'head' -%}

    {{ content_for_header }}
  </head>
  <body class="{% if settings.animations_enable %}aos-initialized{% endif %}">
    <a class="skip-link visually-hidden" href="#MainContent">
      {{- 'general.accessibility.skip_to_content' | t -}}
    </a>

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}

      {% render 'zoom-pswp' %}
    </main>
  </body>
</html>
