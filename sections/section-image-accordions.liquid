<!-- /sections/section-image-accordions.liquid -->

{%- liquid
  assign accordions = ''
  assign subheading = section.settings.subheading
  assign title = section.settings.title
  assign text = section.settings.text
  assign heading_tag = 'h2'

  unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
    assign heading_tag = section.settings.heading_tag
  endunless
-%}

{%- liquid
  capture rendered_blocks
    content_for 'blocks'
  endcapture

  capture badge_blocks
    render 'badge-blocks', source: rendered_blocks, part: 'badges'
  endcapture

  capture content_blocks
    render 'badge-blocks', source: rendered_blocks, part: 'content'
  endcapture
-%}

{%- capture children -%}
  {%- if subheading != blank -%}
    <p
      class="hero__subheading"
      data-aos="hero"
      data-aos-order="auto"
      data-aos-anchor="{{ section.id }}"
    >
      {{ subheading }}
    </p>
  {%- endif -%}

  {% if title != blank %}
    <{{ heading_tag }}
      class="hero__title {{ section.settings.heading_font_size }}"
      data-aos="hero"
      data-aos-anchor="{{ section.id }}"
      data-aos-order="auto"
    >
      {{ title }}
    </{{ heading_tag }}>
  {%- endif -%}

  {%- if text != blank -%}
    <div
      class="hero__rte {{ section.settings.text_font_size }}"
      data-aos="hero"
      data-aos-anchor="{{ section.id }}"
      data-aos-order="auto"
    >
      {{ text }}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    {{ content_blocks }}
  {%- endif -%}
{%- endcapture -%}

{%- render 'brick-section', children: children, badges: badge_blocks -%}

{% schema %}
{
  "name": "Image accordions",
  "class": "section-overlay-header",
  "blocks": [
    {"type": "image-accordion"},
