    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "screen-height-three-quarters",
      "options": [
        {
          "value": "image-height",
          "label": "Image height"
        },
        {
          "value": "screen-height-full",
