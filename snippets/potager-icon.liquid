{%- doc -%}
  Renders a Potager design-system icon: Lucide (ISC license), restyled to a 1.5px stroke,
  square caps and mitered joins, drawn at 20px on a 24px grid. Colour comes from currentColor.
  Source: Potager developer files v1, icons/ (chevron-left and chevron-up added from the same set).

  @param {string} name - search, user, shopping-bag, menu, x, plus, minus, chevron-down,
    chevron-right, chevron-left, chevron-up, arrow-right, check, mail, truck, instagram
  @param {string} [class] - Extra classes for the svg element

  @example
  {% render 'potager-icon', name: 'search' %}
{%- enddoc -%}

{%- liquid
  assign icon_name = name | default: '' | strip
  case icon_name
    when 'search'
      assign paths = '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>'
    when 'user'
      assign paths = '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>'
    when 'shopping-bag'
      assign paths = '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>'
    when 'menu'
      assign paths = '<line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>'
    when 'x'
      assign paths = '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>'
    when 'plus'
      assign paths = '<path d="M5 12h14"/><path d="M12 5v14"/>'
    when 'minus'
      assign paths = '<path d="M5 12h14"/>'
    when 'chevron-down'
      assign paths = '<path d="m6 9 6 6 6-6"/>'
    when 'chevron-up'
      assign paths = '<path d="m18 15-6-6-6 6"/>'
    when 'chevron-right'
      assign paths = '<path d="m9 18 6-6-6-6"/>'
    when 'chevron-left'
      assign paths = '<path d="m15 18-6-6 6-6"/>'
    when 'arrow-right'
      assign paths = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>'
    when 'check'
      assign paths = '<path d="M20 6 9 17l-5-5"/>'
    when 'mail'
      assign paths = '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>'
    when 'truck'
      assign paths = '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>'
    when 'instagram'
      assign paths = '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>'
    else
      assign paths = ''
  endcase
-%}

{%- if paths != blank -%}
  <svg
    class="ds-icon {{ class }}"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="square"
    stroke-linejoin="miter"
    aria-hidden="true"
    focusable="false"
  >
    {{- paths -}}
  </svg>
{%- endif -%}
