<!-- /sections/section-look.liquid -->

{%- liquid
  assign content_section_blocks = section.blocks | reject: 'type', 'shape-divider' | reject: 'type', 'badges'
  assign shape_divider_blocks = section.blocks | where: 'type', 'shape-divider'
  assign badge_blocks = section.blocks | where: 'type', 'badges'
  assign unique = 'ShopTheLook--' | append: section.id
  assign hotspots = ''
  assign look_slider = ''
  assign enable_aspect_ratio = section.settings.enable_aspect_ratio
  assign image_aspect_ratio = 1 | divided_by: section.settings.image_aspect_ratio
  assign image = section.settings.image
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign hotspot_color = section.settings.hotspot_color
  assign hotspot_bg = section.settings.hotspot_bg
  assign show_dots = section.settings.show_dots

  capture button_classes
    assign button_style = section.settings.button_style
    if button_style == 'btn--text' and section.settings.show_arrow
      assign button_style = button_style | append: ' btn--text-no-underline'
    endif
    echo 'btn ' | append: button_style | append: ' ' | append: section.settings.button_type | append: ' ' | append: section.settings.button_size
  endcapture

  unless enable_aspect_ratio
    if image
      assign image_aspect_ratio = image.aspect_ratio
    else
      assign image_aspect_ratio = 1
    endif
  endunless

  assign scroll_to_product_label = 'general.accessibility.scroll_to_product' | t
-%}

{%- render 'stylesheet', name: 'section-shop-the-look.css' -%}

{%- style -%}
  #{{ unique }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }

  {%- unless hotspot_bg.alpha == 0.0 or hotspot_bg == blank -%}
    #{{ unique }} .hotspot { --bg: {{ hotspot_bg }}; }
  {%- endunless -%}

  {%- unless hotspot_color.alpha == 0.0 or hotspot_color == blank -%}
    #{{ unique }} .hotspot__button { --icons: {{ hotspot_color }}; }
  {%- endunless -%}

  #{{ unique }} .look__image-container {
    --aspect-ratio: {{ image.aspect_ratio }};
  }
{%- endstyle -%}

<script src="{{ 'section-shop-the-look.js' | asset_url }}" defer="defer"></script>

<section
  id="{{ unique }}"
  class="section-look section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="look"
  {% if shape_divider_blocks != blank %}data-shape-divider-host{% endif %}
>
  <div class="wrapper--full">
    {%- if content_section_blocks.size != 0 -%}
      {%- for block in content_section_blocks -%}
        {%- capture style -%}
          --hotspot-top: {{ block.settings.position_y }}%;
          --hotspot-left: {{ block.settings.position_x }}%;
        {%- endcapture -%}

        {%- capture hotspots -%}
          {{ hotspots }}

          <button
            type="button"
            class="hotspot__button"
            style="{{ style }}"
            aria-label="{{ scroll_to_product_label }}"
            data-slider-thumb="{{ forloop.index0 }}"
          >
            <span class="hotspot">
              <span class="hotspot__icon"></span>
            </span>
          </button>
        {%- endcapture -%}

        {%- capture look_slider -%}
          {{ look_slider }}

          {%- assign product = all_products[block.settings.product] -%}

          <div class="look__slide look__slide--{{ block.id }}" data-slide="{{ block.id }}" {{ block.shopify_attributes }}>
            {%- render 'product-card', product: product, index: forloop.index -%}
          </div>
        {%- endcapture -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..2) -%}
        {%- capture style -%}
          --hotspot-top: {{ forloop.index | times: 30 }}%;
          --hotspot-left: {{ forloop.index | times: 30 }}%;
        {%- endcapture -%}

        {%- capture hotspots -%}
          {{ hotspots }}

          <button type="button" class="hotspot__button" style="{{ style }}" aria-label="{{ scroll_to_product_label }}" data-slider-thumb="{{ forloop.index0 }}">
            <span class="hotspot">
              <span class="hotspot__icon"></span>
            </span>
          </button>
        {%- endcapture -%}

        {%- capture look_slider -%}
          {{ look_slider }}

          <div class="look__slide look__slide--{{ section.id }}-{{ i }}" data-slide="{{ section.id }}-{{ i }}">
            {% render 'product-card', product: null, index: forloop.index %}
          </div>
        {%- endcapture -%}
      {%- endfor -%}
    {%- endif -%}

    <look-component
      class="look{% if section.settings.layout != '' %} {{ section.settings.layout }}{% endif %}"
    >
      <div class="look__image look__image--fullheight">
        <div
          class="look__image-container"
          {% if badge_blocks != blank %}
            data-badge-host
          {% endif %}
        >
          {%- render 'image',
            image: section.settings.image,
            sizes: '(min-width: 750px) 50vw, 100vw',
            aspect_ratio: image_aspect_ratio,
            modifier: 'look__image-bg',
            placeholder: 'collection-1'
          -%}

          {%- if show_dots and hotspots != blank -%}
            <div class="hotspots desktop">
              {{ hotspots }}
            </div>
          {%- endif -%}

          {%- render 'badge-blocks', mode: 'host', blocks: badge_blocks -%}
        </div>

        <div class="look__actions mobile">
          <button
            type="button"
            class="{{ button_classes }}"
            aria-label="{{ scroll_to_product_label }}"
            data-slider-thumb="0"
          >
            {%- render 'icon', name: 'shopping-bag' -%}

            <span>{{ 'general.shop_the_look.button' | t }}</span>

            {%- if section.settings.show_arrow -%}
              {%- render 'icon', name: 'caret-right' -%}
            {%- endif -%}
          </button>
        </div>
      </div>

      <div class="look__aside" data-popup-container>
        <div class="underlay mobile" data-popup-close></div>

        <div class="look__content" data-popup-content data-scroll-lock-scrollable>
          {%- if section.settings.title != blank -%}
            <p class="look__title text-center subheading">
              {{ section.settings.title }}
            </p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            {%- liquid
              assign heading_tag = 'h2'

              unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
                assign heading_tag = section.settings.heading_tag
              endunless
            -%}

            <{{ heading_tag }} class="look__title text-center {{ section.settings.heading_font_size }}">
              {{ section.settings.heading }}
            </{{ heading_tag }}>
          {%- endif -%}

          <button
            type="button"
            data-popup-close
            class="look__close mobile"
            aria-label="{{ 'general.accessibility.close' | t }}"
          >
            {%- render 'icon', name: 'x' -%}
          </button>

          <div
            class="look__slider{% if section.settings.products_per_row == '2' and content_section_blocks.size != 1 %} look__slider--grid{% endif %}"
            data-slider-mobile="{{ section.id }}"
            data-arrow-position-middle
            data-scroll-lock-scrollable
            {% if request.design_mode %}
              data-block-scroll
            {% endif %}
          >
            {{ look_slider }}
          </div>
        </div>
      </div>
    </look-component>
  </div>
  {%- render 'shape-dividers', mode: 'host' -%}
</section>

